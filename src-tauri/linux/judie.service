[Unit]
Description=Judie fullscreen kiosk
Documentation=file:///usr/share/doc
After=systemd-user-sessions.service local-fs.target
Conflicts=getty@tty1.service
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
ExecStart=/usr/lib/judie/kiosk
Restart=always
RestartSec=2
Environment=DISPLAY=:0
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
# User=/Group=/XDG_RUNTIME_DIR= come from /etc/systemd/system/judie.service.d/user.conf (postinst)

[Install]
WantedBy=multi-user.target
