#!/bin/sh
# Passwordless helper. Privileged network actions for Judie.
# Password is read from stdin only — never from argv.
#   status | scan | connect <ssid> [auto] [hidden]
#   disconnect | link | detail | preferred [ethernet|wifi]
#   dhcp [on|off] | reconnect | saved | autoconnect <ssid> <on|off>
#   forget <ssid> | probe <hostname|local|gateway|dns|internet>
set -e
export LC_ALL=C
CMD="${1:-}"

wifi_iface() {
  iw dev 2>/dev/null | awk '/Interface/{print $2; exit}'
}

eth_iface() {
  ip -o link show 2>/dev/null | awk -F': ' '
    $2 ~ /^(eth|enp|ens|eno|end)/ { print $2; exit }
  '
}

IFACE="$(wifi_iface)"
[ -n "$IFACE" ] || IFACE=wlan0
ETH="$(eth_iface)"
[ -n "$ETH" ] || ETH=eth0

safe_ssid() {
  printf '%s' "$1" | tr -d '\n\r\t\000' | cut -c1-32
}

bars_from_signal() {
  s="${1:-0}"
  if [ "$s" -ge 80 ] 2>/dev/null; then echo 4
  elif [ "$s" -ge 55 ] 2>/dev/null; then echo 3
  elif [ "$s" -ge 30 ] 2>/dev/null; then echo 2
  elif [ "$s" -ge 1 ] 2>/dev/null; then echo 1
  else echo 0
  fi
}

eth_up() {
  STATE="$(cat "/sys/class/net/$ETH/operstate" 2>/dev/null || echo down)"
  CARRIER="$(cat "/sys/class/net/$ETH/carrier" 2>/dev/null || echo 0)"
  [ "$STATE" = "up" ] && [ "$CARRIER" = "1" ]
}

eth_ip() {
  ip -4 -o addr show "$ETH" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1
}

wifi_signal() {
  if command -v nmcli >/dev/null 2>&1; then
    nmcli -t -f IN-USE,SIGNAL dev wifi 2>/dev/null | awk -F: '$1=="*"{print $2; exit}'
  fi
}

nm_field() {
  DEV="$1"
  KEY="$2"
  nmcli -t -f "$KEY" device show "$DEV" 2>/dev/null | awk -F: -v k="$KEY" '$1==k{print substr($0,index($0,":")+1); exit}'
}

status() {
  SSID=""
  IP=""
  STATE="$(cat "/sys/class/net/$IFACE/operstate" 2>/dev/null || echo down)"
  if command -v nmcli >/dev/null 2>&1; then
    SSID="$(nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')"
    IP="$(nm_field "$IFACE" IP4.ADDRESS | cut -d/ -f1)"
  fi
  if [ -z "$SSID" ]; then
    SSID="$(iw dev "$IFACE" link 2>/dev/null | awk -F': ' '/SSID/{print $2; exit}')"
  fi
  if [ -z "$IP" ]; then
    IP="$(ip -4 -o addr show "$IFACE" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
  fi
  [ -n "$SSID" ] || SSID="—"
  [ -n "$IP" ] || IP="—"
  printf '%s\t%s\t%s\n' "$SSID" "$IP" "$STATE"
}

# kind \t ssid \t bars \t state \t ip \t secured
link() {
  KIND="none"
  SSID=""
  BARS=0
  STATE="down"
  IP="—"
  SECURED="0"

  if eth_up; then
    KIND="ethernet"
    STATE="up"
    IP="$(eth_ip)"
    [ -n "$IP" ] || IP="—"
    SSID="$ETH"
  else
    STATE="$(cat "/sys/class/net/$IFACE/operstate" 2>/dev/null || echo down)"
    if command -v nmcli >/dev/null 2>&1; then
      SSID="$(nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')"
      IP="$(nm_field "$IFACE" IP4.ADDRESS | cut -d/ -f1)"
      SIG="$(wifi_signal)"
      BARS="$(bars_from_signal "${SIG:-0}")"
    fi
    if [ -z "$SSID" ]; then
      SSID="$(iw dev "$IFACE" link 2>/dev/null | awk -F': ' '/SSID/{print $2; exit}')"
    fi
    if [ -z "$IP" ]; then
      IP="$(ip -4 -o addr show "$IFACE" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
    fi
    if [ -n "$SSID" ] && [ "$SSID" != "—" ]; then
      KIND="wifi"
      STATE="up"
      SECURED="1"
    elif [ "$STATE" = "up" ]; then
      KIND="wifi"
    else
      KIND="wifi"
      STATE="down"
      BARS=0
    fi
    [ -n "$SSID" ] || SSID="—"
    [ -n "$IP" ] || IP="—"
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$KIND" "$SSID" "$BARS" "$STATE" "$IP" "$SECURED"
}

# Machine-readable current connection. Keys are stable; values may be "—".
detail() {
  KIND="none"
  DEV=""
  SSID="—"
  STATE="disconnected"
  SIG="—"
  SEC="—"
  IP4="—"
  IP6="—"
  GW="—"
  DNS="—"
  MAC="—"
  SPEED="—"
  REACH="none"

  if eth_up; then
    KIND="ethernet"
    DEV="$ETH"
    SSID="$ETH"
    STATE="up"
  else
    DEV="$IFACE"
    STATE="$(cat "/sys/class/net/$DEV/operstate" 2>/dev/null || echo down)"
    if command -v nmcli >/dev/null 2>&1; then
      SSID="$(nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')"
      SIG="$(wifi_signal)"
      [ -n "$SIG" ] && SIG="${SIG}%"
      SEC="$(nmcli -t -f IN-USE,SECURITY dev wifi 2>/dev/null | awk -F: '$1=="*"{print $2; exit}')"
    fi
    if [ -z "$SSID" ]; then
      SSID="$(iw dev "$DEV" link 2>/dev/null | awk -F': ' '/SSID/{print $2; exit}')"
    fi
    if [ -n "$SSID" ]; then
      KIND="wifi"
      STATE="up"
    elif [ "$STATE" = "up" ]; then
      KIND="wifi"
    else
      KIND="none"
      STATE="disconnected"
    fi
    [ -n "$SSID" ] || SSID="—"
    [ -n "$SEC" ] || SEC="—"
    [ -n "$SIG" ] || SIG="—"
  fi

  if [ -n "$DEV" ]; then
    MAC="$(cat "/sys/class/net/$DEV/address" 2>/dev/null || echo —)"
    IP4="$(ip -4 -o addr show "$DEV" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
    IP6="$(ip -6 -o addr show "$DEV" scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
    SPEED="$(cat "/sys/class/net/$DEV/speed" 2>/dev/null || true)"
    if command -v nmcli >/dev/null 2>&1; then
      [ -n "$IP4" ] || IP4="$(nm_field "$DEV" IP4.ADDRESS | cut -d/ -f1)"
      [ -n "$IP6" ] || IP6="$(nm_field "$DEV" IP6.ADDRESS | cut -d/ -f1)"
      GW="$(nm_field "$DEV" IP4.GATEWAY)"
      DNS="$(nmcli -t -f IP4.DNS device show "$DEV" 2>/dev/null | awk -F: '{print $2}' | paste -sd, -)"
    fi
    [ -n "$GW" ] || GW="$(ip -4 route show default dev "$DEV" 2>/dev/null | awk '{print $3; exit}')"
  fi
  [ -n "$IP4" ] || IP4="—"
  [ -n "$IP6" ] || IP6="—"
  [ -n "$GW" ] || GW="—"
  [ -n "$DNS" ] || DNS="—"
  [ -n "$MAC" ] || MAC="—"
  if [ -n "$SPEED" ] && [ "$SPEED" != "-1" ]; then
    SPEED="${SPEED} Mbit/s"
  else
    SPEED="—"
  fi

  if command -v nmcli >/dev/null 2>&1; then
    CONN="$(nmcli -t -f CONNECTIVITY general 2>/dev/null | head -1)"
    case "$CONN" in
      full) REACH="internet" ;;
      limited|portal) REACH="limited" ;;
      none)
        if [ "$IP4" != "—" ] || [ "$IP6" != "—" ]; then REACH="local"; else REACH="none"; fi
        ;;
      *)
        if [ "$IP4" != "—" ] || [ "$IP6" != "—" ]; then REACH="local"; else REACH="none"; fi
        ;;
    esac
  elif [ "$IP4" != "—" ] || [ "$IP6" != "—" ]; then
    REACH="local"
  fi

  printf 'type\t%s\n' "$KIND"
  printf 'iface\t%s\n' "${DEV:-—}"
  printf 'ssid\t%s\n' "$SSID"
  printf 'state\t%s\n' "$STATE"
  printf 'signal\t%s\n' "$SIG"
  printf 'security\t%s\n' "$SEC"
  printf 'ipv4\t%s\n' "$IP4"
  printf 'ipv6\t%s\n' "$IP6"
  printf 'gateway\t%s\n' "$GW"
  printf 'dns\t%s\n' "$DNS"
  printf 'mac\t%s\n' "$MAC"
  printf 'speed\t%s\n' "$SPEED"
  printf 'reach\t%s\n' "$REACH"
}

preferred_get() {
  FILE="/var/lib/judie/preferred-net"
  if [ -f "$FILE" ]; then
    cat "$FILE"
  else
    echo wifi
  fi
}

preferred_set() {
  WANT="${2:-wifi}"
  case "$WANT" in
    ethernet|wifi) ;;
    *) echo "preferred ethernet|wifi" >&2; exit 1 ;;
  esac
  mkdir -p /var/lib/judie
  printf '%s\n' "$WANT" > /var/lib/judie/preferred-net
  if command -v nmcli >/dev/null 2>&1; then
    if [ "$WANT" = "ethernet" ]; then
      nmcli device connect "$ETH" >/dev/null 2>&1 || true
      nmcli device disconnect "$IFACE" >/dev/null 2>&1 || true
    else
      nmcli device connect "$IFACE" >/dev/null 2>&1 || true
    fi
  fi
}

dhcp_get() {
  DEV="$IFACE"
  if eth_up; then DEV="$ETH"; fi
  if command -v nmcli >/dev/null 2>&1; then
    METHOD="$(nm_field "$DEV" IP4.METHOD)"
    [ "$METHOD" = "auto" ] && echo on || echo off
  else
    echo on
  fi
}

dhcp_set() {
  WANT="${2:-on}"
  DEV="$IFACE"
  CON=""
  if eth_up; then DEV="$ETH"; fi
  if command -v nmcli >/dev/null 2>&1; then
    CON="$(nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null | awk -F: -v d="$DEV" '$2==d{print $1; exit}')"
    [ -n "$CON" ] || CON="$(nmcli -t -f NAME,DEVICE connection show 2>/dev/null | awk -F: -v d="$DEV" '$2==d{print $1; exit}')"
    [ -n "$CON" ] || exit 0
    if [ "$WANT" = "off" ]; then
      nmcli connection modify "$CON" ipv4.method manual >/dev/null 2>&1 || true
    else
      nmcli connection modify "$CON" ipv4.method auto ipv4.addresses "" ipv4.gateway "" >/dev/null 2>&1 || true
    fi
    nmcli connection up "$CON" >/dev/null 2>&1 || true
  fi
}

reconnect() {
  DEV="$IFACE"
  if eth_up; then DEV="$ETH"; fi
  if command -v nmcli >/dev/null 2>&1; then
    CON="$(nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null | awk -F: -v d="$DEV" '$2==d{print $1; exit}')"
    if [ -n "$CON" ]; then
      nmcli connection down "$CON" >/dev/null 2>&1 || true
      nmcli connection up "$CON"
      return 0
    fi
    nmcli device disconnect "$DEV" >/dev/null 2>&1 || true
    nmcli device connect "$DEV"
    return 0
  fi
  ip link set "$DEV" down >/dev/null 2>&1 || true
  ip link set "$DEV" up >/dev/null 2>&1 || true
}

saved() {
  if command -v nmcli >/dev/null 2>&1; then
    nmcli -t -f NAME,TYPE,AUTOCONNECT connection show 2>/dev/null | awk -F: '
      $2 ~ /wireless|wifi/ { printf "%s\t%s\n", $1, ($3=="yes"?"auto":"manual") }
    '
  fi
}

autoconnect() {
  SSID="$(safe_ssid "${2:-}")"
  WANT="${3:-on}"
  [ -n "$SSID" ] || { echo "missing ssid" >&2; exit 1; }
  if command -v nmcli >/dev/null 2>&1; then
    FLAG=yes
    [ "$WANT" = "off" ] && FLAG=no
    nmcli connection modify "$SSID" connection.autoconnect "$FLAG" >/dev/null 2>&1 || true
  fi
}

scan() {
  rfkill unblock wifi >/dev/null 2>&1 || true
  ip link set "$IFACE" up >/dev/null 2>&1 || true
  if command -v nmcli >/dev/null 2>&1; then
    nmcli device wifi rescan >/dev/null 2>&1 || true
    nmcli -t -f SSID,SIGNAL,SECURITY device wifi list 2>/dev/null | awk -F: '
      $1 != "" {
        sec = ($3 == "" || $3 == "--") ? "open" : $3
        printf "%s\t%s\t%s\n", $1, $2, sec
      }
    '
    return 0
  fi
  echo "scan failed: NetworkManager is not available" >&2
  exit 1
}

# Password (if any) is read from stdin. It is never placed on a command line.
connect() {
  SSID="$(safe_ssid "${2:-}")"
  AUTO="${3:-}"
  HIDDEN="${4:-}"
  [ -n "$SSID" ] || { echo "missing ssid" >&2; exit 1; }
  PSK=""
  if [ ! -t 0 ]; then
    IFS= read -r PSK || true
  fi
  rfkill unblock wifi >/dev/null 2>&1 || true
  ip link set "$IFACE" up >/dev/null 2>&1 || true
  if ! command -v nmcli >/dev/null 2>&1; then
    echo "backend unavailable: no nmcli" >&2
    exit 1
  fi
  if [ -z "$PSK" ] && nmcli -t -f NAME connection show 2>/dev/null | grep -Fx "$SSID" >/dev/null; then
    ERR="$(nmcli --wait 30 connection up "$SSID" 2>&1)" && RC=0 || RC=$?
    if [ "$RC" -ne 0 ]; then
      echo "$ERR" >&2
      exit "$RC"
    fi
    return 0
  fi
  HIDDEN_BOOL=false
  [ "$HIDDEN" = "hidden" ] && HIDDEN_BOOL=true
  umask 077
  SAFE="$(printf '%s' "$SSID" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-40)"
  FILE="/etc/NetworkManager/system-connections/judie-${SAFE}.nmconnection"
  UUID="$(cat /proc/sys/kernel/random/uuid 2>/dev/null || date +%s)"
  {
    printf '[connection]\n'
    printf 'id=%s\n' "$SSID"
    printf 'uuid=%s\n' "$UUID"
    printf 'type=wifi\n'
    printf 'interface-name=%s\n' "$IFACE"
    if [ "$AUTO" = "off" ]; then
      printf 'autoconnect=false\n'
    else
      printf 'autoconnect=true\n'
    fi
    printf '\n[wifi]\n'
    printf 'ssid=%s\n' "$SSID"
    printf 'mode=infrastructure\n'
    printf 'hidden=%s\n' "$HIDDEN_BOOL"
    if [ -n "$PSK" ]; then
      printf '\n[wifi-security]\n'
      printf 'key-mgmt=wpa-psk\n'
      printf 'psk=%s\n' "$PSK"
    fi
    printf '\n[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n'
  } > "$FILE"
  chmod 600 "$FILE"
  ERR="$(nmcli connection load "$FILE" 2>&1; nmcli --wait 30 connection up "$SSID" 2>&1)" && RC=0 || RC=$?
  if [ "$RC" -ne 0 ]; then
    echo "$ERR" >&2
    exit "$RC"
  fi
}

disconnect() {
  if command -v nmcli >/dev/null 2>&1; then
    nmcli device disconnect "$IFACE" || true
    return 0
  fi
  echo "backend unavailable: no nmcli" >&2
  exit 1
}

forget() {
  SSID="$(safe_ssid "${2:-}")"
  [ -n "$SSID" ] || { echo "missing ssid" >&2; exit 1; }
  if command -v nmcli >/dev/null 2>&1; then
    nmcli connection delete "$SSID" >/dev/null
    return 0
  fi
  echo "backend unavailable: no nmcli" >&2
  exit 1
}

probe() {
  KIND="${2:-}"
  case "$KIND" in
    hostname)
      NAME="$(hostname 2>/dev/null || true)"
      [ -n "$NAME" ] || { echo "unavailable"; exit 1; }
      printf 'passed\t%s\n' "$NAME"
      ;;
    local)
      if eth_up || [ "$(cat "/sys/class/net/$IFACE/operstate" 2>/dev/null)" = "up" ]; then
        IP="$(eth_ip)"
        [ -n "$IP" ] || IP="$(ip -4 -o addr show "$IFACE" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
        if [ -n "$IP" ]; then
          printf 'passed\t%s\n' "$IP"
        else
          echo "failed	no address"
          exit 1
        fi
      else
        echo "failed	link down"
        exit 1
      fi
      ;;
    gateway)
      GW="$(ip -4 route show default 2>/dev/null | awk '{print $3; exit}')"
      [ -n "$GW" ] || { echo "unavailable	no gateway"; exit 1; }
      if ping -c 1 -W 2 "$GW" >/dev/null 2>&1; then
        printf 'passed\t%s\n' "$GW"
      else
        echo "timeout	$GW"
        exit 1
      fi
      ;;
    dns)
      if getent ahosts example.com >/dev/null 2>&1 || getent hosts example.com >/dev/null 2>&1; then
        echo "passed	example.com"
      else
        echo "failed	resolver"
        exit 1
      fi
      ;;
    internet)
      if command -v nmcli >/dev/null 2>&1; then
        CONN="$(nmcli networking connectivity check 2>/dev/null || nmcli -t -f CONNECTIVITY general 2>/dev/null)"
        case "$CONN" in
          full) echo "passed	full"; ;;
          limited|portal) echo "failed	limited"; exit 1 ;;
          *) echo "failed	no internet"; exit 1 ;;
        esac
      else
        if ping -c 1 -W 3 1.1.1.1 >/dev/null 2>&1; then
          echo "passed	1.1.1.1"
        else
          echo "timeout	1.1.1.1"
          exit 1
        fi
      fi
      ;;
    *)
      echo "unavailable	unknown check" >&2
      exit 1
      ;;
  esac
}

case "$CMD" in
  status) status ;;
  scan) scan ;;
  connect) connect "$@" ;;
  disconnect) disconnect ;;
  forget) forget "$@" ;;
  link) link ;;
  detail) detail ;;
  probe) probe "$@" ;;
  preferred)
    if [ -n "${2:-}" ]; then preferred_set "$@"; else preferred_get; fi
    ;;
  dhcp)
    if [ -n "${2:-}" ]; then dhcp_set "$@"; else dhcp_get; fi
    ;;
  reconnect) reconnect ;;
  saved) saved ;;
  autoconnect) autoconnect "$@" ;;
  *) echo "usage: wifi status|scan|connect|disconnect|forget|link|detail|probe|preferred|dhcp|reconnect|saved|autoconnect" >&2; exit 1 ;;
esac
