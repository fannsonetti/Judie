#!/bin/sh
# Client side of xinit. Bare Xorg has no WM, so EWMH fullscreen is a no-op.
# Resize to the active output once the window maps (xdotool). The binary also
# sizes itself from /sys/class/graphics/fb0/virtual_size when rebuilt.
(
  i=0
  while [ "$i" -lt 20 ]; do
    i=$((i + 1))
    sleep 1
    geom=$(DISPLAY=:0 xrandr --current 2>/dev/null | awk '/\*/ { print $1; exit }')
    [ -n "$geom" ] || continue
    w=${geom%x*}
    h=${geom#*x}
    if command -v xdotool >/dev/null 2>&1; then
      DISPLAY=:0 xdotool search --onlyvisible --name Judie windowmove 0 0 windowsize "$w" "$h" 2>/dev/null && exit 0
    fi
  done
) &
exec /usr/bin/judie
