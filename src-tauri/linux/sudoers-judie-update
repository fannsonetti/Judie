# Judie kiosk helpers — no password, kiosk user only.
# Template: postinst replaces KIOSK_USER and installs it as /etc/sudoers.d/judie-update.
KIOSK_USER ALL=(root) NOPASSWD: /usr/lib/judie/apply-update
KIOSK_USER ALL=(root) NOPASSWD: /usr/lib/judie/wifi
KIOSK_USER ALL=(root) NOPASSWD: /usr/lib/judie/power
