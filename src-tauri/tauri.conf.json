{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Judie",
  "version": "0.2.6",
  "identifier": "com.judie.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Judie",
        "width": 1920,
        "height": 1200,
        "resizable": true,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2NzQyQTI3OEQ4MTQxODAKUldTQVFZR05KeXAwMWtxNXF2Z3h4cHRQMDhBWGYzVm5CNmJhUkFLbHc4R0xNSldHMVVsb0RDcEsK",
      "endpoints": [
        "https://github.com/fannsonetti/Judie/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
