import { AnsiKeyboard } from "keyboard.slint";
import { WidgetFace } from "faces.slint";

export component MainWindow inherits Window {
    title: "Judie";
    preferred-width: 1920px;
    preferred-height: 1200px;
    background: #000000;
    no-frame: true;

    in-out property <string> clock: "--:--";
    in-out property <string> date-text: "";
    in-out property <string> version-text: "";
    in-out property <string> status-label: "";
    in-out property <string> host-ip: "NO IP";
    in-out property <bool> dnd: false;
