    property <length> pad: 20px * Dy.ui-scale;
    property <length> gap: 8px * Dy.ui-scale;
    property <length> rail-w: root.sidebar ? 640px : 0px;
    property <int> tap-count: 0;
    property <length> swipe-x: 0px;
    property <length> expand-drag: 0px;
    property <float> settings-pull: 0;
    property <bool> settings-tracking: false;
    property <bool> settings-armed: false;
    property <length> settings-start: 0px;
    property <float> settings-base: 0;
    property <float> settings-from: 0;
    property <float> settings-goal: 0;
    property <float> settings-anim-t: 1;
    property <int> settings-anim-ms: 240;
    property <bool> settings-animating: false;
    property <float> settings-velocity: 0;
    property <float> settings-prev-pull: 0;
    property <int> settings-kind: 0;
    property <int> sheet-id: 0;
    property <float> settings-eased: 0;
    property <string> drag-id: "";
    property <string> drag-kind: "activity";
    in-out property <string> drag-size: "1x1";
    property <bool> drag-use-layout: false;
    property <bool> drag-border: true;
    property <length> drag-dx: 0px;
    property <length> drag-dy: 0px;
    property <length> drag-ox: 0px;
    property <length> drag-oy: 0px;
    property <length> drag-w: 0px;
    property <length> drag-h: 0px;
    property <length> drag-press-x: 0px;
    property <length> drag-press-y: 0px;
    property <int> drag-from-col: 0;
    property <int> drag-from-row: 0;
    property <bool> drag-live: false;
    property <bool> drag-settle: false;
    property <bool> drag-closing: false;
    property <duration> drag-ease: 0ms;
    property <length> gallery-swipe: 0px;
    property <bool> gallery-swiping: false;
    property <length> gallery-press-x: 0px;
    property <int> gallery-index: 0;
    in-out property <int> drop-col: 0;
    in-out property <int> drop-row: 0;

    property <duration> gallery-ease: 0ms;
    property <string> gallery-size-caption: root.gallery-index == 0 ? "Small  240×240" : ((root.gallery-index == 1 && root.gallery-kind != "clock" && root.gallery-kind != "pong") ? "Medium  480×240" : "Large  480×480");
    property <length> general-col: min(760px, root.width - 80px);

    animate drag-dx { duration: drag-ease; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    animate drag-dy { duration: drag-ease; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    animate gallery-swipe { duration: gallery-ease; easing: cubic-bezier(0.22, 1, 0.36, 1); }

    function settings-pos(area-y: length, local-y: length) -> length {
        return area-y + local-y;
    }

    function settings-follow(window-y: length) {
        root.settings-pull = max(0, min(1, root.settings-base + ((window-y - root.settings-start) / root.height)));
    }

    function settings-begin(kind: int, window-y: length) {
        root.settings-animating = false;
        root.settings-kind = kind;
        root.settings-armed = false;
        root.settings-tracking = true;
        root.settings-start = window-y;
        root.settings-base = root.settings-pull;
        root.settings-prev-pull = root.settings-pull;
        root.settings-velocity = 0;
        root.net-menu-open = false;
    }

    function settings-commit() {
        root.settings-animating = false;
        root.settings-pull = root.settings-goal;
        if root.settings-goal >= 0.5 {
            root.open-settings();
        } else {
            root.close-overlay();
        }
    }

    function sheet-wanted() -> float {
        return root.settings-open ? 1.0 : 0.0;
    }

    function sheet-can-open() -> bool {
        return !root.sidebar && !root.settings-open && root.settings-pull < 0.08;
    }

    function arm-sheet-open(id: int, window-y: length) {
        if !root.sheet-can-open() {
            return;
        }
        root.sheet-id = id;
        root.settings-armed = true;
        root.settings-kind = 0;
        root.settings-start = window-y;
        root.settings-base = root.settings-pull;
    }

    function sheet-sync-overlay() {
        if root.settings-tracking || root.settings-animating {
            return;
        }
        if abs(root.settings-pull - root.sheet-wanted()) < 0.001 {
            return;
        }
        root.settings-from = root.settings-pull;
        root.settings-goal = root.sheet-wanted();
        root.settings-anim-t = 0;
        root.settings-anim-ms = root.reduced-motion ? 90 : 240;
        root.settings-animating = true;
    }

    function settings-finish(cancelled: bool) {
        if !root.settings-tracking && !root.settings-armed {
            return;
        }
        root.settings-armed = false;
        if !root.settings-tracking {
            return;
        }
        root.settings-tracking = false;
        root.settings-from = root.settings-pull;
        if cancelled {
            root.settings-goal = root.settings-kind == 0 ? 0.0 : 1.0;
        } else if root.settings-kind == 0 {
            if root.settings-pull < 0.06 {
                root.settings-goal = 0.0;
            } else if root.settings-velocity > 0.85 {
                root.settings-goal = 1.0;
            } else if root.settings-velocity < -0.85 {
                root.settings-goal = 0.0;
            } else if root.settings-pull >= 0.32 {
                root.settings-goal = 1.0;
            } else {
                root.settings-goal = 0.0;
            }
        } else if (1.0 - root.settings-pull) < 0.06 {
            root.settings-goal = 1.0;
        } else if root.settings-velocity < -0.85 {
            root.settings-goal = 0.0;
        } else if root.settings-velocity > 0.85 {
            root.settings-goal = 1.0;
        } else if root.settings-pull <= 0.68 {
            root.settings-goal = 0.0;
        } else {
            root.settings-goal = 1.0;
        }
        if abs(root.settings-goal - root.settings-from) < 0.001 {
            root.settings-commit();
        } else {
            root.settings-anim-t = 0;
            root.settings-anim-ms = root.reduced-motion ? 90 : 240;
            root.settings-animating = true;
        }
    }

    changed settings-open => {
        if root.settings-open {
            root.sheet-id = 0;
        }
        root.sheet-sync-overlay();
    }

    property <bool> settings-page: root.sidebar && root.expanded == "settings";

    changed text-scale => { Dy.text-scale = root.text-scale / 100.0; }
    changed ui-scale => { Dy.ui-scale = root.ui-scale / 100.0; }
    changed header-h-px => { Dy.header-h = root.header-h-px * 1px; }
    changed hit-target-px => { Dy.hit-target = root.hit-target-px * 1px; }
    changed blocky-font => { Dy.mono = root.blocky-font ? "Press Start 2P" : "DejaVu Sans Mono"; }

    HorizontalLayout {
        padding: 0;
        spacing: 0;
        if root.sidebar: Rectangle {
            width: root.rail-w;
            background: #000000;
        }
        VerticalLayout {
        padding: 0;
        spacing: 0;

        Rectangle {
            height: Dy.header-h;
            background: #000000;
            HorizontalLayout {
                x: root.pad;
                y: 0;
                height: 100%;
                width: parent.width / 3 - root.pad * 2;
                spacing: 10px;
                Text {
                    text: "v" + root.version-text;
                    color: #ffffff;
                    opacity: 0.1;
                    font-size: Dy.type-status;
                    font-family: Dy.mono;
                    vertical-alignment: center;
                }
                if root.dnd: Text {
                    text: "DND";
                    color: #ffffff;
                    font-size: Dy.type-status;
                    font-family: Dy.mono;
                    vertical-alignment: center;
                }
            }
            actions-edge := TouchArea {
                x: parent.width / 3;
                width: parent.width / 3;
                height: 100%;
                VerticalLayout {
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 2px;
                    alignment: center;
                    if !root.hide-header-clock: VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: root.clock;
                            color: #ffffff;
                            font-size: Dy.type-clock;
                            font-weight: 700;
                            font-family: Dy.mono;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.date-text;
                            color: #8a8a8a;
                            font-size: Dy.type-status;
                            font-family: Dy.mono;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
            net-btn := TouchArea {
                x: parent.width - Dy.hit-target * 2 - 16px;
                width: Dy.hit-target;
                height: 100%;
                clicked => {
                    if root.settings-pull < 0.08 && !root.settings-tracking && !root.settings-open {
                        root.note-input();
                        if root.net-menu-open { root.close-net-menu(); } else { root.open-net-menu(); }
                    }
                }
                NetGlyph {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    zoom: Dy.header-h / 108px;
                    kind: root.net-kind;
                    bars: root.net-bars;
                }
            }
            vol-btn := TouchArea {
                x: parent.width - Dy.hit-target - 8px;
                width: Dy.hit-target;
                height: 100%;
                clicked => {
                    if root.settings-pull < 0.08 && !root.settings-tracking && !root.settings-open {
                        root.note-input();
                        if root.vol-menu-open { root.close-vol-menu(); } else { root.open-vol-menu(); }
                    }
                }
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.down {
                        root.arm-sheet-open(0, root.settings-pos(self.absolute-position.y, self.mouse-y));
                    }
                    if ev.kind == PointerEventKind.up {
                        root.settings-finish(false);
                    }
                    if ev.kind == PointerEventKind.cancel {
                        root.settings-finish(true);
                    }
                }
                moved => {
                    if self.pressed && !root.settings-open && !root.palette-open && (root.settings-tracking || root.settings-armed) && root.sheet-id == 0 {
                        if !root.settings-tracking && root.settings-pos(self.absolute-position.y, self.mouse-y) - root.settings-start > 18px {
                            root.settings-begin(0, root.settings-start);
                        }
                        if root.settings-tracking {
                            root.settings-follow(root.settings-pos(self.absolute-position.y, self.mouse-y));
                        }
                    }
                }
                VolumeGlyph {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    zoom: Dy.header-h / 108px;
                }
            }
            settings-edge := TouchArea {
                x: parent.width * 2 / 3;
                width: parent.width / 3 - Dy.hit-target * 2 - 16px;
                height: 100%;
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.down {
                        root.arm-sheet-open(0, root.settings-pos(self.absolute-position.y, self.mouse-y));
                    }
                    if ev.kind == PointerEventKind.up {
                        root.settings-finish(false);
                    }
                    if ev.kind == PointerEventKind.cancel {
                        root.settings-finish(true);
                    }
                }
                moved => {
                    if self.pressed && !root.settings-open && !root.palette-open && (root.settings-tracking || root.settings-armed) && root.sheet-id == 0 {
                        if !root.settings-tracking && root.settings-pos(self.absolute-position.y, self.mouse-y) - root.settings-start > 18px {
                            root.settings-begin(0, root.settings-start);
                        }
                        if root.settings-tracking {
                            root.settings-follow(root.settings-pos(self.absolute-position.y, self.mouse-y));
                        }
                    }
                }
            }
        }

        if root.header-line: Rectangle {
            height: 1px;
            background: #ffffff;
        }

        home-touch := TouchArea {
            clicked => {
                root.note-input();
                root.tap-count += 1;
                if root.tap-count >= 3 {
                    root.enter-edit();
                    root.tap-count = 0;
                }
            }
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down {
                    root.note-input();
                    root.swipe-x = self.mouse-x;
                }
                if ev.kind == PointerEventKind.up && !root.edit-mode && root.expanded == "" {
                    if self.mouse-x - root.swipe-x < -80px && root.page < root.page-count - 1 {
                        root.set-page(root.page + 1);
                    }
                    if self.mouse-x - root.swipe-x > 80px && root.page > 0 {
                        root.set-page(root.page - 1);
                    }
                }
            }
            vertical-stretch: 1;
            Timer {
                interval: 550ms;
                running: root.tap-count > 0;
                triggered => { root.tap-count = 0; }
            }
            Timer {
                interval: 450ms;
                running: home-touch.pressed && !root.edit-mode && root.expanded == "" && !root.gallery-open && !root.creator-open && !root.settings-open && !root.palette-open;
                triggered => { root.hold-home(); }
            }
            Rectangle {
                property <length> cell: min(self.width / root.grid-cols, self.height / 4);
                property <length> ox: (self.width - cell * root.grid-cols) / 2;
                property <length> oy: (self.height - cell * 4) / 2;
                property <length> g: 8px * Dy.ui-scale;

                Timer {
                    interval: 16ms;
                    running: root.drag-settle;
                    triggered => {
                        root.drag-ease = 220ms;
                        root.drag-dx = 0px;
                        root.drag-dy = 0px;
                        root.drag-settle = false;
                        root.drag-closing = true;
                    }
                }
                Timer {
                    interval: 230ms;
                    running: root.drag-closing;
                    triggered => {
                        root.drag-closing = false;
                        root.drag-id = "";
                        root.drag-live = false;
                        root.drag-ease = 0ms;
                    }
                }

                for w in root.slots: TileShell {
                    x: ox + w.col * cell;
                    y: oy + w.row * cell;
                    width: w.cols * cell - g;
                    height: w.rows * cell - g;
                    visible: w.page == root.page;
                    editing: root.edit-mode;
                    pending: root.pending-remove == w.id;
                    show-border: w.border;
                    ghost: root.drag-id == w.id;
                    vis-x: 0px;
                    vis-y: 0px;
                    tapped => { root.expand(w.kind); }
                    held => { root.hold-home(); }
                    remove => { root.request-remove(w.id); }
                    drag-begin(lx, ly) => {
                        root.drag-closing = false;
                        root.drag-settle = false;
                        root.drag-id = w.id;
                        root.drag-kind = w.kind;
                        root.drag-use-layout = w.use-layout;
                        root.drag-border = w.border;
                        root.drag-size = w.size;
                        root.drag-from-col = w.col;
                        root.drag-from-row = w.row;
                        root.drag-ox = ox + w.col * cell;
                        root.drag-oy = oy + w.row * cell;
                        root.drag-w = w.cols * cell - g;
                        root.drag-h = w.rows * cell - g;
                        root.drag-press-x = lx;
                        root.drag-press-y = ly;
                        root.drag-ease = 0ms;
                        root.drag-dx = 0px;
                        root.drag-dy = 0px;
                        root.drag-live = true;
                    }
                    drag-move(lx, ly) => {
                        if root.drag-id == w.id && root.drag-live {
                            root.drag-dx = lx - root.drag-press-x;
                            root.drag-dy = ly - root.drag-press-y;
                        }
                    }
                    drag-end => {
                        if root.drag-id == w.id && root.drag-live {
                            root.drag-live = false;
                            root.drop-col = max(0, min(root.grid-cols - w.cols, round((root.drag-from-col * cell + root.drag-dx) / cell)));
                            root.drop-row = max(0, min(4 - w.rows, round((root.drag-from-row * cell + root.drag-dy) / cell)));
                            root.drag-ease = 0ms;
                            root.drag-drop(w.id, root.drop-col, root.drop-row);
                            root.drag-ox = ox + root.drop-col * cell;
                            root.drag-oy = oy + root.drop-row * cell;
                            root.drag-dx = root.drag-dx - (root.drop-col - root.drag-from-col) * cell;
                            root.drag-dy = root.drag-dy - (root.drop-row - root.drag-from-row) * cell;
                            root.drag-settle = true;
                        }
                    }
                    drag-cancel => {
                        if root.drag-id == w.id && root.drag-live {
                            root.drag-live = false;
                            root.drag-settle = true;
                        }
                    }

                    WidgetFace {
                        kind: w.kind;
                        size: w.size;
                        sample: false;
                        source: "live";
                        widget-id: w.id;
                        weather-loc: root.weather-loc;
                        weather-temp: root.weather-temp;
                        weather-cond: root.weather-cond;
                        weather-range: root.weather-range;
                        weather-feel: root.weather-feel;
                        weather-note: root.weather-note;
                        hours: root.hours;
                        master-on: root.master-on;
                        brightness: root.brightness;
                        scene: root.scene;
                        master-color: root.master-color;
                        lights: root.lights;
                        playing: root.playing;
                        track-title: root.track-title;
                        track-artist: root.track-artist;
                        volume: root.volume;
                        media-progress: root.media-progress;
                        indoor: root.indoor;
                        outdoor: root.outdoor;
                        humidity: root.humidity;
                        comfort: root.comfort;
                        events: root.events;
                        month-name: root.month-name;
                        cal-cells: root.cal-cells;
                        purifier-on: root.purifier-on;
                        purifier-mode: root.purifier-mode;
                        purifier-aq: root.purifier-aq;
                        purifier-filter: root.purifier-filter;
                        cpu: root.cpu;
                        memory: root.memory;
                        mem-detail: root.mem-detail;
                        temp-text: root.temp-text;
                        services: root.services;
                        activity: root.activity;
                        timers: root.timers;
                        slop-nodes: root.slop-nodes;
                        dnd: root.dnd;
                        use-layout: w.use-layout;
                        terminal-input: root.terminal-input;
                        terminal-lines: root.terminal-lines;
                        terminal-kb-active: root.kb-open && root.kb-field == "terminal";
                        clock-hm: root.clock-hm;
                        clock-hms: root.clock-hms;
                        hour-deg: root.hour-deg;
                        minute-deg: root.minute-deg;
                        second-deg: root.second-deg;
                        pong-ly: root.pong-ly;
                        pong-ry: root.pong-ry;
                        pong-bx: root.pong-bx;
                        pong-by: root.pong-by;
                        toggle-master => { root.toggle-master(); }
                        brightness-changed(v) => { root.brightness-changed(v); }
                        set-color(c) => { root.set-color(c); }
                        toggle-light(id) => { root.toggle-light(id); }
                        toggle-play => { root.toggle-play(); }
                        next-track => { root.next-track(); }
                        prev-track => { root.prev-track(); }
                        volume-changed(v) => { root.volume-changed(v); }
                        quick(id) => { root.quick(id); }
                        set-purifier-mode(m) => { root.set-purifier-mode(m); }
                        open-terminal-input => { root.open-keyboard("terminal"); }
                        submit-terminal => { root.submit-terminal(); }
                    }
                }

                if root.page-count > 1: HorizontalLayout {
                    y: parent.height - 28px;
                    width: parent.width;
                    height: 16px;
                    alignment: center;
                    spacing: 8px;
                    Rectangle {
                        width: 8px; height: 8px; border-radius: 0px;
                        background: root.page == 0 ? #e6e6e6 : #555555;
                    }
                    Rectangle {
                        width: 8px; height: 8px; border-radius: 0px;
                        background: root.page == 1 ? #e6e6e6 : #555555;
                    }
                    if root.page-count > 2: Rectangle {
                        width: 8px; height: 8px; border-radius: 0px;
                        background: root.page == 2 ? #e6e6e6 : #555555;
                    }
                    if root.page-count > 3: Rectangle {
                        width: 8px; height: 8px; border-radius: 0px;
                        background: root.page == 3 ? #e6e6e6 : #555555;
                    }
                    if root.page-count > 4: Rectangle {
                        width: 8px; height: 8px; border-radius: 0px;
                        background: root.page == 4 ? #e6e6e6 : #555555;
                    }
                    if root.page-count > 5: Rectangle {
                        width: 8px; height: 8px; border-radius: 0px;
                        background: root.page == 5 ? #e6e6e6 : #555555;
                    }
                }

                if root.edit-mode: Rectangle {
                    y: parent.height - 120px;
                    height: 120px;
                    width: parent.width;
                    background: #000000cc;
                    HorizontalLayout {
                        padding: 10px; spacing: 10px; alignment: center;
                        Pill { label: "ADD WIDGET"; on: true; clicked => {
                            root.gallery-index = root.gallery-size == "2x2" ? 2 : (root.gallery-size == "1x2" ? 1 : 0);
                            root.open-gallery();
                        } }
                        Pill { label: "DONE"; clicked => { root.exit-edit(); } }
                    }
                }

                if root.drag-id != "": TileShell {
                    x: root.drag-ox + root.drag-dx;
                    y: root.drag-oy + root.drag-dy;
                    width: root.drag-w;
                    height: root.drag-h;
                    editing: root.edit-mode;
                    pending: root.pending-remove == root.drag-id;
                    layer: true;
                    ghost: false;
                    show-border: root.drag-border;
                    WidgetFace {
                        kind: root.drag-kind;
                        size: root.drag-size;
                        sample: false;
                        source: "live";
                        widget-id: root.drag-id;
                        weather-loc: root.weather-loc;
                        weather-temp: root.weather-temp;
                        weather-cond: root.weather-cond;
                        weather-range: root.weather-range;
                        weather-feel: root.weather-feel;
                        weather-note: root.weather-note;
                        hours: root.hours;
                        master-on: root.master-on;
                        brightness: root.brightness;
                        scene: root.scene;
                        master-color: root.master-color;
                        lights: root.lights;
                        playing: root.playing;
                        track-title: root.track-title;
                        track-artist: root.track-artist;
                        volume: root.volume;
                        media-progress: root.media-progress;
                        indoor: root.indoor;
                        outdoor: root.outdoor;
                        humidity: root.humidity;
                        comfort: root.comfort;
                        events: root.events;
                        month-name: root.month-name;
                        cal-cells: root.cal-cells;
                        purifier-on: root.purifier-on;
                        purifier-mode: root.purifier-mode;
                        purifier-aq: root.purifier-aq;
                        purifier-filter: root.purifier-filter;
                        cpu: root.cpu;
                        memory: root.memory;
                        mem-detail: root.mem-detail;
                        temp-text: root.temp-text;
                        services: root.services;
                        activity: root.activity;
                        timers: root.timers;
                        slop-nodes: root.slop-nodes;
                        dnd: root.dnd;
                        use-layout: root.drag-use-layout;
                        terminal-input: root.terminal-input;
                        terminal-lines: root.terminal-lines;
                        terminal-kb-active: false;
                        clock-hm: root.clock-hm;
                        clock-hms: root.clock-hms;
                        hour-deg: root.hour-deg;
                        minute-deg: root.minute-deg;
                        second-deg: root.second-deg;
                        pong-ly: root.pong-ly;
                        pong-ry: root.pong-ry;
                        pong-bx: root.pong-bx;
                        pong-by: root.pong-by;
                        toggle-master => { root.toggle-master(); }
                        brightness-changed(v) => { root.brightness-changed(v); }
                        set-color(c) => { root.set-color(c); }
                        toggle-light(id) => { root.toggle-light(id); }
                        toggle-play => { root.toggle-play(); }
                        next-track => { root.next-track(); }
                        prev-track => { root.prev-track(); }
                        volume-changed(v) => { root.volume-changed(v); }
                        quick(id) => { root.quick(id); }
                        set-purifier-mode(m) => { root.set-purifier-mode(m); }
                        open-terminal-input => { }
                        submit-terminal => { }
                    }
                }

                for w in root.slots: WidgetRemoveBtn {
                    x: ox + (w.col + w.cols) * cell - g - 20px;
                    y: oy + w.row * cell - 20px;
                    active: root.edit-mode && w.page == root.page && root.drag-id != w.id;
                    label: w.label != "" ? "Remove " + w.label : "Remove widget";
                    remove => { root.request-remove(w.id); }
                }
            }
        }
        }
    }

    if root.pending-remove != "": Rectangle {
        x: root.rail-w;
        width: parent.width - root.rail-w;
        background: #000000cc;
        TouchArea { clicked => { root.cancel-remove(); } }
        Rectangle {
            x: (parent.width - min(520px, parent.width * 0.72)) / 2; y: parent.height * 0.32; width: min(520px, parent.width * 0.72); height: 320px;
            border-radius: 0px; background: #000000;
            border-width: 1px; border-color: #3d3d3d;
            VerticalLayout {
                padding: 20px; spacing: 12px;
                Text { text: "REMOVE WIDGET?"; color: #e6e6e6; font-size: 16px; font-weight: 700; font-family: Dy.mono; }
                Text { text: root.pending-label == "" ? "This tile will leave the home screen." : root.pending-label; color: #7a7a7a; font-size: 12px; font-family: Dy.mono; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 10px;
                    Pill { label: "CANCEL"; clicked => { root.cancel-remove(); } }
                    Pill { label: "REMOVE"; on: true; clicked => { root.confirm-remove(); } }
                }
            }
        }
    }

    if root.settings-tracking: TouchArea {
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.up {
                root.settings-finish(false);
            }
            if ev.kind == PointerEventKind.cancel {
                root.settings-finish(true);
            }
        }
        moved => {
            root.settings-follow(root.settings-pos(self.absolute-position.y, self.mouse-y));
        }
    }

    Timer {
        interval: 16ms;
        running: root.settings-tracking;
        triggered => {
            root.settings-velocity = (root.settings-pull - root.settings-prev-pull) / 0.016;
            root.settings-prev-pull = root.settings-pull;
        }
    }

    Timer {
        interval: 16ms;
        running: root.settings-animating;
        triggered => {
            root.settings-anim-t = min(1.0, root.settings-anim-t + 16.0 / root.settings-anim-ms);
            if root.reduced-motion {
                root.settings-eased = root.settings-anim-t;
            } else {
                root.settings-eased = 1.0 - (1.0 - root.settings-anim-t) * (1.0 - root.settings-anim-t) * (1.0 - root.settings-anim-t);
            }
            root.settings-pull = root.settings-from + (root.settings-goal - root.settings-from) * root.settings-eased;
            if root.settings-anim-t >= 1 {
                root.settings-commit();
            }
        }
    }

    if root.settings-page || root.settings-pull > 0.001: Rectangle {
        x: root.rail-w;
        y: root.settings-page ? Dy.header-h : (root.settings-pull - 1.0) * parent.height;
        width: parent.width - root.rail-w;
        height: root.settings-page ? (parent.height - Dy.header-h) : 100%;
        background: #000000;
        clip: true;
        TouchArea {
            width: 100%;
            height: 100%;
        }
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 12px;
            padding-bottom: 20px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 28px;
                height: 36px;
                TouchArea {
                    clicked => { root.set-tab(0); }
                    Text { text: "General"; color: root.settings-tab == 0 ? #ffffff : #6a6a6a; font-size: Dy.type-control; font-family: Dy.mono; vertical-alignment: center; }
                }
                TouchArea {
                    clicked => { root.set-tab(1); }
                    Text { text: "Network"; color: root.settings-tab == 1 ? #ffffff : #6a6a6a; font-size: Dy.type-control; font-family: Dy.mono; vertical-alignment: center; }
                }
                TouchArea {
                    clicked => { root.set-tab(2); }
                    Text { text: "Power"; color: root.settings-tab == 2 ? #ffffff : #6a6a6a; font-size: Dy.type-control; font-family: Dy.mono; vertical-alignment: center; }
                }
                TouchArea {
                    clicked => { root.set-tab(3); }
                    Text { text: "Device"; color: root.settings-tab == 3 ? #ffffff : #6a6a6a; font-size: Dy.type-control; font-family: Dy.mono; vertical-alignment: center; }
                }
                TouchArea {
                    clicked => { root.set-tab(4); }
                    Text { text: "Accessibility"; color: root.settings-tab == 4 ? #ffffff : #6a6a6a; font-size: Dy.type-control; font-family: Dy.mono; vertical-alignment: center; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Flickable {
                vertical-stretch: 1;
                viewport-height: settings-scroll.preferred-height;
                interactive: !root.settings-tracking;
                settings-scroll := VerticalLayout {
                    alignment: start;
                    spacing: 14px;
                    if root.settings-tab == 0: HorizontalLayout {
                        alignment: center;
                        VerticalLayout {
                            alignment: start;
                            width: root.general-col;
                            spacing: 18px;
                            padding-bottom: 80px;
                            FieldTap { label: "Username"; value: root.room-name; active: root.kb-field == "room-name"; label-size: 15px; value-size: 22px; tap-height: 78px; tapped => { root.open-keyboard("room-name"); } }
                            Text { text: "Location"; color: #6a6a6a; font-size: 18px; font-family: Dy.mono; }
                            FieldTap { label: "Location name"; value: root.weather-loc; active: root.kb-field == "location"; label-size: 15px; value-size: 22px; tap-height: 78px; tapped => { root.open-keyboard("location"); } }
                            HorizontalLayout {
                                spacing: 20px;
                                FieldTap { label: "Latitude"; value: root.latitude; active: root.kb-field == "latitude"; label-size: 15px; value-size: 22px; tap-height: 78px; tapped => { root.open-keyboard("latitude"); } }
                                FieldTap { label: "Longitude"; value: root.longitude; active: root.kb-field == "longitude"; label-size: 15px; value-size: 22px; tap-height: 78px; tapped => { root.open-keyboard("longitude"); } }
                            }
                            Text { text: "Units"; color: #6a6a6a; font-size: 18px; font-family: Dy.mono; }
                            VerticalLayout {
                                spacing: 10px;
                                Rectangle {
                                    height: 58px;
                                    border-width: 1.5px;
                                    border-color: root.temp-unit == "c" ? #ffffff : #2a2a2a;
                                    TouchArea { clicked => { root.set-units-preset("c-km"); } }
                                    Text {
                                        x: 16px;
                                        height: 100%;
                                        text: "Celsius and kilometres";
                                        color: root.temp-unit == "c" ? #ffffff : #8a8a8a;
                                        font-size: 20px;
                                        font-family: Dy.mono;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {
                                    height: 58px;
                                    border-width: 1.5px;
                                    border-color: root.temp-unit == "f" ? #ffffff : #2a2a2a;
                                    TouchArea { clicked => { root.set-units-preset("f-mi"); } }
                                    Text {
                                        x: 16px;
                                        height: 100%;
                                        text: "Fahrenheit and miles";
                                        color: root.temp-unit == "f" ? #ffffff : #8a8a8a;
                                        font-size: 20px;
                                        font-family: Dy.mono;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {
                                    height: 58px;
                                    border-width: 1.5px;
                                    border-color: root.temp-unit == "k" ? #ffffff : #2a2a2a;
                                    TouchArea { clicked => { root.set-units-preset("k-fur"); } }
                                    Text {
                                        x: 16px;
                                        height: 100%;
                                        text: "Kelvin and furlongs";
                                        color: root.temp-unit == "k" ? #ffffff : #8a8a8a;
                                        font-size: 20px;
                                        font-family: Dy.mono;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Text { text: "Voice"; color: #6a6a6a; font-size: 18px; font-family: Dy.mono; }
                            HorizontalLayout {
                                spacing: 20px;
                                height: 56px;
                                Text { text: "Microphone"; color: #ffffff; font-size: 22px; font-family: Dy.mono; vertical-alignment: center; }
                                Toggle { on: root.voice-enabled; toggled => { root.toggle-voice(); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 20px;
                                height: 56px;
                                Text { text: "Voice Response"; color: #ffffff; font-size: 22px; font-family: Dy.mono; vertical-alignment: center; }
                                Toggle { on: root.speak-replies; toggled => { root.toggle-speak(); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Text { text: "Routines"; color: #6a6a6a; font-size: 18px; font-family: Dy.mono; }
                            Pill { label: "Add"; on: true; clicked => { root.add-routine(); } }
                            for r in root.routines: RoutineCard {
                                item: r;
                                kb-field: root.kb-field;
                                edit-name => { root.open-keyboard("routine-name:" + r.id); }
                                edit-phrase => { root.open-keyboard("routine-phrase:" + r.id); }
                                edit-command => { root.open-keyboard("routine-command:" + r.id); }
                                save => { root.save-routine(r.id); }
                                cancel => { root.cancel-routine(r.id); }
                                duplicate => { root.duplicate-routine(r.id); }
                                toggle-enabled => { root.toggle-routine(r.id); }
                                delete => { root.delete-routine(r.id); }
                            }
                        }
                    }
                    if root.settings-tab == 1: HorizontalLayout {
                        alignment: center;
                        VerticalLayout {
                            alignment: start;
                            width: root.general-col;
                            spacing: 10px;
                            padding-bottom: 80px;
                            Text { text: root.net-headline; color: #ffffff; font-size: 16px; font-family: Dy.mono; }
                            Text { text: "Type"; color: #8a8a8a; font-size: 12px; font-family: Dy.mono; }
                            Text { text: root.net-kind; color: #ffffff; font-size: 14px; font-family: Dy.mono; }
                            Text { text: "Interface"; color: #8a8a8a; font-size: 12px; font-family: Dy.mono; }
                            Text { text: root.net-iface; color: #ffffff; font-size: 14px; font-family: Dy.mono; }
                            Text { text: "SSID"; color: #8a8a8a; font-size: 12px; font-family: Dy.mono; }
                            Text { text: root.wifi-ssid; color: #ffffff; font-size: 14px; font-family: Dy.mono; overflow: elide; }
                            Text { text: "State"; color: #8a8a8a; font-size: 12px; font-family: Dy.mono; }
                            Text { text: root.wifi-state; color: #ffffff; font-size: 14px; font-family: Dy.mono; }
                            Text { text: "Signal"; color: #8a8a8a; font-size: 12px; font-family: Dy.mono; }
                            Text { text: root.net-signal; color: #ffffff; font-size: 14px; font-family: Dy.mono; }
                            Text { text: "Security"; color: #8a8a8a; font-size: 12px; font-family: Dy.mono; }
                            Text { text: root.net-security; color: #ffffff; font-size: 14px; font-family: Dy.mono; }
                            Text { text: "IPv4"; color: #8a8a8a; font-size: 12px; font-family: Dy.mono; }
                            Text { text: root.wifi-ip; color: #ffffff; font-size: 14px; font-family: Dy.mono; }
                            Text { text: "IPv6"; color: #8a8a8a; font-size: 12px; font-family: Dy.mono; }
                            Text { text: root.net-ipv6; color: #ffffff; font-size: 14px; font-family: Dy.mono; wrap: word-wrap; }
                            Text { text: "Gateway"; color: #8a8a8a; font-size: 12px; font-family: Dy.mono; }
                            Text { text: root.net-gateway; color: #ffffff; font-size: 14px; font-family: Dy.mono; }
                            Text { text: "DNS"; color: #8a8a8a; font-size: 12px; font-family: Dy.mono; }
                            Text { text: root.net-dns; color: #ffffff; font-size: 14px; font-family: Dy.mono; wrap: word-wrap; }
                            Text { text: "MAC"; color: #8a8a8a; font-size: 12px; font-family: Dy.mono; }
                            Text { text: root.net-mac; color: #ffffff; font-size: 14px; font-family: Dy.mono; }
                            Text { text: "Link speed"; color: #8a8a8a; font-size: 12px; font-family: Dy.mono; }
                            Text { text: root.net-speed; color: #ffffff; font-size: 14px; font-family: Dy.mono; }
                            Text { text: "Preferred interface"; color: #8a8a8a; font-size: 12px; font-family: Dy.mono; }
                            HorizontalLayout {
                                spacing: 8px;
                                Pill { label: "Ethernet"; on: root.preferred-net == "ethernet"; clicked => { root.set-preferred-net("ethernet"); } }
                                Pill { label: "Wi-Fi"; on: root.preferred-net == "wifi"; clicked => { root.set-preferred-net("wifi"); } }
                            }
                            HorizontalLayout {
                                Text { text: "DHCP"; color: #ffffff; font-size: 16px; font-family: Dy.mono; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Toggle { on: root.dhcp-on; toggled => { root.toggle-dhcp(); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Pill { label: "Reconnect"; on: true; clicked => { root.reconnect-net(); } }
                                if root.net-kind == "wifi": Pill { label: "Disconnect Wi-Fi"; clicked => { root.disconnect-wifi(); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Nearby Wi-Fi"; color: #6a6a6a; font-size: 12px; font-family: Dy.mono; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Pill { label: root.wifi-busy ? "Scanning…" : "Refresh"; on: true; clicked => { if !root.wifi-busy { root.scan-wifi(); } } }
                            }
                            Text {
                                text: root.wifi-scan-state == "" ? root.wifi-status : root.wifi-scan-state;
                                color: #8a8a8a;
                                font-size: 12px;
                                font-family: Dy.mono;
                                wrap: word-wrap;
                            }
                            for net in root.wifi-nets: Rectangle {
                                height: 52px;
                                border-width: 1.5px;
                                border-color: net.connected ? #ffffff : #2a2a2a;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    NetGlyph { kind: "wifi"; bars: net.bars; }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text { text: net.ssid + (net.connected ? "  · connected" : ""); color: #ffffff; font-size: 14px; font-family: Dy.mono; overflow: elide; }
                                        Text { text: net.security + (net.saved ? "  · saved" : ""); color: #6a6a6a; font-size: 11px; font-family: Dy.mono; overflow: elide; }
                                    }
                                    if !net.connected: Pill {
                                        label: "Join";
                                        on: true;
                                        clicked => { root.pick-wifi(net.ssid); root.connect-wifi(); }
                                    }
                                    if net.saved: Pill {
                                        label: "Forget";
                                        clicked => { root.ask-forget-wifi(net.ssid); }
                                    }
                                }
                            }
                            Pill { label: root.hidden-open ? "Hide hidden network" : "Join hidden network"; clicked => { root.hidden-open = !root.hidden-open; } }
                            if root.hidden-open: VerticalLayout {
                                spacing: 8px;
                                FieldTap { label: "Network name"; value: root.hidden-ssid; active: root.kb-field == "hidden-ssid"; label-size: 13px; value-size: 16px; tap-height: 56px; tapped => { root.open-keyboard("hidden-ssid"); } }
                                FieldTap { label: "Password"; value: root.wifi-pass == "" ? "" : "••••••••"; active: root.kb-field == "wifi-pass"; label-size: 13px; value-size: 16px; tap-height: 56px; tapped => { root.open-keyboard("wifi-pass"); } }
                                Pill { label: "Connect hidden"; on: true; clicked => { root.connect-hidden(); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Diagnostics"; color: #6a6a6a; font-size: 12px; font-family: Dy.mono; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Pill { label: "Run checks"; on: true; clicked => { root.run-diag(); } }
                            }
                            for d in root.diags: HorizontalLayout {
                                height: 28px;
                                Text { text: d.label; color: #ffffff; font-size: 13px; font-family: Dy.mono; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: d.state + (d.detail == "" ? "" : "  " + d.detail); color: #8a8a8a; font-size: 12px; font-family: Dy.mono; vertical-alignment: center; }
                            }
                        }
                    }
                    if root.settings-tab == 2: VerticalLayout {
                        alignment: start;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            PowerAction {
                                label: "Restart";
                                glyph: "↻";
                                enabled: !root.updating && !root.power-busy;
                                clicked => { if !root.updating && !root.power-busy { root.begin-confirm("restart"); } }
                            }
                            PowerAction {
                                label: "Sleep";
                                glyph: "z";
                                enabled: !root.updating && !root.power-busy;
                                clicked => { if !root.updating && !root.power-busy { root.begin-confirm("sleep"); } }
                            }
                            PowerAction {
                                label: "Shut Down";
                                glyph: "○";
                                enabled: !root.updating && !root.power-busy;
                                clicked => { if !root.updating && !root.power-busy { root.begin-confirm("shutdown"); } }
                            }
                            PowerAction {
                                label: "Uninstall";
                                glyph: "×";
                                enabled: !root.updating && !root.power-busy;
                                clicked => { if !root.updating && !root.power-busy { root.begin-confirm("uninstall1"); } }
                            }
                        }
                        if root.power-status != "": Text {
                            text: root.power-status;
                            color: #ffffff;
                            font-size: 14px;
                            font-family: Dy.mono;
                            wrap: word-wrap;
                        }
                        Rectangle { height: 1.5px; background: #2a2a2a; }
                        Text { text: "Software"; color: #6a6a6a; font-size: 12px; font-family: Dy.mono; }
                        HorizontalLayout {
                            Text { text: "Installed version"; color: #8a8a8a; font-size: 13px; font-family: Dy.mono; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: "v" + root.version-text; color: #ffffff; font-size: 16px; font-family: Dy.mono; vertical-alignment: center; }
                        }
                        if root.update-label != "": Text {
                            text: root.update-label;
                            color: #ffffff;
                            font-size: 14px;
                            font-family: Dy.mono;
                            wrap: word-wrap;
                        }
                        if root.refresh-status != "": Text {
                            text: root.refresh-status;
                            color: #8a8a8a;
                            font-size: 13px;
                            font-family: Dy.mono;
                            wrap: word-wrap;
                        }
                        Text { text: "Switch version"; color: #ffffff; font-size: 16px; font-family: Dy.mono; }
                        Rectangle {
                            height: 56px;
                            border-width: 1.5px;
                            border-color: (root.updating || root.power-busy) ? #2a2a2a : #ffffff;
                            background: #000000;
                            TouchArea {
                                clicked => {
                                    if !root.updating && !root.power-busy {
                                        root.version-menu-open = !root.version-menu-open;
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                Text {
                                    text: (root.selected-release == "" ? ("v" + root.version-text) : root.selected-release) + "  ▼";
                                    color: (root.updating || root.power-busy) ? #6a6a6a : #ffffff;
                                    font-size: 16px;
                                    font-family: Dy.mono;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        if root.version-menu-open && !root.updating && !root.power-busy: Flickable {
                            height: 180px;
                            viewport-height: 24 * 40px;
                            VerticalLayout {
                                spacing: 2px;
                                for rel in root.releases: TouchArea {
                                    clicked => { if !rel.current && !root.updating && !root.power-busy { root.pick-version(rel.tag); } }
                                    height: 40px;
                                    HorizontalLayout {
                                        Text { text: rel.tag; color: rel.current ? #ffffff : #8a8a8a; font-size: 15px; font-family: Dy.mono; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        if rel.current: Text { text: "current"; color: #6a6a6a; font-size: 12px; font-family: Dy.mono; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            height: 56px;
                            border-width: 1.5px;
                            border-color: (root.updating || root.power-busy) ? #2a2a2a : #ffffff;
                            background: #000000;
                            TouchArea {
                                clicked => { if !root.updating && !root.power-busy { root.check-updates(); } }
                            }
                            Text {
                                text: "Check for updates";
                                color: (root.updating || root.power-busy) ? #6a6a6a : #ffffff;
                                font-size: 16px;
                                font-weight: 700;
                                font-family: Dy.mono;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: root.release-status;
                            color: #8a8a8a;
                            font-size: 12px;
                            font-family: Dy.mono;
                            wrap: word-wrap;
                        }
                    }
                    if root.settings-tab == 3: VerticalLayout {
                        alignment: start;
                        spacing: 10px;
                        padding-bottom: 80px;
                        Text { text: "Screen"; color: #6a6a6a; font-size: Dy.type-control; font-family: Dy.mono; }
                        Text { text: "Turn my screen off after"; color: #ffffff; font-size: Dy.type-title; font-family: Dy.mono; }
                        TouchArea {
                            clicked => { root.screen-off-open = !root.screen-off-open; }
                            height: 48px;
                            Rectangle {
                                border-width: 1.5px;
                                border-color: #ffffff;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text { text: root.screen-off-label + "  ▼"; color: #ffffff; font-size: Dy.type-control; font-family: Dy.mono; vertical-alignment: center; }
                                }
                            }
                        }
                        if root.screen-off-open: VerticalLayout {
                            spacing: 2px;
                            TouchArea { height: 36px; clicked => { root.set-screen-off(60); } Text { text: "1 minute"; color: root.screen-off-secs == 60 ? #ffffff : #8a8a8a; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; } }
                            TouchArea { height: 36px; clicked => { root.set-screen-off(120); } Text { text: "2 minutes"; color: root.screen-off-secs == 120 ? #ffffff : #8a8a8a; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; } }
                            TouchArea { height: 36px; clicked => { root.set-screen-off(180); } Text { text: "3 minutes"; color: root.screen-off-secs == 180 ? #ffffff : #8a8a8a; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; } }
                            TouchArea { height: 36px; clicked => { root.set-screen-off(300); } Text { text: "5 minutes"; color: root.screen-off-secs == 300 ? #ffffff : #8a8a8a; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; } }
                            TouchArea { height: 36px; clicked => { root.set-screen-off(600); } Text { text: "10 minutes"; color: root.screen-off-secs == 600 ? #ffffff : #8a8a8a; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; } }
                            TouchArea { height: 36px; clicked => { root.set-screen-off(900); } Text { text: "15 minutes"; color: root.screen-off-secs == 900 ? #ffffff : #8a8a8a; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; } }
                            TouchArea { height: 36px; clicked => { root.set-screen-off(1200); } Text { text: "20 minutes"; color: root.screen-off-secs == 1200 ? #ffffff : #8a8a8a; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; } }
                            TouchArea { height: 36px; clicked => { root.set-screen-off(1500); } Text { text: "25 minutes"; color: root.screen-off-secs == 1500 ? #ffffff : #8a8a8a; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; } }
                            TouchArea { height: 36px; clicked => { root.set-screen-off(1800); } Text { text: "30 minutes"; color: root.screen-off-secs == 1800 ? #ffffff : #8a8a8a; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; } }
                            TouchArea { height: 36px; clicked => { root.set-screen-off(2700); } Text { text: "45 minutes"; color: root.screen-off-secs == 2700 ? #ffffff : #8a8a8a; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; } }
                            TouchArea { height: 36px; clicked => { root.set-screen-off(3600); } Text { text: "1 hour"; color: root.screen-off-secs == 3600 ? #ffffff : #8a8a8a; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; } }
                            TouchArea { height: 36px; clicked => { root.set-screen-off(7200); } Text { text: "2 hours"; color: root.screen-off-secs == 7200 ? #ffffff : #8a8a8a; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; } }
                            TouchArea { height: 36px; clicked => { root.set-screen-off(10800); } Text { text: "3 hours"; color: root.screen-off-secs == 10800 ? #ffffff : #8a8a8a; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; } }
                            TouchArea { height: 36px; clicked => { root.set-screen-off(14400); } Text { text: "4 hours"; color: root.screen-off-secs == 14400 ? #ffffff : #8a8a8a; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; } }
                            TouchArea { height: 36px; clicked => { root.set-screen-off(18000); } Text { text: "5 hours"; color: root.screen-off-secs == 18000 ? #ffffff : #8a8a8a; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; } }
                            TouchArea { height: 36px; clicked => { root.set-screen-off(0); } Text { text: "Never"; color: root.screen-off-secs == 0 ? #ffffff : #8a8a8a; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; } }
                        }
                        Text { text: "Display"; color: #6a6a6a; font-size: Dy.type-control; font-family: Dy.mono; }
                        Text { text: root.display-output + "  " + root.display-mode + "  @  " + root.display-rate + " Hz"; color: #ffffff; font-size: Dy.type-title; font-family: Dy.mono; wrap: word-wrap; }
                        Text { text: "Refresh rate"; color: #ffffff; font-size: Dy.type-title; font-family: Dy.mono; }
                        HorizontalLayout {
                            spacing: 8px;
                            Pill { label: "60"; on: root.display-rate == "60.00" || root.display-rate == "60"; clicked => { root.set-display-rate("60"); } }
                            Pill { label: "50"; on: root.display-rate == "50.00" || root.display-rate == "50"; clicked => { root.set-display-rate("50"); } }
                            Pill { label: "30"; on: root.display-rate == "30.00" || root.display-rate == "30"; clicked => { root.set-display-rate("30"); } }
                        }
                        Text { text: "Pixel size"; color: #ffffff; font-size: Dy.type-title; font-family: Dy.mono; }
                        HorizontalLayout {
                            spacing: 8px;
                            Pill { label: "Full"; on: root.display-scale == 100; clicked => { root.set-display-scale(100); } }
                            Pill { label: "Performance"; on: root.display-scale == 50; clicked => { root.set-display-scale(50); } }
                        }
                        Text { text: root.display-scale == 50 ? "Half pixels. Judie restarts so the layout still fills the screen." : "Native panel size."; color: #8a8a8a; font-size: Dy.type-dense; font-family: Dy.mono; wrap: word-wrap; }
                    }
                    if root.settings-tab == 4: VerticalLayout {
                        alignment: start;
                        spacing: 10px;
                        padding-bottom: 80px;
                        Text { text: "Display"; color: #6a6a6a; font-size: Dy.type-control; font-family: Dy.mono; }
                        HorizontalLayout {
                            Text { text: "Sidebar"; color: #ffffff; font-size: Dy.type-value; font-family: Dy.mono; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Toggle { on: root.sidebar; toggled => { root.toggle-sidebar(); } }
                        }
                        HorizontalLayout {
                            Text { text: "Blocky font"; color: #ffffff; font-size: Dy.type-value; font-family: Dy.mono; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Toggle { on: root.blocky-font; toggled => { root.toggle-blocky-font(); } }
                        }
                        HorizontalLayout {
                            Text { text: "Hide header clock"; color: #ffffff; font-size: Dy.type-value; font-family: Dy.mono; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Toggle { on: root.hide-header-clock; toggled => { root.toggle-hide-header-clock(); } }
                        }
                        HorizontalLayout {
                            Text { text: "Header separator"; color: #ffffff; font-size: Dy.type-value; font-family: Dy.mono; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Toggle { on: root.header-line; toggled => { root.toggle-header-line(); } }
                        }
                        Text { text: "Text scale"; color: #ffffff; font-size: Dy.type-control; font-family: Dy.mono; }
                        HorizontalLayout {
                            spacing: 10px;
                            Slider { minimum: 80; maximum: 200; value: root.text-scale; changed(v) => { root.set-text-scale(round(v)); } }
                            FieldTap { width: 88px; tap-height: 52px; label: "80–200"; value: "\{root.text-scale}"; active: root.kb-field == "text-scale"; tapped => { root.open-keyboard("text-scale"); } }
                        }
                        Text { text: "UI / padding scale"; color: #ffffff; font-size: Dy.type-control; font-family: Dy.mono; }
                        HorizontalLayout {
                            spacing: 10px;
                            Slider { minimum: 75; maximum: 150; value: root.ui-scale; changed(v) => { root.set-ui-scale(round(v)); } }
                            FieldTap { width: 88px; tap-height: 52px; label: "75–150"; value: "\{root.ui-scale}"; active: root.kb-field == "ui-scale"; tapped => { root.open-keyboard("ui-scale"); } }
                        }
                        Text { text: "Header height"; color: #ffffff; font-size: Dy.type-control; font-family: Dy.mono; }
                        HorizontalLayout {
                            spacing: 10px;
                            Slider { minimum: 88; maximum: 140; value: root.header-h-px; changed(v) => { root.set-header-h(round(v)); } }
                            FieldTap { width: 88px; tap-height: 52px; label: "88–140"; value: "\{root.header-h-px}"; active: root.kb-field == "header-h"; tapped => { root.open-keyboard("header-h"); } }
                        }
                        Text { text: "Hit-target size"; color: #ffffff; font-size: Dy.type-control; font-family: Dy.mono; }
                        HorizontalLayout {
                            spacing: 10px;
                            Slider { minimum: 48; maximum: 96; value: root.hit-target-px; changed(v) => { root.set-hit-target(round(v)); } }
                            FieldTap { width: 88px; tap-height: 52px; label: "48–96"; value: "\{root.hit-target-px}"; active: root.kb-field == "hit-target"; tapped => { root.open-keyboard("hit-target"); } }
                        }
                    }
                }
            }
        }
        if !root.settings-page: TouchArea {
            y: parent.height - 28px;
            width: 100%;
            height: 28px;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down {
                    if root.settings-open || root.settings-pull > 0.92 {
                        root.settings-armed = true;
                        root.settings-kind = 1;
                        root.settings-start = root.settings-pos(self.absolute-position.y, self.mouse-y);
                        root.settings-base = root.settings-pull;
                    }
                }
                if ev.kind == PointerEventKind.up {
                    root.settings-finish(false);
                }
                if ev.kind == PointerEventKind.cancel {
                    root.settings-finish(true);
                }
            }
            moved => {
                if self.pressed && (root.settings-tracking || root.settings-armed) && root.settings-kind == 1 {
                    if !root.settings-tracking && root.settings-start - root.settings-pos(self.absolute-position.y, self.mouse-y) > 18px {
                        root.settings-begin(1, root.settings-start);
                    }
                    if root.settings-tracking {
                        root.settings-follow(root.settings-pos(self.absolute-position.y, self.mouse-y));
                    }
                }
            }
        }
    }

    if root.net-menu-open: Rectangle {
        x: root.rail-w;
        width: parent.width - root.rail-w;
        background: #00000000;
        TouchArea { clicked => { root.close-net-menu(); } }
        Rectangle {
            x: parent.width - 360px;
            y: Dy.header-h - 8px;
            width: 340px;
            height: root.wifi-detail == "" ? min(parent.height / 2, 24px + max(1, root.wifi-nets.length) * 44px) : 220px;
            background: #000000;
            border-width: 1.5px;
            border-color: #2a2a2a;
            TouchArea { clicked => { } }
            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                if root.net-kind == "ethernet": Text {
                    text: "Ethernet";
                    color: #ffffff;
                    font-size: 14px;
                    font-family: Dy.mono;
                }
                if root.wifi-detail == "": Flickable {
                    vertical-stretch: 1;
                    viewport-height: max(1, root.wifi-nets.length) * 44px;
                    VerticalLayout {
                        spacing: 2px;
                        for net in root.wifi-nets: TouchArea {
                            clicked => { root.pick-wifi(net.ssid); }
                            height: 42px;
                            HorizontalLayout {
                                spacing: 8px;
                                NetGlyph { kind: "wifi"; bars: net.bars; }
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: net.ssid; color: #ffffff; font-size: 14px; font-family: Dy.mono; overflow: elide; }
                                    Text { text: net.connected ? "Connected" : (net.saved ? "Saved" : "Available"); color: #6a6a6a; font-size: 11px; font-family: Dy.mono; }
                                }
                            }
                        }
                    }
                }
                if root.wifi-detail != "": VerticalLayout {
                    spacing: 6px;
                    TouchArea {
                        clicked => { root.wifi-detail = ""; }
                        Text { text: "←  Networks"; color: #8a8a8a; font-size: 13px; font-family: Dy.mono; }
                    }
                    Text { text: root.wifi-pick; color: #ffffff; font-size: 16px; font-family: Dy.mono; }
                    Text { text: root.wifi-pick == root.wifi-ssid ? "Connected" : "Available"; color: #6a6a6a; font-size: 12px; font-family: Dy.mono; }
                    if root.wifi-pick == root.wifi-ssid: Pill { label: "Disconnect"; clicked => { root.disconnect-wifi(); } }
                    if root.wifi-pick != root.wifi-ssid: VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            Text { text: "Auto-connect"; color: #ffffff; font-size: 13px; font-family: Dy.mono; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Toggle { on: root.wifi-auto; toggled => { root.toggle-wifi-auto(); } }
                        }
                        Pill { label: "Connect"; on: true; clicked => { root.connect-wifi(); } }
                    }
                    Text { text: root.wifi-status; color: #8a8a8a; font-size: 12px; font-family: Dy.mono; wrap: word-wrap; }
                }
            }
        }
    }

    if root.vol-menu-open: Rectangle {
        x: root.rail-w;
        width: parent.width - root.rail-w;
        background: #00000000;
        TouchArea { clicked => { root.close-vol-menu(); } }
        Rectangle {
            x: parent.width - Dy.hit-target * 2 - 280px;
            y: Dy.header-h - 8px;
            width: 260px;
            height: 88px;
            background: #000000;
            border-width: 1.5px;
            border-color: #2a2a2a;
            TouchArea { clicked => { } }
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text { text: "Volume  " + root.volume + "%"; color: #ffffff; font-size: 14px; font-family: Dy.mono; }
                Slider { minimum: 0; maximum: 100; value: root.volume; changed(v) => { root.volume-changed(round(v)); } }
            }
        }
    }

    if root.confirm-kind == "restart" || root.confirm-kind == "sleep" || root.confirm-kind == "shutdown" || root.confirm-kind == "uninstall1" || root.confirm-kind == "downgrade" || root.confirm-kind == "upgrade" || root.confirm-kind == "forget-wifi": ConfirmSheet {
        x: root.rail-w;
        width: parent.width - root.rail-w;
        title: root.confirm-title;
        body: root.confirm-body;
        primary: root.confirm-kind == "forget-wifi" ? "Forget" : "Continue";
        secondary: "Cancel";
        accept => { root.accept-confirm(); }
        dismiss => { root.cancel-confirm(); }
    }

    if root.confirm-kind == "uninstall2": Rectangle {
        x: root.rail-w;
        width: parent.width - root.rail-w;
        background: #000000cc;
        TouchArea { clicked => { root.cancel-confirm(); } }
        Rectangle {
            x: parent.width * 0.22; y: parent.height * 0.28; width: parent.width * 0.56; height: 300px;
            background: #000000; border-width: 1.5px; border-color: #2a2a2a;
            TouchArea { clicked => { } }
            VerticalLayout {
                padding: 28px; spacing: 16px;
                Text { text: root.math-prompt; color: #ffffff; font-size: 28px; font-weight: 700; font-family: Dy.mono; horizontal-alignment: center; }
                FieldTap { label: "Answer"; value: root.math-typed; active: root.kb-field == "math"; tapped => { root.open-keyboard("math"); } }
                HorizontalLayout {
                    spacing: 12px;
                    Pill { label: "Cancel"; clicked => { root.cancel-confirm(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Pill { label: "Continue"; on: true; clicked => { root.accept-confirm(); } }
                }
            }
        }
    }

    if root.confirm-kind == "uninstall3": Rectangle {
        x: root.rail-w;
        width: parent.width - root.rail-w;
        background: #000000cc;
        TouchArea { clicked => { root.cancel-confirm(); } }
        Rectangle {
            x: parent.width * 0.18; y: parent.height * 0.24; width: parent.width * 0.64; height: 320px;
            background: #000000; border-width: 1.5px; border-color: #2a2a2a;
            TouchArea { clicked => { } }
            VerticalLayout {
                padding: 28px; spacing: 16px;
                Text { text: "Type this exactly"; color: #6a6a6a; font-size: 13px; font-family: Dy.mono; }
                Text { text: root.verify-code; color: #ffffff; font-size: 22px; font-weight: 700; font-family: Dy.mono; horizontal-alignment: center; }
                FieldTap { label: "Verification"; value: root.verify-typed; active: root.kb-field == "verify"; tapped => { root.open-keyboard("verify"); } }
                HorizontalLayout {
                    spacing: 12px;
                    Pill { label: "Cancel"; clicked => { root.cancel-confirm(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Pill { label: "Uninstall"; on: true; clicked => { root.accept-confirm(); } }
                }
            }
        }
    }

    if root.gallery-open: Rectangle {
        x: root.rail-w;
        width: parent.width - root.rail-w;
        background: #000000cc;
        TouchArea { clicked => { root.close-gallery(); } }
        Rectangle {
            x: (parent.width - min(760px, parent.width - 40px)) / 2;
            y: (parent.height - 540px) / 2;
            width: 760px;
            height: 540px;
            border-radius: 0px;
            background: #000000;
            border-width: 1px;
            border-color: #3d3d3d;
            TouchArea { clicked => { } }
            gallery-keys := FocusScope {
                x: 0px;
                y: 0px;
                width: 0px;
                height: 0px;
                key-pressed(event) => {
                    if root.kb-open {
                        return reject;
                    }
                    if event.text == Key.LeftArrow {
                        if root.gallery-index > 0 {
                            root.gallery-index -= 1;
                            root.gallery-set-index(root.gallery-index);
                        }
                        return accept;
                    }
                    if event.text == Key.RightArrow {
                        if root.gallery-index < ((root.gallery-kind == "clock" || root.gallery-kind == "pong") ? 1 : 2) {
                            root.gallery-index += 1;
                            root.gallery-set-index(root.gallery-index);
                        }
                        return accept;
                    }
                    if event.text == Key.Return {
                        root.gallery-add();
                        return accept;
                    }
                    if event.text == Key.Escape {
                        root.close-gallery();
                        return accept;
                    }
                    return reject;
                }
            }
            HorizontalLayout {
                padding: 16px;
                spacing: 16px;
                VerticalLayout {
                    width: 240px;
                    spacing: 8px;
                    Text { text: "ADD WIDGET"; color: #e6e6e6; font-size: 16px; font-weight: 700; font-family: Dy.mono; }
                    FieldTap { label: "Search"; value: root.gallery-query; active: root.kb-field == "gallery-query"; tapped => { root.open-keyboard("gallery-query"); } }
                    TouchArea {
                        height: 32px;
                        clicked => { root.open-creator(); }
                        Text { text: "Creator"; color: #e6e6e6; font-size: 12px; font-family: Dy.mono; vertical-alignment: center; }
                    }
                    TouchArea {
                        height: 32px;
                        clicked => { root.gallery-import(); }
                        Text { text: "Import"; color: #e6e6e6; font-size: 12px; font-family: Dy.mono; vertical-alignment: center; }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        viewport-height: 24 * 36px;
                        VerticalLayout {
                            spacing: 4px;
                            for item in root.gallery-items: TouchArea {
                                clicked => {
                                    root.gallery-index = 0;
                                    root.gallery-set-index(0);
                                    if item.custom { root.gallery-pick-custom(item.id); } else { root.gallery-pick(item.kind); }
                                }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 0px;
                                    border-width: 1px;
                                    border-color: (item.custom ? item.id == root.gallery-custom-id : root.gallery-kind == item.kind) ? #ffffff : #2a2a2a;
                                    background: #000000;
                                    Text { text: item.label; color: #e6e6e6; font-size: 12px; font-family: Dy.mono; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 10px;
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: root.gallery-desc == "" ? root.gallery-kind : root.gallery-desc;
                        color: #e6e6e6;
                        font-size: 16px;
                        font-weight: 700;
                        font-family: Dy.mono;
                    }
                    stage := Rectangle {
                        width: 240px;
                        height: 240px;
                        clip: true;
                        background: #000000;
                        border-width: 1px;
                        border-color: #2a2a2a;
                        TouchArea {
                            pointer-event(ev) => {
                                if ev.kind == PointerEventKind.down {
                                    root.gallery-swiping = true;
                                    root.gallery-press-x = self.mouse-x;
                                    root.gallery-ease = 0ms;
                                }
                                if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                                    root.gallery-swiping = false;
                                    root.gallery-ease = 220ms;
                                    if root.gallery-swipe < -48px && root.gallery-index < ((root.gallery-kind == "clock" || root.gallery-kind == "pong") ? 1 : 2) {
                                        root.gallery-index += 1;
                                    }
                                    if root.gallery-swipe > 48px && root.gallery-index > 0 {
                                        root.gallery-index -= 1;
                                    }
                                    root.gallery-swipe = 0px;
                                    root.gallery-set-index(root.gallery-index);
                                }
                            }
                            moved => {
                                if self.pressed {
                                    root.gallery-swipe = self.mouse-x - root.gallery-press-x;
                                }
                            }
                        }
                        HorizontalLayout {
                            x: -root.gallery-index * 240px + root.gallery-swipe;
                            width: 720px;
                            height: 240px;
                            spacing: 0;
                            Rectangle {
                                width: 240px;
                                height: 240px;
                                WidgetPreview {
                                    x: (240px - self.width) / 2;
                                    y: (240px - self.height) / 2;
                                    kind: root.gallery-custom ? "custom" : root.gallery-kind;
                                    size: "1x1";
                                    preview-scale: 0.5;
                                    sample: true;
                                    source: root.preview-source;
                                    widget-id: root.gallery-custom-id;
                                    slop-nodes: root.gallery-nodes;
                                    use-layout: root.gallery-use-layout && !root.gallery-custom;
                                }
                            }
                            Rectangle {
                                width: 240px;
                                height: 240px;
                                WidgetPreview {
                                    x: (240px - self.width) / 2;
                                    y: (240px - self.height) / 2;
                                    kind: root.gallery-custom ? "custom" : root.gallery-kind;
                                    size: (root.gallery-kind == "clock" || root.gallery-kind == "pong") ? "2x2" : "1x2";
                                    preview-scale: 0.5;
                                    sample: true;
                                    source: root.preview-source;
                                    widget-id: root.gallery-custom-id;
                                    slop-nodes: root.gallery-nodes;
                                    use-layout: root.gallery-use-layout && !root.gallery-custom;
                                }
                            }
                            Rectangle {
                                width: 240px;
                                height: 240px;
                                WidgetPreview {
                                    kind: root.gallery-custom ? "custom" : root.gallery-kind;
                                    size: "2x2";
                                    preview-scale: 0.5;
                                    sample: true;
                                    source: root.preview-source;
                                    widget-id: root.gallery-custom-id;
                                    slop-nodes: root.gallery-nodes;
                                    use-layout: root.gallery-use-layout && !root.gallery-custom;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        height: 28px;
                        TouchArea {
                            width: 28px;
                            height: 28px;
                            clicked => { root.gallery-index = 0; root.gallery-set-index(0); }
                            Rectangle { x: 10px; y: 10px; width: 8px; height: 8px; border-radius: 0px; background: root.gallery-index == 0 ? #ffffff : #8a8a8a; }
                        }
                        TouchArea {
                            width: 28px;
                            height: 28px;
                            clicked => { root.gallery-index = 1; root.gallery-set-index(1); }
                            Rectangle { x: 10px; y: 10px; width: 8px; height: 8px; border-radius: 0px; background: root.gallery-index == 1 ? #ffffff : #8a8a8a; }
                        }
                        if root.gallery-kind != "clock" && root.gallery-kind != "pong": TouchArea {
                            width: 28px;
                            height: 28px;
                            clicked => { root.gallery-index = 2; root.gallery-set-index(2); }
                            Rectangle { x: 10px; y: 10px; width: 8px; height: 8px; border-radius: 0px; background: root.gallery-index == 2 ? #ffffff : #8a8a8a; }
                        }
                    }
                    Text {
                        text: root.gallery-size-caption;
                        color: #8a8a8a;
                        font-size: 12px;
                        font-family: Dy.mono;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Border"; color: #ffffff; font-size: Dy.type-title; font-family: Dy.mono; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Toggle { on: root.gallery-border; toggled => { root.set-gallery-border(!root.gallery-border); } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Pill { label: "Cancel"; clicked => { root.close-gallery(); } }
                        Rectangle { horizontal-stretch: 1; }
                        Pill { label: "Add Widget"; on: true; clicked => { root.gallery-add(); } }
                    }
                }
            }
        }
    }

    if root.creator-open: Rectangle {
        x: root.rail-w;
        width: parent.width - root.rail-w;
        background: #000000cc;
        TouchArea { clicked => { root.close-creator(); } }
        Rectangle {
            x: parent.width * 0.04;
            y: 24px;
            width: parent.width * 0.92;
            height: parent.height - 48px;
            border-radius: 0px;
            background: #000000;
            border-width: 1.5px;
            border-color: #2a2a2a;
            TouchArea { clicked => { } }
            VerticalLayout {
                padding: 20px;
                spacing: 14px;
                HorizontalLayout {
                    Text { text: "Widget"; color: #ffffff; font-size: 18px; font-weight: 700; font-family: Dy.mono; }
                    Rectangle { horizontal-stretch: 1; }
                    Pill { label: "Save"; on: true; clicked => { root.save-creator(); } }
                    Pill { label: "Close"; clicked => { root.close-creator(); } }
                }
                FieldTap { label: "Name"; value: root.creator-name; active: root.kb-field == "creator-name"; tapped => { root.open-keyboard("creator-name"); } }
                Text { text: "Size"; color: #6a6a6a; font-size: 12px; font-family: Dy.mono; }
                HorizontalLayout {
                    spacing: 8px;
                    Pill { label: "Small"; on: root.creator-size == "1x1"; clicked => { root.set-creator-size("1x1"); } }
                    Pill { label: "Medium"; on: root.creator-size == "1x2"; clicked => { root.set-creator-size("1x2"); } }
                    Pill { label: "Large"; on: root.creator-size == "2x2"; clicked => { root.set-creator-size("2x2"); } }
                }
                Text { text: "Starting layout"; color: #6a6a6a; font-size: 12px; font-family: Dy.mono; }
                HorizontalLayout {
                    spacing: 8px;
                    Pill { label: "Blank"; on: root.creator-template == "blank"; clicked => { root.set-creator-template("blank"); } }
                    Pill { label: "Number"; on: root.creator-template == "stat"; clicked => { root.set-creator-template("stat"); } }
                    Pill { label: "Status"; on: root.creator-template == "status"; clicked => { root.set-creator-template("status"); } }
                    Pill { label: "Controls"; on: root.creator-template == "controls"; clicked => { root.set-creator-template("controls"); } }
                    Pill { label: "List"; on: root.creator-template == "list"; clicked => { root.set-creator-template("list"); } }
                }
                HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        width: 160px;
                        spacing: 6px;
                        Text { text: "Parts"; color: #6a6a6a; font-size: 12px; font-family: Dy.mono; }
                        for k in root.part-kinds: TouchArea {
                            clicked => { root.add-creator-kind(k.id); }
                            height: 36px;
                            Text { text: k.label; color: #ffffff; font-size: 13px; font-family: Dy.mono; vertical-alignment: center; }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #000000;
                        border-width: 1.5px;
                        border-color: #2a2a2a;
                        DesignerStage {
                            x: max(0px, (parent.width - self.width) / 2);
                            y: max(0px, (parent.height - self.height) / 2);
                            size: root.creator-size;
                            kind: "custom";
                            nodes: root.creator-nodes;
                            selected: root.creator-selected;
                            sample: true;
                            select-node(id) => { root.select-creator-node(id); }
                            patch-node(id, x, y, w, h) => { root.creator-patch-node(id, x, y, w, h); }
                        }
                    }
                    VerticalLayout {
                        width: 240px;
                        spacing: 10px;
                        Text { text: "Selected"; color: #6a6a6a; font-size: 12px; font-family: Dy.mono; }
                        Text { text: root.creator-selected == "" ? "Tap a part" : root.creator-selected-kind; color: #ffffff; font-size: 14px; font-family: Dy.mono; overflow: elide; }
                        FieldTap { label: "Text"; value: root.creator-node-text; active: root.kb-field == "creator-node"; tapped => { root.open-keyboard("creator-node"); } }
                        Pill { label: "Remove part"; clicked => { root.delete-creator-node(); } }
                    }
                }
            }
        }
    }

    if root.expanded == "weather": Rectangle {
        x: root.rail-w;
        y: Dy.header-h;
        width: parent.width - root.rail-w;
        height: parent.height - Dy.header-h;
        background: #000000;
        Rectangle {
            width: 100%; height: 100%;
            border-radius: 0px; background: #000000;
            border-width: 1px; border-color: #3d3d3d;
            VerticalLayout {
                padding: 12px; spacing: 8px;
                HorizontalLayout {
                    Text { text: root.weather-loc; color: #e6e6e6; font-size: 22px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text { text: root.weather-temp + "  " + root.weather-cond; color: #e6e6e6; font-size: 42px; font-weight: 700; }
                Text { text: root.weather-range + "  ·  " + root.weather-feel; color: #7a7a7a; font-size: 16px; }
                Text { text: root.weather-note; color: #e6e6e6; font-size: 16px; }
                HorizontalLayout {
                    spacing: 16px;
                    for h in root.hours: VerticalLayout {
                        spacing: 4px;
                        Text { text: h.hour; color: #555555; font-size: 12px; horizontal-alignment: center; }
                        Text { text: h.temp; color: #e6e6e6; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: h.precip; color: #7a7a7a; font-size: 12px; horizontal-alignment: center; }
                    }
                }
            }
        }
    }

    if root.expanded == "lights": Rectangle {
        x: root.rail-w;
        y: Dy.header-h;
        width: parent.width - root.rail-w;
        height: parent.height - Dy.header-h;
        background: #000000;
        Rectangle {
            width: 100%; height: 100%;
            border-radius: 0px; background: #000000;
            border-width: 1px; border-color: #3d3d3d;
            VerticalLayout {
                padding: 12px; spacing: 10px;
                HorizontalLayout {
                    Text { text: "LIGHTS"; color: #e6e6e6; font-size: 18px; font-weight: 700; font-family: Dy.mono; }
                    Rectangle { horizontal-stretch: 1; }
                    Toggle { on: root.master-on; toggled => { root.toggle-master(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Pill { label: "Cozy"; on: root.scene == "Cozy"; clicked => { root.set-scene("Cozy"); } }
                    Pill { label: "Movie"; on: root.scene == "Movie"; clicked => { root.set-scene("Movie"); } }
                    Pill { label: "Night"; on: root.scene == "Night"; clicked => { root.set-scene("Night"); } }
                    Pill { label: "Bright"; on: root.scene == "Bright"; clicked => { root.set-scene("Bright"); } }
                    Pill { label: "Gaming"; on: root.scene == "Gaming"; clicked => { root.set-scene("Gaming"); } }
                }
                Text { text: root.brightness + "%"; color: #e6e6e6; font-size: 28px; font-weight: 700; }
                Slider { minimum: 0; maximum: 100; value: root.brightness; changed(v) => { root.brightness-changed(round(v)); } }
                HorizontalLayout {
                    spacing: 8px;
                    Swatch { swatch: #ff5a5a; on: root.master-color == "#FF5A5A"; clicked => { root.set-color("#FF5A5A"); } }
                    Swatch { swatch: #ff8c42; on: root.master-color == "#FF8C42"; clicked => { root.set-color("#FF8C42"); } }
                    Swatch { swatch: #ffd166; on: root.master-color == "#FFD166"; clicked => { root.set-color("#FFD166"); } }
                    Swatch { swatch: #7cf29c; on: root.master-color == "#7CF29C"; clicked => { root.set-color("#7CF29C"); } }
                    Swatch { swatch: #5ce1ff; on: root.master-color == "#2D7BFF"; clicked => { root.set-color("#2D7BFF"); } }
                    Swatch { swatch: #7b61ff; on: root.master-color == "#7B61FF"; clicked => { root.set-color("#7B61FF"); } }
                    Swatch { swatch: #ff6bcb; on: root.master-color == "#FF6BCB"; clicked => { root.set-color("#FF6BCB"); } }
                    Swatch { swatch: #ffffff; on: root.master-color == "#FFFFFF"; clicked => { root.set-color("#FFFFFF"); } }
                }
                for light in root.lights: HorizontalLayout {
                    Text { text: light.name; color: #e6e6e6; font-size: 16px; vertical-alignment: center; }
                    Text { text: light.brightness; color: #7a7a7a; font-size: 14px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Pill { label: light.on ? "On" : "Off"; on: light.on; clicked => { root.toggle-light(light.id); } }
                }
            }
        }
    }

    if root.expanded == "media": Rectangle {
        x: root.rail-w;
        y: Dy.header-h;
        width: parent.width - root.rail-w;
        height: parent.height - Dy.header-h;
        background: #000000;
        Rectangle {
            width: 100%; height: 100%;
            border-radius: 0px; background: #000000;
            border-width: 1px; border-color: #3d3d3d;
            VerticalLayout {
                padding: 12px; spacing: 10px;
                HorizontalLayout {
                    Text { text: "NOW PLAYING"; color: #e6e6e6; font-size: 18px; font-weight: 700; font-family: Dy.mono; }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text { text: root.track-title; color: #e6e6e6; font-size: 32px; font-weight: 700; }
                Text { text: root.track-artist; color: #7a7a7a; font-size: 16px; }
                Bar { level: root.media-progress; fill: #e6e6e6; }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;
                    IconBtn { glyph: "⟨"; clicked => { root.prev-track(); } }
                    IconBtn { glyph: root.playing ? "❚❚" : "▶"; primary: true; clicked => { root.toggle-play(); } }
                    IconBtn { glyph: "⟩"; clicked => { root.next-track(); } }
                }
                Text { text: "Volume " + root.volume + "%"; color: #7a7a7a; font-size: 13px; }
                Slider { minimum: 0; maximum: 100; value: root.volume; changed(v) => { root.volume-changed(round(v)); } }
            }
        }
    }

    if root.expanded == "calendar": Rectangle {
        x: root.rail-w;
        y: Dy.header-h;
        width: parent.width - root.rail-w;
        height: parent.height - Dy.header-h;
        background: #000000;
        Rectangle {
            width: 100%; height: 100%;
            border-radius: 0px; background: #000000;
            border-width: 1px; border-color: #3d3d3d;
            VerticalLayout {
                padding: 12px; spacing: 8px;
                HorizontalLayout {
                    Text { text: root.month-name; color: #e6e6e6; font-size: 22px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; }
                }
                for ev in root.events: HorizontalLayout {
                    spacing: 12px;
                    Text { text: ev.time; color: #7a7a7a; font-size: 14px; min-width: 64px; }
                    VerticalLayout {
                        Text { text: ev.title; color: #e6e6e6; font-size: 16px; font-weight: 600; }
                        Text { text: ev.detail; color: #7a7a7a; font-size: 12px; }
                    }
                }
            }
        }
    }

    if root.expanded == "purifier": Rectangle {
        x: root.rail-w;
        y: Dy.header-h;
        width: parent.width - root.rail-w;
        height: parent.height - Dy.header-h;
        background: #000000;
        Rectangle {
            width: 100%; height: 100%;
            border-radius: 0px; background: #000000;
            border-width: 1px; border-color: #3d3d3d;
            VerticalLayout {
                padding: 12px; spacing: 10px;
                HorizontalLayout {
                    Text { text: "AIR PURIFIER"; color: #e6e6e6; font-size: 18px; font-weight: 700; font-family: Dy.mono; }
                    Rectangle { horizontal-stretch: 1; }
                    Toggle { on: root.purifier-on; toggled => { root.toggle-purifier(); } }
                }
                Text { text: root.purifier-aq; color: #ffffff; font-size: 36px; font-weight: 700; }
                Text { text: "PM2.5  7 µg/m³   ·   Allergens  4/12"; color: #e6e6e6; font-size: 16px; }
                HorizontalLayout {
                    spacing: 8px;
                    Pill { label: "Auto"; on: root.purifier-mode == "Auto"; clicked => { root.set-purifier-mode("Auto"); } }
                    Pill { label: "Sleep"; on: root.purifier-mode == "Sleep"; clicked => { root.set-purifier-mode("Sleep"); } }
                    Pill { label: "Boost"; on: root.purifier-mode == "Manual"; clicked => { root.set-purifier-mode("Manual"); } }
                }
                Text { text: "Filter " + root.purifier-filter + "%"; color: #7a7a7a; font-size: 14px; }
                Bar { level: root.purifier-filter / 100; fill: #ffffff; }
            }
        }
    }

    if root.expanded == "terminal": Rectangle {
        x: root.rail-w;
        y: Dy.header-h;
        width: parent.width - root.rail-w;
        height: parent.height - Dy.header-h;
        background: #000000;
        Rectangle {
            width: 100%; height: 100%;
            border-radius: 0px; background: #000000;
            border-width: 1px; border-color: #3d3d3d;
            VerticalLayout {
                padding: 12px; spacing: 10px;
                HorizontalLayout {
                    Text { text: "SHELL"; color: #e6e6e6; font-size: 18px; font-weight: 700; font-family: Dy.mono; }
                    Text { text: root.terminal-cwd; color: #7a7a7a; font-size: 14px; font-family: Dy.mono; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                Flickable {
                    vertical-stretch: 1;
                    viewport-height: max(parent.height - 180px, root.terminal-lines.length * 28px);
                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;
                        if root.terminal-lines.length == 0: Text {
                            text: "Run normal Linux commands here — ls, df -h, systemctl status…";
                            color: #7a7a7a;
                            font-size: 14px;
                            font-family: Dy.mono;
                            wrap: word-wrap;
                        }
                        for line in root.terminal-lines: Text {
                            text: line.text;
                            color: line.prompt ? #8a8a8a : #e6e6e6;
                            font-size: 15px;
                            font-family: Dy.mono;
                            wrap: word-wrap;
                        }
                    }
                }
                FieldTap {
                    label: "COMMAND";
                    value: root.terminal-input;
                    active: root.kb-open && root.kb-field == "terminal";
                    label-size: 13px;
                    value-size: 18px;
                    tap-height: 64px;
                    tapped => { root.open-keyboard("terminal"); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Pill { label: "RUN"; on: true; clicked => { root.submit-terminal(); } }
                }
            }
        }
    }

    if root.expanded == "climate": Rectangle {
        x: root.rail-w;
        y: Dy.header-h;
        width: parent.width - root.rail-w;
        height: parent.height - Dy.header-h;
        background: #000000;
        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            Text { text: "CLIMATE"; color: #e6e6e6; font-size: 18px; font-weight: 700; font-family: Dy.mono; }
            Text { text: root.indoor; color: #ffffff; font-size: 64px; font-weight: 700; font-family: Dy.mono; }
            Text { text: "Indoor now"; color: #8a8a8a; font-size: 16px; font-family: Dy.mono; }
            Text { text: "Humidity  " + root.humidity; color: #ffffff; font-size: 28px; font-family: Dy.mono; }
            Text { text: "Outdoor  " + root.outdoor; color: #ffffff; font-size: 28px; font-family: Dy.mono; }
            Text { text: root.comfort; color: #8a8a8a; font-size: 16px; font-family: Dy.mono; }
        }
    }

    if root.expanded == "pong": Rectangle {
        x: root.rail-w;
        y: Dy.header-h;
        width: parent.width - root.rail-w;
        height: parent.height - Dy.header-h;
        background: #000000;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                Text { text: root.pong-ls; color: #ffffff; font-size: 32px; font-weight: 700; font-family: Dy.mono; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "PONG"; color: #8a8a8a; font-size: 16px; font-family: Dy.mono; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.pong-rs; color: #ffffff; font-size: 32px; font-weight: 700; font-family: Dy.mono; }
            }
            HorizontalLayout {
                spacing: 8px;
                Pill { label: "Easy"; on: root.pong-mode == 0; clicked => { root.set-pong-mode(0); } }
                Pill { label: "Medium"; on: root.pong-mode == 1; clicked => { root.set-pong-mode(1); } }
                Pill { label: "Hard"; on: root.pong-mode == 2; clicked => { root.set-pong-mode(2); } }
                Pill { label: "2P"; on: root.pong-mode == 3; clicked => { root.set-pong-mode(3); } }
                Rectangle { horizontal-stretch: 1; }
                Pill { label: root.pong-running ? "RESET" : "START"; on: true; clicked => { root.pong-start(); } }
            }
            pong-keys := FocusScope {
                height: 0px;
                key-pressed(event) => {
                    if event.text == "w" || event.text == "W" { root.pong-nudge(0, -0.05); return accept; }
                    if event.text == "s" || event.text == "S" { root.pong-nudge(0, 0.05); return accept; }
                    if event.text == Key.UpArrow { root.pong-nudge(1, -0.05); return accept; }
                    if event.text == Key.DownArrow { root.pong-nudge(1, 0.05); return accept; }
                    return reject;
                }
            }
            court := TouchArea {
                vertical-stretch: 1;
                moved => {
                    if self.pressed {
                        if self.mouse-x < self.width / 2 {
                            root.pong-move(0, self.mouse-y / self.height);
                        } else {
                            root.pong-move(1, self.mouse-y / self.height);
                        }
                    }
                }
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.down {
                        if self.mouse-x < self.width / 2 {
                            root.pong-move(0, self.mouse-y / self.height);
                        } else if root.pong-mode == 3 {
                            root.pong-move(1, self.mouse-y / self.height);
                        }
                    }
                }
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #000000;
                    clip: true;
                    Rectangle { x: parent.width / 2 - 1px; width: 2px; height: 100%; background: #2a2a2a; }
                    Rectangle {
                        x: 12px;
                        y: parent.height * root.pong-ly / 100.0 - 48px;
                        width: 12px;
                        height: 96px;
                        background: #ffffff;
                    }
                    Rectangle {
                        x: parent.width - 24px;
                        y: parent.height * root.pong-ry / 100.0 - 48px;
                        width: 12px;
                        height: 96px;
                        background: #ffffff;
                    }
                    Rectangle {
                        x: parent.width * root.pong-bx / 100.0 - 10px;
                        y: parent.height * root.pong-by / 100.0 - 10px;
                        width: 20px;
                        height: 20px;
                        background: #ffffff;
                    }
                }
            }
        }
    }

    if root.expanded != "" && !root.settings-page: TouchArea {
        x: root.rail-w;
        y: parent.height - 28px;
        width: parent.width - root.rail-w;
        height: 28px;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down {
                root.expand-drag = self.mouse-y;
            }
            if ev.kind == PointerEventKind.up && self.mouse-y - root.expand-drag < -18px {
                root.collapse();
            }
        }
        Rectangle {
            y: 8px;
            height: 4px;
            HorizontalLayout {
                alignment: center;
                Rectangle { width: 48px; height: 4px; background: #3a3a3a; }
            }
        }
    }

    if root.updating: Rectangle {
        background: #00000099;
        TouchArea { clicked => { } }
        Rectangle {
            x: parent.width * 0.22;
            y: parent.height * 0.30;
            width: parent.width * 0.56;
            height: 240px;
            background: #000000;
            border-width: 1.5px;
            border-color: #ffffff;
            TouchArea { clicked => { } }
            VerticalLayout {
                padding: 28px;
                spacing: 16px;
                Text {
                    text: "Installing Judie";
                    color: #ffffff;
                    font-size: 20px;
                    font-weight: 700;
                    font-family: Dy.mono;
                }
                Text {
                    text: root.release-status;
                    color: #ffffff;
                    font-size: 16px;
                    font-family: Dy.mono;
                }
                Text {
                    text: "Downloading, validating, installing, verifying, then reboot. This screen stays up. Settings, widgets, and routines are kept.";
                    color: #8a8a8a;
                    font-size: 13px;
                    font-family: Dy.mono;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
            }
        }
    }

    if root.power-busy: Rectangle {
        background: #00000099;
        TouchArea { clicked => { } }
        Rectangle {
            x: parent.width * 0.22;
            y: parent.height * 0.32;
            width: parent.width * 0.56;
            height: 200px;
            background: #000000;
            border-width: 1.5px;
            border-color: #ffffff;
            TouchArea { clicked => { } }
            VerticalLayout {
                padding: 28px;
                spacing: 16px;
                Text {
                    text: "Device";
                    color: #ffffff;
                    font-size: 20px;
                    font-weight: 700;
                    font-family: Dy.mono;
                }
                Text {
                    text: root.power-status;
                    color: #ffffff;
                    font-size: 16px;
                    font-family: Dy.mono;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                Text {
                    text: "This screen stays up. A blank terminal never appears.";
                    color: #8a8a8a;
                    font-size: 13px;
                    font-family: Dy.mono;
                    wrap: word-wrap;
                }
            }
        }
    }

    if root.sidebar: Rectangle {
        x: 0px;
        width: root.rail-w;
        height: 100%;
        background: #000000;
        Rectangle {
            x: parent.width - 1.5px;
            width: 1.5px;
            height: 100%;
            background: #ffffff;
        }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 0;
            HorizontalLayout {
                spacing: 12px;
                height: 56px;
                alignment: center;
                PiMark { }
                Text {
                    text: "PANEL";
                    color: #ffffff;
                    font-size: Dy.type-hero;
                    font-weight: 700;
                    font-family: Dy.mono;
                    vertical-alignment: center;
                }
            }
            Rectangle { height: 1px; background: #ffffff; opacity: 0.35; }
            Rectangle { height: 18px; }
            Flickable {
                vertical-stretch: 1;
                viewport-height: 10 * 76px;
                VerticalLayout {
                    spacing: 4px;
                    TouchArea {
                        clicked => { root.collapse(); root.close-overlay(); }
                        height: 72px;
                        Rectangle {
                            background: (root.expanded == "" && !root.settings-page) ? #ffffff : #000000;
                            HorizontalLayout {
                                padding-left: 12px;
                                spacing: 12px;
                                Text { text: "⌂"; color: (root.expanded == "" && !root.settings-page) ? #000000 : #c8c8c8; font-size: Dy.type-value; vertical-alignment: center; }
                                Text { text: "HOME"; color: (root.expanded == "" && !root.settings-page) ? #000000 : #c8c8c8; font-size: Dy.type-value; font-family: Dy.mono; vertical-alignment: center; letter-spacing: 2px; }
                            }
                        }
                    }
                    TouchArea {
                        clicked => { root.expand("lights"); }
                        height: 72px;
                        Rectangle {
                            background: root.expanded == "lights" ? #ffffff : #000000;
                            HorizontalLayout {
                                padding-left: 12px; spacing: 12px;
                                Text { text: "💡"; color: root.expanded == "lights" ? #000000 : #c8c8c8; font-size: Dy.type-title; vertical-alignment: center; }
                                Text { text: "LIGHTS"; color: root.expanded == "lights" ? #000000 : #c8c8c8; font-size: Dy.type-value; font-family: Dy.mono; vertical-alignment: center; letter-spacing: 2px; }
                            }
                        }
                    }
                    TouchArea {
                        clicked => { root.expand("climate"); }
                        height: 72px;
                        Rectangle {
                            background: root.expanded == "climate" ? #ffffff : #000000;
                            HorizontalLayout {
                                padding-left: 12px; spacing: 12px;
                                Text { text: "°"; color: root.expanded == "climate" ? #000000 : #c8c8c8; font-size: Dy.type-value; vertical-alignment: center; }
                                Text { text: "CLIMATE"; color: root.expanded == "climate" ? #000000 : #c8c8c8; font-size: Dy.type-value; font-family: Dy.mono; vertical-alignment: center; letter-spacing: 2px; }
                            }
                        }
                    }
                    TouchArea {
                        clicked => { root.expand("calendar"); }
                        height: 72px;
                        Rectangle {
                            background: root.expanded == "calendar" ? #ffffff : #000000;
                            HorizontalLayout {
                                padding-left: 12px; spacing: 12px;
                                Text { text: "▦"; color: root.expanded == "calendar" ? #000000 : #c8c8c8; font-size: Dy.type-title; vertical-alignment: center; }
                                Text { text: "CALENDAR"; color: root.expanded == "calendar" ? #000000 : #c8c8c8; font-size: Dy.type-value; font-family: Dy.mono; vertical-alignment: center; letter-spacing: 2px; }
                            }
                        }
                    }
                    TouchArea {
                        clicked => { root.expand("weather"); }
                        height: 72px;
                        Rectangle {
                            background: root.expanded == "weather" ? #ffffff : #000000;
                            HorizontalLayout {
                                padding-left: 12px; spacing: 12px;
                                Text { text: "*"; color: root.expanded == "weather" ? #000000 : #c8c8c8; font-size: Dy.type-value; vertical-alignment: center; }
                                Text { text: "WEATHER"; color: root.expanded == "weather" ? #000000 : #c8c8c8; font-size: Dy.type-value; font-family: Dy.mono; vertical-alignment: center; letter-spacing: 2px; }
                            }
                        }
                    }
                    TouchArea {
                        clicked => { root.expand("media"); }
                        height: 72px;
                        Rectangle {
                            background: root.expanded == "media" ? #ffffff : #000000;
                            HorizontalLayout {
                                padding-left: 12px; spacing: 12px;
                                Text { text: "▶"; color: root.expanded == "media" ? #000000 : #c8c8c8; font-size: Dy.type-title; vertical-alignment: center; }
                                Text { text: "MEDIA"; color: root.expanded == "media" ? #000000 : #c8c8c8; font-size: Dy.type-value; font-family: Dy.mono; vertical-alignment: center; letter-spacing: 2px; }
                            }
                        }
                    }
                    TouchArea {
                        clicked => { root.expand("purifier"); }
                        height: 72px;
                        Rectangle {
                            background: root.expanded == "purifier" ? #ffffff : #000000;
                            HorizontalLayout {
                                padding-left: 12px; spacing: 12px;
                                Text { text: "◎"; color: root.expanded == "purifier" ? #000000 : #c8c8c8; font-size: Dy.type-title; vertical-alignment: center; }
                                Text { text: "PURIFIER"; color: root.expanded == "purifier" ? #000000 : #c8c8c8; font-size: Dy.type-value; font-family: Dy.mono; vertical-alignment: center; letter-spacing: 2px; }
                            }
                        }
                    }
                    TouchArea {
                        clicked => { root.expand("terminal"); }
                        height: 72px;
                        Rectangle {
                            background: root.expanded == "terminal" ? #ffffff : #000000;
                            HorizontalLayout {
                                padding-left: 12px; spacing: 12px;
                                Text { text: ">_"; color: root.expanded == "terminal" ? #000000 : #c8c8c8; font-size: Dy.type-control; font-family: Dy.mono; vertical-alignment: center; }
                                Text { text: "TERMINAL"; color: root.expanded == "terminal" ? #000000 : #c8c8c8; font-size: Dy.type-value; font-family: Dy.mono; vertical-alignment: center; letter-spacing: 2px; }
                            }
                        }
                    }
                    TouchArea {
                        clicked => { root.expand("pong"); }
                        height: 72px;
                        Rectangle {
                            background: root.expanded == "pong" ? #ffffff : #000000;
                            HorizontalLayout {
                                padding-left: 12px; spacing: 12px;
                                Text { text: "○"; color: root.expanded == "pong" ? #000000 : #c8c8c8; font-size: Dy.type-title; vertical-alignment: center; }
                                Text { text: "PONG"; color: root.expanded == "pong" ? #000000 : #c8c8c8; font-size: Dy.type-value; font-family: Dy.mono; vertical-alignment: center; letter-spacing: 2px; }
                            }
                        }
                    }
                    TouchArea {
                        clicked => { root.expand("settings"); }
                        height: 72px;
                        Rectangle {
                            background: root.settings-page ? #ffffff : #000000;
                            HorizontalLayout {
                                padding-left: 12px; spacing: 12px;
                                Text { text: "⚙"; color: root.settings-page ? #000000 : #c8c8c8; font-size: Dy.type-title; vertical-alignment: center; }
                                Text { text: "SETTINGS"; color: root.settings-page ? #000000 : #c8c8c8; font-size: Dy.type-value; font-family: Dy.mono; vertical-alignment: center; letter-spacing: 2px; }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.kb-open: AnsiKeyboard {
        x: root.rail-w;
        y: parent.height - 600px;
        width: parent.width - root.rail-w;
        height: 600px;
        field: root.kb-field;
        preview: root.kb-field == "wifi-pass" ? (root.kb-text == "" ? "" : "••••••••") : root.kb-text;
        typed(ch) => { root.keyboard-key(ch); }
        command(cmd) => { root.keyboard-command(cmd); }
        close => { root.keyboard-close(); }
    }

    if root.screen-sleep: Rectangle {
        background: #000000;
        TouchArea {
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down {
                    root.wake-screen();
                }
            }
        }
    }
}
