import { ScrollView, LineEdit, Slider, Button } from "std-widgets.slint";
import { Dy, LightRow, HourRow, EventRow, ServiceRow, ActivityRow, TimerRow, Slot, GalleryItem, CalCell, PaletteHit, RoutineRow, SlopNode, ReleaseRow, WifiNet, Card, Pill, Toggle, Swatch, IconBtn, HitBtn, FieldTap, KeyBtn, Bar, TileShell } from "cards.slint";

export component MainWindow inherits Window {
    title: "Judie";
    preferred-width: 1920px;
    preferred-height: 1200px;
    background: #000000;
    no-frame: true;

    in-out property <string> clock: "--:--";
    in-out property <string> date-text: "";
    in-out property <string> version-text: "0.2.8";
    in-out property <string> status-label: "";
    in-out property <bool> dnd: false;
    in-out property <int> page: 0;
    in-out property <int> page-count: 1;

    in-out property <bool> update-available: false;
    in-out property <string> update-label: "";
    in-out property <string> update-error: "";
    in-out property <bool> updating: false;

    in-out property <string> weather-loc: "";
    in-out property <string> weather-temp: "";
    in-out property <string> weather-cond: "";
    in-out property <string> weather-range: "";
    in-out property <string> weather-feel: "";
    in-out property <string> weather-note: "";
    in-out property <[HourRow]> hours: [];

    in-out property <bool> master-on: true;
    in-out property <int> brightness: 70;
    in-out property <string> scene: "Cozy";
    in-out property <string> master-color: "#FFB366";
    in-out property <[LightRow]> lights: [];

    in-out property <bool> playing: false;
    in-out property <string> track-title: "";
    in-out property <string> track-artist: "";
    in-out property <int> volume: 62;
    in-out property <float> media-progress: 0.2;

    in-out property <string> indoor: "";
    in-out property <string> outdoor: "";
    in-out property <string> humidity: "";
    in-out property <string> comfort: "";
    in-out property <[EventRow]> events: [];
    in-out property <string> month-name: "";

    in-out property <bool> purifier-on: true;
    in-out property <string> purifier-mode: "Auto";
    in-out property <string> purifier-aq: "Good";
    in-out property <int> purifier-filter: 38;

    in-out property <float> cpu: 0;
    in-out property <float> memory: 0;
    in-out property <string> mem-detail: "";
    in-out property <string> temp-text: "";
    in-out property <[ServiceRow]> services: [];
    in-out property <[ActivityRow]> activity: [];
    in-out property <[TimerRow]> timers: [];

    in-out property <bool> settings-open: false;
    in-out property <bool> palette-open: false;
    in-out property <bool> gallery-open: false;
    in-out property <bool> creator-open: false;
    in-out property <bool> edit-mode: false;
    in-out property <int> settings-tab: 0;
    in-out property <string> room-name: "Room";
    in-out property <string> assistant-url: "http://127.0.0.1:8742";
    in-out property <string> latitude: "64.07";
    in-out property <string> longitude: "-21.95";
    in-out property <bool> voice-enabled: true;
    in-out property <bool> speak-replies: true;
    in-out property <bool> units-metric: true;
    in-out property <bool> notice-timers: true;
    in-out property <bool> notice-calendar: true;
    in-out property <bool> notice-weather: true;
    in-out property <bool> notice-air: true;
    in-out property <bool> notice-devices: true;
    in-out property <string> palette-query: "";
    in-out property <string> palette-reply: "";
    in-out property <[PaletteHit]> palette-hits: [];
    in-out property <[RoutineRow]> routines: [];
    in-out property <string> expanded: "";
    in-out property <[Slot]> slots: [];
    in-out property <[GalleryItem]> gallery-items: [];
    in-out property <string> gallery-kind: "activity";
    in-out property <string> gallery-size: "1x1";
    in-out property <string> gallery-desc: "";
    in-out property <string> gallery-query: "";
    in-out property <bool> gallery-custom: false;
    in-out property <string> gallery-custom-id: "";
    in-out property <string> creator-name: "Untitled";
    in-out property <string> creator-template: "stat";
    in-out property <string> creator-size: "1x1";
    in-out property <[CalCell]> cal-cells: [];
    in-out property <[SlopNode]> slop-nodes: [];
    in-out property <[SlopNode]> creator-nodes: [];
    in-out property <string> creator-selected: "";
    in-out property <string> creator-node-text: "";
    in-out property <string> pending-remove: "";
    in-out property <string> pending-label: "";

    in-out property <bool> kb-open: false;
    in-out property <string> kb-field: "";
    in-out property <string> kb-text: "";
    in-out property <bool> kb-shift: false;
    in-out property <bool> kb-symbols: false;
    in-out property <[ReleaseRow]> releases: [];
    in-out property <string> selected-release: "";
    in-out property <string> release-status: "";
    in-out property <string> wifi-ssid: "—";
    in-out property <string> wifi-ip: "—";
    in-out property <string> wifi-state: "—";
    in-out property <string> wifi-pick: "";
    in-out property <string> wifi-pass: "";
    in-out property <string> wifi-status: "";
    in-out property <bool> wifi-busy: false;
    in-out property <[WifiNet]> wifi-nets: [];

    callback update-now();
    callback dismiss-update();
    callback toggle-master();
    callback brightness-changed(int);
    callback set-color(string);
    callback set-scene(string);
    callback toggle-light(string);
    callback toggle-play();
    callback next-track();
    callback prev-track();
    callback volume-changed(int);
    callback quick(string);
    callback toggle-purifier();
    callback cycle-purifier();
    callback set-purifier-mode(string);
    callback open-settings();
    callback close-overlay();
    callback open-palette();
    callback submit-palette();
    callback palette-text(string);
    callback run-palette-hit(string);
    callback set-tab(int);
    callback toggle-voice();
    callback toggle-speak();
    callback toggle-units();
    callback toggle-notice(string);
    callback set-room-name(string);
    callback set-location(string);
    callback set-latitude(string);
    callback set-longitude(string);
    callback set-assistant-url(string);
    callback remove-routine(string);
    callback set-page(int);
    callback expand(string);
    callback collapse();
    callback enter-edit();
    callback exit-edit();
    callback open-gallery();
    callback close-gallery();
    callback hold-home();
    callback request-remove(string);
    callback confirm-remove();
    callback cancel-remove();
    callback cycle-slot(string);
    callback place-slot(string, int, int);
    callback gallery-pick(string);
    callback gallery-pick-custom(string);
    callback gallery-add();
    callback gallery-size-next();
    callback gallery-size-prev();
    callback gallery-search(string);
    callback gallery-import();
    callback open-creator();
    callback close-creator();
    callback save-creator();
    callback creator-name-changed(string);
    callback set-creator-size(string);
    callback set-creator-template(string);
    callback add-creator-kind(string);
    callback select-creator-node(string);
    callback creator-node-text-changed(string);
    callback delete-creator-node();
    callback check-updates();
    callback install-tag(string);
    callback pick-release(string);
    callback scan-wifi();
    callback pick-wifi(string);
    callback connect-wifi();
    callback disconnect-wifi();
    callback reboot-now();
    callback shutdown-now();
    callback open-keyboard(string);
    callback keyboard-key(string);
    callback keyboard-back();
    callback keyboard-submit();
    callback keyboard-close();
    callback kb-toggle-shift();
    callback kb-toggle-symbols();

    property <length> pad: 20px;
    property <length> gap: 12px;
    property <int> tap-count: 0;
    property <length> swipe-x: 0px;

    VerticalLayout {
        padding: 0;
        spacing: 0;

        if root.update-available: Rectangle {
            background: #1a1208;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 8px;
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: root.updating ? "Installing update…" : (root.update-error != "" ? root.update-error : root.update-label);
                        color: #f0a030;
                        font-size: 13px;
                        font-weight: 500;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    if !root.updating: Pill {
                        label: "UPDATE";
                        on: true;
                        clicked => { root.update-now(); }
                    }
                    Pill {
                        label: "LATER";
                        clicked => { root.dismiss-update(); }
                    }
                }
            }
        }

        Rectangle {
            height: 88px;
            background: #000000;
            HorizontalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                spacing: 10px;
                Text {
                    text: "v" + root.version-text;
                    color: #555555;
                    font-size: 11px;
                    font-family: Dy.mono;
                    vertical-alignment: center;
                }
                if root.status-label != "": Text {
                    text: root.status-label;
                    color: #7a7a7a;
                    font-size: 11px;
                    font-family: Dy.mono;
                    vertical-alignment: center;
                }
                if root.dnd: Text {
                    text: "DND";
                    color: #ff5c5c;
                    font-size: 11px;
                    font-weight: 700;
                    font-family: Dy.mono;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "ASK";
                    color: #555555;
                    font-size: 11px;
                    font-family: Dy.mono;
                    vertical-alignment: center;
                }
                Text {
                    text: "SET";
                    color: #555555;
                    font-size: 11px;
                    font-family: Dy.mono;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.clock;
                    color: #e6e6e6;
                    font-size: 42px;
                    font-weight: 700;
                    font-family: Dy.mono;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.date-text;
                    color: #7a7a7a;
                    font-size: 12px;
                    font-family: Dy.mono;
                    horizontal-alignment: center;
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: 100%;
                background: #3d3d3d;
            }
            TouchArea {
                x: parent.width / 3;
                width: parent.width / 3;
                height: 100%;
                clicked => { root.open-palette(); }
            }
            TouchArea {
                x: parent.width * 2 / 3;
                width: parent.width / 3;
                height: 100%;
                clicked => { root.open-settings(); }
            }
        }

        home-touch := TouchArea {
            clicked => {
                root.tap-count += 1;
                if root.tap-count >= 3 {
                    root.enter-edit();
                    root.tap-count = 0;
                }
            }
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down {
                    root.swipe-x = self.mouse-x;
                }
                if ev.kind == PointerEventKind.up && !root.edit-mode && root.expanded == "" {
                    if self.mouse-x - root.swipe-x < -80px && root.page < root.page-count - 1 {
                        root.set-page(root.page + 1);
                    }
                    if self.mouse-x - root.swipe-x > 80px && root.page > 0 {
                        root.set-page(root.page - 1);
                    }
                }
            }
            vertical-stretch: 1;
            Timer {
                interval: 550ms;
                running: root.tap-count > 0;
                triggered => { root.tap-count = 0; }
            }
            Timer {
                interval: 450ms;
                running: home-touch.pressed && !root.edit-mode && root.expanded == "" && !root.gallery-open && !root.creator-open && !root.settings-open && !root.palette-open;
                triggered => { root.hold-home(); }
            }
            Rectangle {
                property <length> cell: min(self.width / 6, self.height / 4);
                property <length> ox: (self.width - cell * 6) / 2;
                property <length> oy: (self.height - cell * 4) / 2;
                property <length> g: 16px;

                for w in root.slots: TileShell {
                    x: ox + w.col * cell;
                    y: oy + w.row * cell;
                    width: w.cols * cell - g;
                    height: w.rows * cell - g;
                    visible: w.page == root.page;
                    editing: root.edit-mode;
                    pending: root.pending-remove == w.id;
                    size-label: w.size;
                    tapped => { root.expand(w.kind); }
                    held => { root.hold-home(); }
                    remove => { root.request-remove(w.id); }
                    cycle-size => { root.cycle-slot(w.id); }
                    drag-to(mx, my) => {
                        root.place-slot(w.id, round((w.col * cell + mx) / cell), round((w.row * cell + my) / cell));
                    }

                    if w.kind == "quickControls": GridLayout {
                        spacing: 8px;
                        Rectangle {
                            row: 0; col: 0; border-radius: 0px; background: #000000;
                            border-width: 1px; border-color: #3d3d3d;
                            TouchArea { clicked => { root.quick("goodNight"); } }
                            VerticalLayout {
                                alignment: center; spacing: 4px;
                                Text { text: "☾"; color: #e6e6e6; font-size: 16px; font-family: Dy.mono; horizontal-alignment: center; }
                                Text { text: "GOOD NIGHT"; color: #e6e6e6; font-size: 10px; font-weight: 600; font-family: Dy.mono; horizontal-alignment: center; }
                            }
                        }
                        Rectangle {
                            row: 0; col: 1; border-radius: 0px; background: #000000;
                            border-width: 1px; border-color: #3d3d3d;
                            TouchArea { clicked => { root.quick("lightsOff"); } }
                            VerticalLayout {
                                alignment: center; spacing: 4px;
                                Text { text: "○"; color: #e6e6e6; font-size: 14px; font-family: Dy.mono; horizontal-alignment: center; }
                                Text { text: "LIGHTS OFF"; color: #e6e6e6; font-size: 10px; font-weight: 600; font-family: Dy.mono; horizontal-alignment: center; }
                            }
                        }
                        Rectangle {
                            row: 1; col: 0; border-radius: 0px; background: #000000;
                            border-width: 1px; border-color: root.dnd ? #ff5c5c : #3d3d3d;
                            TouchArea { clicked => { root.quick("dnd"); } }
                            VerticalLayout {
                                alignment: center; spacing: 4px;
                                Text { text: "⊘"; color: root.dnd ? #ff5c5c : #e6e6e6; font-size: 16px; font-family: Dy.mono; horizontal-alignment: center; }
                                Text { text: "DO NOT DISTURB"; color: root.dnd ? #ff5c5c : #e6e6e6; font-size: 10px; font-weight: 600; font-family: Dy.mono; horizontal-alignment: center; }
                            }
                        }
                        Rectangle {
                            row: 1; col: 1; border-radius: 0px; background: #000000;
                            border-width: 1px; border-color: #3d3d3d;
                            TouchArea { clicked => { root.quick("movie"); } }
                            VerticalLayout {
                                alignment: center; spacing: 4px;
                                Text { text: "▶"; color: #e6e6e6; font-size: 14px; font-family: Dy.mono; horizontal-alignment: center; }
                                Text { text: "MOVIE MODE"; color: #e6e6e6; font-size: 10px; font-weight: 600; font-family: Dy.mono; horizontal-alignment: center; }
                            }
                        }
                    }

                    if w.kind == "climate": HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: 72px; height: 72px; border-radius: 0px;
                            border-width: 2px; border-color: #5ce1ff; background: #000000;
                            VerticalLayout {
                                alignment: center;
                                Text { text: root.indoor; color: #e6e6e6; font-size: 16px; font-weight: 700; font-family: Dy.mono; horizontal-alignment: center; }
                                Text { text: "NOW"; color: #7a7a7a; font-size: 10px; font-family: Dy.mono; horizontal-alignment: center; }
                            }
                        }
                        VerticalLayout {
                            alignment: center; spacing: 6px;
                            Text { text: "HUMIDITY"; color: #7a7a7a; font-size: 10px; font-family: Dy.mono; }
                            Text { text: root.humidity; color: #e6e6e6; font-size: 16px; font-weight: 700; font-family: Dy.mono; }
                            Text { text: "OUTDOOR"; color: #7a7a7a; font-size: 10px; font-family: Dy.mono; }
                            Text { text: root.outdoor; color: #e6e6e6; font-size: 16px; font-weight: 700; font-family: Dy.mono; }
                            if w.size == "1x2": Text { text: root.comfort; color: #7a7a7a; font-size: 12px; font-family: Dy.mono; }
                        }
                    }

                    if w.kind == "calendar": HorizontalLayout {
                        spacing: 10px;
                        if w.size != "1x1": VerticalLayout {
                            spacing: 4px; horizontal-stretch: 1;
                            Text { text: "Today"; color: #7a7a7a; font-size: 12px; }
                            for ev in root.events: HorizontalLayout {
                                spacing: 6px;
                                Rectangle { width: 4px; height: 18px; border-radius: 0px; background: #5ce1ff; }
                                VerticalLayout {
                                    Text { text: ev.title; color: #e6e6e6; font-size: 12px; font-weight: 600; overflow: elide; }
                                    Text { text: ev.time + (ev.detail == "" ? "" : " · " + ev.detail); color: #7a7a7a; font-size: 10px; overflow: elide; }
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px; horizontal-stretch: 1;
                            Text { text: root.month-name; color: #7a7a7a; font-size: 12px; }
                            HorizontalLayout {
                                spacing: 0;
                                for d in ["S", "M", "T", "W", "T", "F", "S"]: Text {
                                    text: d; color: #555555; font-size: 9px; horizontal-alignment: center; horizontal-stretch: 1;
                                }
                            }
                            GridLayout {
                                spacing: 2px;
                                for cell[i] in root.cal-cells: Rectangle {
                                    row: floor(i / 7); col: mod(i, 7);
                                    height: 16px;
                                    border-radius: 0px;
                                    border-width: cell.today ? 1px : 0px;
                                    border-color: #5ce1ff;
                                    background: #00000000;
                                    Text {
                                        text: cell.label;
                                        color: cell.today ? #5ce1ff : #e6e6e6;
                                        font-size: 10px;
                                        font-family: Dy.mono;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    if w.kind == "purifier": VerticalLayout {
                        spacing: 8px;
                        if w.size != "1x1": HorizontalLayout {
                            spacing: 10px;
                            Rectangle {
                                width: 88px; height: 88px; border-radius: 0px;
                                border-width: 2px; border-color: #3dd68c; background: #000000;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: root.purifier-aq; color: #3dd68c; font-size: 16px; font-weight: 700; font-family: Dy.mono; horizontal-alignment: center; }
                                    Text { text: "AIR QUALITY"; color: #7a7a7a; font-size: 9px; font-family: Dy.mono; horizontal-alignment: center; }
                                }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                Rectangle {
                                    border-radius: 0px; background: #000000;
                                    border-width: 1px; border-color: #3d3d3d;
                                    VerticalLayout {
                                        padding: 8px;
                                        Text { text: "PM2.5"; color: #7a7a7a; font-size: 10px; font-family: Dy.mono; }
                                        Text { text: "7 µg/m³"; color: #e6e6e6; font-size: 14px; font-weight: 700; font-family: Dy.mono; }
                                        Text { text: "Fine particles"; color: #555555; font-size: 10px; font-family: Dy.mono; }
                                    }
                                }
                                Rectangle {
                                    border-radius: 0px; background: #000000;
                                    border-width: 1px; border-color: #3d3d3d;
                                    VerticalLayout {
                                        padding: 8px;
                                        Text { text: "ALLERGENS"; color: #7a7a7a; font-size: 10px; font-family: Dy.mono; }
                                        Text { text: "4/12"; color: #e6e6e6; font-size: 14px; font-weight: 700; font-family: Dy.mono; }
                                        Text { text: "Allergen level"; color: #555555; font-size: 10px; font-family: Dy.mono; }
                                    }
                                }
                            }
                        }
                        if w.size == "1x1": VerticalLayout {
                            Text { text: "7"; color: #e6e6e6; font-size: 28px; font-weight: 700; }
                            Text { text: "PM2.5 · " + root.purifier-aq; color: #7a7a7a; font-size: 12px; }
                        }
                        if w.size == "2x2": Text { text: "Filter: Clean soon. Dust can cut performance. Clean the filter for the best air."; color: #7a7a7a; font-size: 11px; wrap: word-wrap; }
                        Text { text: "Filter"; color: #7a7a7a; font-size: 11px; }
                        Bar { level: root.purifier-filter / 100; fill: #3dd68c; }
                        Text { text: root.purifier-filter + "%"; color: #e6e6e6; font-size: 12px; }
                        if w.size == "2x2": HorizontalLayout {
                            spacing: 8px;
                            Pill { label: "Auto"; on: root.purifier-mode == "Auto"; clicked => { root.set-purifier-mode("Auto"); } }
                            Pill { label: "Sleep"; on: root.purifier-mode == "Sleep"; clicked => { root.set-purifier-mode("Sleep"); } }
                            Pill { label: "Boost"; on: root.purifier-mode == "Manual"; clicked => { root.set-purifier-mode("Manual"); } }
                        }
                    }

                    if w.kind == "activity": VerticalLayout {
                        for a in root.activity: HorizontalLayout {
                            spacing: 8px;
                            if w.size == "2x2": Text { text: a.time; color: #7a7a7a; font-size: 12px; min-width: 44px; }
                            Text { text: a.title; color: #e6e6e6; font-size: 13px; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                            if w.size == "2x2": Text { text: a.source; color: #7a7a7a; font-size: 11px; }
                        }
                    }

                    if w.kind == "server": VerticalLayout {
                        spacing: 4px;
                        Text { text: "122 ms"; color: #e6e6e6; font-size: 28px; font-weight: 700; }
                        Text { text: "4/5 up"; color: #7a7a7a; font-size: 12px; }
                        if w.size != "1x1": VerticalLayout {
                            spacing: 4px;
                            for s in root.services: HorizontalLayout {
                            spacing: 8px;
                            Rectangle { width: 8px; height: 8px; border-radius: 0px; background: s.online ? #3dd68c : #ff5c5c; y: 4px; }
                            Text { text: s.name; color: #e6e6e6; font-size: 13px; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: s.status; color: s.online ? #7a7a7a : #ff5c5c; font-size: 12px; }
                            }
                        }
                    }

                    if w.kind == "weather": VerticalLayout {
                        HorizontalLayout {
                            Text { text: root.weather-loc; color: #7a7a7a; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
                            if w.size != "1x1": Text { text: root.weather-feel; color: #7a7a7a; font-size: 11px; }
                        }
                        HorizontalLayout {
                            VerticalLayout {
                                Text { text: root.weather-temp; color: #e6e6e6; font-size: 32px; font-weight: 700; }
                                Text { text: root.weather-cond; color: #e6e6e6; font-size: 14px; }
                                Text { text: root.weather-range; color: #7a7a7a; font-size: 12px; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle {
                                width: 36px; height: 36px; border-radius: 0px; background: #000000; y: 8px;
                                border-width: 1px; border-color: #f0a030;
                                Text { text: "*"; color: #f0a030; font-size: 18px; font-family: Dy.mono; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        if w.size == "2x2": Text { text: root.weather-note; color: #e6e6e6; font-size: 12px; wrap: word-wrap; }
                        if w.size != "1x1": HorizontalLayout {
                            spacing: 8px;
                            for h in root.hours: VerticalLayout {
                                Text { text: h.hour; color: #555555; font-size: 10px; horizontal-alignment: center; }
                                Text { text: h.temp; color: #e6e6e6; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: h.precip; color: #7a7a7a; font-size: 10px; horizontal-alignment: center; }
                            }
                        }
                    }

                    if w.kind == "lights": VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            Text { text: root.scene; color: #7a7a7a; font-size: 12px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Toggle { on: root.master-on; toggled => { root.toggle-master(); } }
                        }
                        Text { text: root.master-on ? root.brightness + "%" : "Off"; color: #e6e6e6; font-size: 28px; font-weight: 700; }
                        Slider { minimum: 0; maximum: 100; value: root.brightness; changed(v) => { root.brightness-changed(round(v)); } }
                        HorizontalLayout {
                            spacing: 8px;
                            Swatch { swatch: #ff5a5a; on: root.master-color == "#FF5A5A"; clicked => { root.set-color("#FF5A5A"); } }
                            Swatch { swatch: #ff8c42; on: root.master-color == "#FF8C42"; clicked => { root.set-color("#FF8C42"); } }
                            Swatch { swatch: #ffd166; on: root.master-color == "#FFD166"; clicked => { root.set-color("#FFD166"); } }
                            Swatch { swatch: #7cf29c; on: root.master-color == "#7CF29C"; clicked => { root.set-color("#7CF29C"); } }
                            Swatch { swatch: #5ce1ff; on: root.master-color == "#2D7BFF"; clicked => { root.set-color("#2D7BFF"); } }
                            if w.size != "1x1": Swatch { swatch: #7b61ff; on: root.master-color == "#7B61FF"; clicked => { root.set-color("#7B61FF"); } }
                            if w.size != "1x1": Swatch { swatch: #ff6bcb; on: root.master-color == "#FF6BCB"; clicked => { root.set-color("#FF6BCB"); } }
                            if w.size != "1x1": Swatch { swatch: #ffffff; on: root.master-color == "#FFFFFF"; clicked => { root.set-color("#FFFFFF"); } }
                        }
                        if w.size == "2x2": GridLayout {
                            spacing: 8px;
                            for light[i] in root.lights: Rectangle {
                                row: floor(i / 2); col: mod(i, 2);
                                border-radius: 0px; background: #000000; height: 44px;
                                border-width: 1px; border-color: #3d3d3d;
                                HorizontalLayout {
                                    spacing: 0px;
                                    Rectangle { width: 3px; background: light.on ? #f0a030 : #3d3d3d; }
                                    TouchArea {
                                        clicked => { root.toggle-light(light.id); }
                                        VerticalLayout {
                                            padding: 6px;
                                            Text { text: light.name; color: #e6e6e6; font-size: 11px; font-family: Dy.mono; overflow: elide; }
                                            Text { text: light.brightness; color: #7a7a7a; font-size: 11px; font-family: Dy.mono; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if w.kind == "media": VerticalLayout {
                        Text { text: root.playing ? "Playing" : "Paused"; color: #7a7a7a; font-size: 12px; }
                        Text { text: root.track-title; color: #e6e6e6; font-size: 16px; font-weight: 600; overflow: elide; }
                        if w.size != "1x1": Text { text: root.track-artist; color: #7a7a7a; font-size: 12px; overflow: elide; }
                        if w.size != "1x1": Bar { level: root.media-progress; fill: #e6e6e6; }
                        HorizontalLayout {
                            spacing: 8px;
                            if w.size != "1x1": IconBtn { glyph: "⟨"; clicked => { root.prev-track(); } }
                            IconBtn { glyph: root.playing ? "❚❚" : "▶"; primary: true; clicked => { root.toggle-play(); } }
                            if w.size != "1x1": IconBtn { glyph: "⟩"; clicked => { root.next-track(); } }
                            if w.size == "2x2": Rectangle { horizontal-stretch: 1; }
                            if w.size == "2x2": Text { text: root.volume + "%"; color: #7a7a7a; font-size: 12px; vertical-alignment: center; }
                        }
                        if w.size == "2x2": Slider { minimum: 0; maximum: 100; value: root.volume; changed(v) => { root.volume-changed(round(v)); } }
                    }

                    if w.kind == "system": VerticalLayout {
                        Text { text: "CPU"; color: #7a7a7a; font-size: 12px; }
                        Text { text: round(root.cpu) + "%"; color: #3dd68c; font-size: 24px; font-weight: 700; }
                        Bar { level: root.cpu / 100; fill: #3dd68c; }
                        if w.size != "1x1": Text { text: "Memory"; color: #7a7a7a; font-size: 12px; }
                        if w.size != "1x1": Text { text: round(root.memory) + "%"; color: #b794f6; font-size: 24px; font-weight: 700; }
                        if w.size != "1x1": Bar { level: root.memory / 100; fill: #b794f6; }
                        if w.size == "2x2": Text { text: root.mem-detail; color: #7a7a7a; font-size: 12px; }
                        if w.size == "2x2": Text { text: root.temp-text; color: #7a7a7a; font-size: 12px; }
                    }

                    if w.kind == "timers": VerticalLayout {
                        for t in root.timers: HorizontalLayout {
                            Text { text: t.label; color: #e6e6e6; font-size: 13px; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: t.remain; color: #7a7a7a; font-size: 13px; }
                        }
                    }

                    if w.kind == "custom": Rectangle {
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        for n in root.slop-nodes: Rectangle {
                            x: parent.width * n.x / 100;
                            y: parent.height * n.y / 100;
                            width: parent.width * n.w / 100;
                            height: parent.height * n.h / 100;
                            visible: n.widget-id == w.id;
                            background: (n.kind == "button" || n.kind == "chip" || n.kind == "bar" || n.kind == "toggle") ? rgb(n.r, n.g, n.b) : #00000000;
                            border-radius: n.kind == "chip" || n.kind == "button" || n.kind == "toggle" ? 8px : 0px;
                            opacity: (n.kind == "bar" || n.kind == "gauge") ? 0.85 : 1;
                            Text {
                                text: n.text;
                                color: rgb(n.r, n.g, n.b);
                                font-size: n.kind == "metric" ? 28px : 12px;
                                font-weight: n.kind == "metric" ? 700 : 500;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if root.page-count > 1: HorizontalLayout {
                    y: parent.height - 28px;
                    width: parent.width;
                    height: 16px;
                    alignment: center;
                    spacing: 8px;
                    Rectangle {
                        width: 8px; height: 8px; border-radius: 0px;
                        background: root.page == 0 ? #e6e6e6 : #555555;
                    }
                    Rectangle {
                        width: 8px; height: 8px; border-radius: 0px;
                        background: root.page == 1 ? #e6e6e6 : #555555;
                    }
                    if root.page-count > 2: Rectangle {
                        width: 8px; height: 8px; border-radius: 0px;
                        background: root.page == 2 ? #e6e6e6 : #555555;
                    }
                    if root.page-count > 3: Rectangle {
                        width: 8px; height: 8px; border-radius: 0px;
                        background: root.page == 3 ? #e6e6e6 : #555555;
                    }
                    if root.page-count > 4: Rectangle {
                        width: 8px; height: 8px; border-radius: 0px;
                        background: root.page == 4 ? #e6e6e6 : #555555;
                    }
                    if root.page-count > 5: Rectangle {
                        width: 8px; height: 8px; border-radius: 0px;
                        background: root.page == 5 ? #e6e6e6 : #555555;
                    }
                }

                if root.edit-mode: Rectangle {
                    y: parent.height - 120px;
                    height: 120px;
                    width: parent.width;
                    background: #000000cc;
                    HorizontalLayout {
                        padding: 10px; spacing: 10px; alignment: center;
                        Pill { label: "ADD WIDGET"; on: true; clicked => { root.open-gallery(); } }
                        Pill { label: "DONE"; clicked => { root.exit-edit(); } }
                    }
                }
            }
        }
    }

    if root.pending-remove != "": Rectangle {
        background: #000000cc;
        TouchArea { clicked => { root.cancel-remove(); } }
        Rectangle {
            x: parent.width * 0.3; y: parent.height * 0.32; width: parent.width * 0.4; height: 320px;
            border-radius: 0px; background: #000000;
            border-width: 1px; border-color: #3d3d3d;
            VerticalLayout {
                padding: 20px; spacing: 12px;
                Text { text: "REMOVE WIDGET?"; color: #e6e6e6; font-size: 16px; font-weight: 700; font-family: Dy.mono; }
                Text { text: root.pending-label == "" ? "This tile will leave the home screen." : root.pending-label; color: #7a7a7a; font-size: 12px; font-family: Dy.mono; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 10px;
                    Pill { label: "CANCEL"; clicked => { root.cancel-remove(); } }
                    Pill { label: "REMOVE"; on: true; clicked => { root.confirm-remove(); } }
                }
            }
        }
    }

    if root.palette-open: Rectangle {
        background: #000000cc;
        TouchArea { clicked => { root.close-overlay(); } }
        Rectangle {
            x: parent.width * 0.18;
            y: 80px;
            width: parent.width * 0.64;
            height: 560px;
            border-radius: 0px;
            background: #000000;
            border-width: 1px;
            border-color: #3d3d3d;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "JUDIE"; color: #e6e6e6; font-size: 16px; font-weight: 700; font-family: Dy.mono; }
                FieldTap {
                    label: "ASK JUDIE";
                    value: root.palette-query;
                    active: root.kb-open && root.kb-field == "palette";
                    tapped => { root.open-keyboard("palette"); }
                }
                Flickable {
                    vertical-stretch: 1;
                    viewport-height: 12 * 40px;
                    VerticalLayout {
                        spacing: 4px;
                        for hit in root.palette-hits: TouchArea {
                            clicked => { root.run-palette-hit(hit.id); }
                            Rectangle {
                                height: 36px; border-radius: 0px; background: #000000;
                                border-width: 1px; border-color: #3d3d3d;
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    Text { text: hit.title; color: #e6e6e6; font-size: 12px; font-family: Dy.mono; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    Text { text: hit.hint; color: #7a7a7a; font-size: 11px; font-family: Dy.mono; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
                Text {
                    text: root.palette-reply;
                    color: #7a7a7a;
                    font-size: 12px;
                    font-family: Dy.mono;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Pill { label: "ASK"; on: true; clicked => { root.submit-palette(); } }
                    Pill { label: "CLOSE"; clicked => { root.close-overlay(); } }
                }
            }
        }
    }

    if root.settings-open: Rectangle {
        background: #000000cc;
        TouchArea { clicked => { root.close-overlay(); } }
        Rectangle {
            x: 16px;
            y: 16px;
            width: parent.width - 32px;
            height: parent.height - 32px;
            border-radius: 0px;
            background: #000000;
            border-width: 1px;
            border-color: #3d3d3d;
            TouchArea { clicked => { } }
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "SETTINGS"; color: #e6e6e6; font-size: 22px; font-weight: 700; font-family: Dy.mono; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Pill { label: "CLOSE"; clicked => { root.close-overlay(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Pill { label: "GENERAL"; on: root.settings-tab == 0; clicked => { root.set-tab(0); } }
                    Pill { label: "VOICE"; on: root.settings-tab == 1; clicked => { root.set-tab(1); } }
                    Pill { label: "NETWORK"; on: root.settings-tab == 2; clicked => { root.set-tab(2); } }
                    Pill { label: "ALERTS"; on: root.settings-tab == 3; clicked => { root.set-tab(3); } }
                    Pill { label: "ROUTINES"; on: root.settings-tab == 4; clicked => { root.set-tab(4); } }
                    Pill { label: "POWER"; on: root.settings-tab == 5; clicked => { root.set-tab(5); } }
                }
                if root.settings-tab == 0: VerticalLayout {
                    spacing: 10px;
                    FieldTap { label: "ROOM NAME"; value: root.room-name; active: root.kb-field == "room-name"; tapped => { root.open-keyboard("room-name"); } }
                    FieldTap { label: "LOCATION"; value: root.weather-loc; active: root.kb-field == "location"; tapped => { root.open-keyboard("location"); } }
                    HorizontalLayout {
                        spacing: 10px;
                        FieldTap { label: "LATITUDE"; value: root.latitude; active: root.kb-field == "latitude"; tapped => { root.open-keyboard("latitude"); } }
                        FieldTap { label: "LONGITUDE"; value: root.longitude; active: root.kb-field == "longitude"; tapped => { root.open-keyboard("longitude"); } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "UNITS"; color: #7a7a7a; font-size: 14px; font-family: Dy.mono; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Pill { label: root.units-metric ? "°C / km/h" : "°F / mph"; on: true; clicked => { root.toggle-units(); } }
                    }
                    Text { text: "Weather uses Open-Meteo from your coordinates."; color: #555555; font-size: 13px; font-family: Dy.mono; wrap: word-wrap; }
                }
                if root.settings-tab == 1: VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        VerticalLayout {
                            alignment: center;
                            Text { text: "VOICE REPLIES"; color: #e6e6e6; font-size: 18px; font-family: Dy.mono; }
                            Text { text: "Judie speaks answers aloud"; color: #7a7a7a; font-size: 13px; font-family: Dy.mono; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Toggle { on: root.speak-replies; toggled => { root.toggle-speak(); } }
                    }
                    HorizontalLayout {
                        VerticalLayout {
                            alignment: center;
                            Text { text: "MICROPHONE"; color: #e6e6e6; font-size: 18px; font-family: Dy.mono; }
                            Text { text: "Listen from the command palette"; color: #7a7a7a; font-size: 13px; font-family: Dy.mono; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Toggle { on: root.voice-enabled; toggled => { root.toggle-voice(); } }
                    }
                }
                if root.settings-tab == 2: VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 16px;
                        Text { text: "SSID  " + root.wifi-ssid; color: #e6e6e6; font-size: 16px; font-family: Dy.mono; vertical-alignment: center; }
                        Text { text: "IP  " + root.wifi-ip; color: #7a7a7a; font-size: 16px; font-family: Dy.mono; vertical-alignment: center; }
                        Text { text: root.wifi-state; color: #5ce1ff; font-size: 16px; font-family: Dy.mono; vertical-alignment: center; }
                    }
                    Text { text: root.wifi-status; color: #f0a030; font-size: 14px; font-family: Dy.mono; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 10px;
                        Pill { label: "SCAN"; on: true; clicked => { root.scan-wifi(); } }
                        Pill { label: "DISCONNECT"; clicked => { root.disconnect-wifi(); } }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        viewport-height: 16 * 108px;
                        VerticalLayout {
                            spacing: 8px;
                            for net in root.wifi-nets: TouchArea {
                                clicked => { root.pick-wifi(net.ssid); }
                                Rectangle {
                                    height: 100px;
                                    border-width: 1px;
                                    border-color: root.wifi-pick == net.ssid ? #5ce1ff : #3d3d3d;
                                    background: root.wifi-pick == net.ssid ? #0a1a1e : #000000;
                                    HorizontalLayout {
                                        padding-left: 16px; padding-right: 16px;
                                        Text { text: net.ssid; color: #e6e6e6; font-size: 18px; font-family: Dy.mono; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                        Text { text: net.signal; color: #7a7a7a; font-size: 16px; font-family: Dy.mono; vertical-alignment: center; }
                                        Text { text: net.secured ? "LOCK" : "OPEN"; color: #5ce1ff; font-size: 14px; font-family: Dy.mono; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                    FieldTap { label: "ASSISTANT URL"; value: root.assistant-url; active: root.kb-field == "assistant-url"; tapped => { root.open-keyboard("assistant-url"); } }
                    FieldTap { label: "WIFI PASSWORD"; value: root.wifi-pass == "" ? "" : "••••••••"; active: root.kb-field == "wifi-pass"; tapped => { root.open-keyboard("wifi-pass"); } }
                    Pill { label: "CONNECT"; on: true; clicked => { root.connect-wifi(); } }
                }
                if root.settings-tab == 3: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: "TIMERS"; color: #e6e6e6; font-size: 18px; font-family: Dy.mono; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Toggle { on: root.notice-timers; toggled => { root.toggle-notice("timers"); } }
                    }
                    HorizontalLayout {
                        Text { text: "CALENDAR"; color: #e6e6e6; font-size: 18px; font-family: Dy.mono; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Toggle { on: root.notice-calendar; toggled => { root.toggle-notice("calendar"); } }
                    }
                    HorizontalLayout {
                        Text { text: "WEATHER"; color: #e6e6e6; font-size: 18px; font-family: Dy.mono; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Toggle { on: root.notice-weather; toggled => { root.toggle-notice("weather"); } }
                    }
                    HorizontalLayout {
                        Text { text: "AIR QUALITY"; color: #e6e6e6; font-size: 18px; font-family: Dy.mono; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Toggle { on: root.notice-air; toggled => { root.toggle-notice("air"); } }
                    }
                    HorizontalLayout {
                        Text { text: "DEVICES"; color: #e6e6e6; font-size: 18px; font-family: Dy.mono; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Toggle { on: root.notice-devices; toggled => { root.toggle-notice("devices"); } }
                    }
                }
                if root.settings-tab == 4: VerticalLayout {
                    spacing: 10px;
                    for r in root.routines: Rectangle {
                        border-radius: 0px; background: #000000;
                        border-width: 1px; border-color: #3d3d3d;
                        min-height: 100px;
                        HorizontalLayout {
                            padding: 12px; spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Text { text: r.name; color: #e6e6e6; font-size: 18px; font-weight: 600; font-family: Dy.mono; }
                                Text { text: r.hint; color: #7a7a7a; font-size: 13px; font-family: Dy.mono; wrap: word-wrap; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if !r.builtin: Pill { label: "REMOVE"; clicked => { root.remove-routine(r.id); } }
                        }
                    }
                }
                if root.settings-tab == 5: VerticalLayout {
                    spacing: 10px;
                    Text { text: "THIS COPY   JUDIE " + root.version-text; color: #e6e6e6; font-size: 18px; font-weight: 700; font-family: Dy.mono; }
                    Text { text: root.release-status; color: #7a7a7a; font-size: 14px; font-family: Dy.mono; wrap: word-wrap; }
                    Flickable {
                        vertical-stretch: 1;
                        viewport-height: 12 * 108px;
                        VerticalLayout {
                            spacing: 8px;
                            for rel in root.releases: TouchArea {
                                clicked => { root.pick-release(rel.tag); }
                                Rectangle {
                                    height: 100px;
                                    border-width: 1px;
                                    border-color: (root.selected-release == rel.tag || rel.current) ? #5ce1ff : #3d3d3d;
                                    background: root.selected-release == rel.tag ? #0a1a1e : #000000;
                                    HorizontalLayout {
                                        padding-left: 16px; padding-right: 16px;
                                        Text { text: rel.tag; color: #e6e6e6; font-size: 20px; font-family: Dy.mono; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: rel.current ? "CURRENT" : (rel.installable ? "INSTALL" : "N/A"); color: rel.current ? #3dd68c : #7a7a7a; font-size: 14px; font-family: Dy.mono; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        HitBtn { kicker: "GITHUB"; label: "CHECK"; clicked => { root.check-updates(); } }
                        HitBtn { kicker: "SELECTED"; label: "INSTALL"; clicked => { root.install-tag(root.selected-release); } }
                        HitBtn { kicker: "LATEST"; label: "UPDATE"; clicked => { root.update-now(); } }
                        HitBtn { kicker: "SYSTEM"; label: "RESTART"; warn: true; clicked => { root.reboot-now(); } }
                        HitBtn { kicker: "SYSTEM"; label: "SHUT DOWN"; danger: true; clicked => { root.shutdown-now(); } }
                    }
                }
            }
        }
    }

    if root.gallery-open: Rectangle {
        background: #000000cc;
        TouchArea { clicked => { root.close-gallery(); } }
        Rectangle {
            x: parent.width * 0.08;
            y: 48px;
            width: parent.width * 0.84;
            height: parent.height - 96px;
            border-radius: 0px;
            background: #000000;
            border-width: 1px;
            border-color: #3d3d3d;
            TouchArea { clicked => { } }
            HorizontalLayout {
                padding: 16px;
                spacing: 16px;
                VerticalLayout {
                    width: 260px;
                    spacing: 8px;
                    Text { text: "ADD WIDGET"; color: #e6e6e6; font-size: 16px; font-weight: 700; font-family: Dy.mono; }
                    LineEdit {
                        placeholder-text: "Search widgets";
                        text: root.gallery-query;
                        edited(t) => { root.gallery-search(t); }
                    }
                    TouchArea {
                        clicked => { root.open-creator(); }
                        Rectangle {
                            height: 36px; border-radius: 0px; background: #000000;
                            border-width: 1px; border-color: #3d3d3d;
                            Text { text: "OPEN WIDGET CREATOR…"; color: #e6e6e6; font-size: 11px; font-family: Dy.mono; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }
                    TouchArea {
                        clicked => { root.gallery-import(); }
                        Rectangle {
                            height: 32px; border-radius: 0px; background: #000000;
                            border-width: 1px; border-color: #3d3d3d;
                            Text { text: "IMPORT .JSON"; color: #7a7a7a; font-size: 11px; font-family: Dy.mono; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }
                    Text { text: "BUILT-IN"; color: #7a7a7a; font-size: 10px; font-family: Dy.mono; }
                    Flickable {
                        vertical-stretch: 1;
                        viewport-height: 24 * 36px;
                        VerticalLayout {
                            spacing: 4px;
                            for item in root.gallery-items: TouchArea {
                                clicked => {
                                    if item.custom { root.gallery-pick-custom(item.id); } else { root.gallery-pick(item.kind); }
                                }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 0px;
                                    border-width: 1px;
                                    border-color: (item.custom ? item.id == root.gallery-custom-id : root.gallery-kind == item.kind) ? #5ce1ff : #3d3d3d;
                                    background: (item.custom ? item.id == root.gallery-custom-id : root.gallery-kind == item.kind) ? #0a1a1e : #000000;
                                    Text { text: item.label; color: #e6e6e6; font-size: 12px; font-family: Dy.mono; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 10px; horizontal-stretch: 1;
                    HorizontalLayout {
                        Text { text: root.gallery-kind; color: #e6e6e6; font-size: 16px; font-weight: 700; font-family: Dy.mono; }
                        Rectangle { horizontal-stretch: 1; }
                        Pill { label: "✕"; clicked => { root.close-gallery(); } }
                    }
                    Text { text: root.gallery-desc; color: #7a7a7a; font-size: 12px; font-family: Dy.mono; wrap: word-wrap; }
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 0px;
                        background: #000000;
                        border-width: 1px;
                        border-color: #3d3d3d;
                        VerticalLayout {
                            padding: 16px; spacing: 8px; alignment: center;
                            if root.gallery-kind == "weather": VerticalLayout {
                                Text { text: root.weather-loc; color: #7a7a7a; font-size: 12px; font-family: Dy.mono; horizontal-alignment: center; }
                                Text { text: root.weather-temp; color: #e6e6e6; font-size: 28px; font-weight: 700; font-family: Dy.mono; horizontal-alignment: center; }
                                Text { text: root.weather-cond; color: #e6e6e6; font-size: 14px; font-family: Dy.mono; horizontal-alignment: center; }
                            }
                            if root.gallery-kind == "lights": VerticalLayout {
                                Text { text: root.scene; color: #7a7a7a; font-size: 12px; font-family: Dy.mono; horizontal-alignment: center; }
                                Text { text: root.brightness + "%"; color: #e6e6e6; font-size: 28px; font-weight: 700; font-family: Dy.mono; horizontal-alignment: center; }
                            }
                            if root.gallery-kind == "media": VerticalLayout {
                                Text { text: root.track-title; color: #e6e6e6; font-size: 16px; font-weight: 600; font-family: Dy.mono; horizontal-alignment: center; }
                                Text { text: root.track-artist; color: #7a7a7a; font-size: 12px; font-family: Dy.mono; horizontal-alignment: center; }
                            }
                            if root.gallery-kind != "weather" && root.gallery-kind != "lights" && root.gallery-kind != "media": VerticalLayout {
                                Text { text: root.gallery-kind; color: #e6e6e6; font-size: 18px; font-weight: 700; font-family: Dy.mono; horizontal-alignment: center; }
                                Text { text: root.gallery-size == "1x1" ? "Small" : (root.gallery-size == "1x2" ? "Medium" : "Large"); color: #7a7a7a; font-size: 13px; font-family: Dy.mono; horizontal-alignment: center; }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: center; spacing: 10px;
                        Pill { label: "⟨"; clicked => { root.gallery-size-prev(); } }
                        Text { text: root.gallery-size == "1x1" ? "SMALL" : (root.gallery-size == "1x2" ? "MEDIUM" : "LARGE"); color: #e6e6e6; font-size: 12px; font-family: Dy.mono; vertical-alignment: center; }
                        Pill { label: "⟩"; clicked => { root.gallery-size-next(); } }
                    }
                    Pill { label: "ADD TO HOME"; on: true; clicked => { root.gallery-add(); } }
                }
            }
        }
    }

    if root.creator-open: Rectangle {
        background: #000000cc;
        TouchArea { clicked => { root.close-creator(); } }
        Rectangle {
            x: parent.width * 0.04;
            y: 24px;
            width: parent.width * 0.92;
            height: parent.height - 48px;
            border-radius: 0px;
            background: #000000;
            border-width: 1px;
            border-color: #3d3d3d;
            TouchArea { clicked => { } }
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    Text { text: "WIDGET CREATOR"; color: #e6e6e6; font-size: 16px; font-weight: 700; font-family: Dy.mono; }
                    Rectangle { horizontal-stretch: 1; }
                    Pill { label: "SAVE TO HOME"; on: true; clicked => { root.save-creator(); } }
                    Pill { label: "CLOSE"; clicked => { root.close-creator(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit { placeholder-text: "Untitled"; text: root.creator-name; edited(t) => { root.creator-name-changed(t); } }
                    Pill { label: "1×1"; on: root.creator-size == "1x1"; clicked => { root.set-creator-size("1x1"); } }
                    Pill { label: "1×2"; on: root.creator-size == "1x2"; clicked => { root.set-creator-size("1x2"); } }
                    Pill { label: "2×2"; on: root.creator-size == "2x2"; clicked => { root.set-creator-size("2x2"); } }
                    Pill { label: "Blank"; on: root.creator-template == "blank"; clicked => { root.set-creator-template("blank"); } }
                    Pill { label: "Stat"; on: root.creator-template == "stat"; clicked => { root.set-creator-template("stat"); } }
                    Pill { label: "Status"; on: root.creator-template == "status"; clicked => { root.set-creator-template("status"); } }
                    Pill { label: "Controls"; on: root.creator-template == "controls"; clicked => { root.set-creator-template("controls"); } }
                    Pill { label: "List"; on: root.creator-template == "list"; clicked => { root.set-creator-template("list"); } }
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        width: 160px;
                        spacing: 6px;
                        Text { text: "Palette"; color: #7a7a7a; font-size: 11px; }
                        for k in ["text", "metric", "icon", "bar", "gauge", "button", "chip", "list", "pair", "toggle", "chart", "divider", "box"]: TouchArea {
                            clicked => { root.add-creator-kind(k); }
                            Rectangle {
                                height: 28px; border-radius: 0px; background: #000000;
                                border-width: 1px; border-color: #3d3d3d;
                                Text { text: k; color: #e6e6e6; font-size: 11px; font-family: Dy.mono; vertical-alignment: center; horizontal-alignment: center; }
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 0px;
                        background: #000000;
                        border-width: 1px;
                        border-color: #3d3d3d;
                        for n in root.creator-nodes: TouchArea {
                            x: parent.width * n.x / 100;
                            y: parent.height * n.y / 100;
                            width: parent.width * n.w / 100;
                            height: parent.height * n.h / 100;
                            clicked => { root.select-creator-node(n.id); }
                            Rectangle {
                                border-radius: 0px;
                                border-width: root.creator-selected == n.id ? 2px : 0px;
                                border-color: #5ce1ff;
                                background: (n.kind == "button" || n.kind == "chip" || n.kind == "bar" || n.kind == "box") ? rgb(n.r, n.g, n.b) : #00000000;
                                Text {
                                    text: n.text;
                                    color: rgb(n.r, n.g, n.b);
                                    font-size: n.kind == "metric" ? 28px : 13px;
                                    font-weight: n.kind == "metric" ? 700 : 500;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        width: 240px;
                        spacing: 8px;
                        Text { text: "Inspector"; color: #7a7a7a; font-size: 11px; }
                        Text { text: root.creator-selected == "" ? "Select a part" : root.creator-selected; color: #e6e6e6; font-size: 13px; overflow: elide; }
                        LineEdit {
                            placeholder-text: "Text";
                            text: root.creator-node-text;
                            edited(t) => { root.creator-node-text-changed(t); }
                        }
                        Pill { label: "Delete part"; clicked => { root.delete-creator-node(); } }
                    }
                }
            }
        }
    }

    if root.expanded == "weather": Rectangle {
        background: #000000cc;
        TouchArea { clicked => { root.collapse(); } }
        Rectangle {
            x: 40px; y: 40px; width: parent.width - 80px; height: parent.height - 80px;
            border-radius: 0px; background: #000000;
            border-width: 1px; border-color: #3d3d3d;
            VerticalLayout {
                padding: 24px; spacing: 12px;
                HorizontalLayout {
                    Text { text: root.weather-loc; color: #e6e6e6; font-size: 22px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; }
                    Pill { label: "CLOSE"; clicked => { root.collapse(); } }
                }
                Text { text: root.weather-temp + "  " + root.weather-cond; color: #e6e6e6; font-size: 42px; font-weight: 700; }
                Text { text: root.weather-range + "  ·  " + root.weather-feel; color: #7a7a7a; font-size: 16px; }
                Text { text: root.weather-note; color: #e6e6e6; font-size: 16px; }
                HorizontalLayout {
                    spacing: 16px;
                    for h in root.hours: VerticalLayout {
                        spacing: 4px;
                        Text { text: h.hour; color: #555555; font-size: 12px; horizontal-alignment: center; }
                        Text { text: h.temp; color: #e6e6e6; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: h.precip; color: #7a7a7a; font-size: 12px; horizontal-alignment: center; }
                    }
                }
            }
        }
    }

    if root.expanded == "lights": Rectangle {
        background: #000000cc;
        TouchArea { clicked => { root.collapse(); } }
        Rectangle {
            x: 40px; y: 40px; width: parent.width - 80px; height: parent.height - 80px;
            border-radius: 0px; background: #000000;
            border-width: 1px; border-color: #3d3d3d;
            VerticalLayout {
                padding: 24px; spacing: 14px;
                HorizontalLayout {
                    Text { text: "LIGHTS"; color: #e6e6e6; font-size: 18px; font-weight: 700; font-family: Dy.mono; }
                    Rectangle { horizontal-stretch: 1; }
                    Toggle { on: root.master-on; toggled => { root.toggle-master(); } }
                    Pill { label: "CLOSE"; clicked => { root.collapse(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Pill { label: "Cozy"; on: root.scene == "Cozy"; clicked => { root.set-scene("Cozy"); } }
                    Pill { label: "Movie"; on: root.scene == "Movie"; clicked => { root.set-scene("Movie"); } }
                    Pill { label: "Night"; on: root.scene == "Night"; clicked => { root.set-scene("Night"); } }
                    Pill { label: "Bright"; on: root.scene == "Bright"; clicked => { root.set-scene("Bright"); } }
                    Pill { label: "Gaming"; on: root.scene == "Gaming"; clicked => { root.set-scene("Gaming"); } }
                }
                Text { text: root.brightness + "%"; color: #e6e6e6; font-size: 28px; font-weight: 700; }
                Slider { minimum: 0; maximum: 100; value: root.brightness; changed(v) => { root.brightness-changed(round(v)); } }
                HorizontalLayout {
                    spacing: 8px;
                    Swatch { swatch: #ff5a5a; on: root.master-color == "#FF5A5A"; clicked => { root.set-color("#FF5A5A"); } }
                    Swatch { swatch: #ff8c42; on: root.master-color == "#FF8C42"; clicked => { root.set-color("#FF8C42"); } }
                    Swatch { swatch: #ffd166; on: root.master-color == "#FFD166"; clicked => { root.set-color("#FFD166"); } }
                    Swatch { swatch: #7cf29c; on: root.master-color == "#7CF29C"; clicked => { root.set-color("#7CF29C"); } }
                    Swatch { swatch: #5ce1ff; on: root.master-color == "#2D7BFF"; clicked => { root.set-color("#2D7BFF"); } }
                    Swatch { swatch: #7b61ff; on: root.master-color == "#7B61FF"; clicked => { root.set-color("#7B61FF"); } }
                    Swatch { swatch: #ff6bcb; on: root.master-color == "#FF6BCB"; clicked => { root.set-color("#FF6BCB"); } }
                    Swatch { swatch: #ffffff; on: root.master-color == "#FFFFFF"; clicked => { root.set-color("#FFFFFF"); } }
                }
                for light in root.lights: HorizontalLayout {
                    Text { text: light.name; color: #e6e6e6; font-size: 16px; vertical-alignment: center; }
                    Text { text: light.brightness; color: #7a7a7a; font-size: 14px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Pill { label: light.on ? "On" : "Off"; on: light.on; clicked => { root.toggle-light(light.id); } }
                }
            }
        }
    }

    if root.expanded == "media": Rectangle {
        background: #000000cc;
        TouchArea { clicked => { root.collapse(); } }
        Rectangle {
            x: 40px; y: 40px; width: parent.width - 80px; height: parent.height - 80px;
            border-radius: 0px; background: #000000;
            border-width: 1px; border-color: #3d3d3d;
            VerticalLayout {
                padding: 24px; spacing: 14px;
                HorizontalLayout {
                    Text { text: "NOW PLAYING"; color: #e6e6e6; font-size: 18px; font-weight: 700; font-family: Dy.mono; }
                    Rectangle { horizontal-stretch: 1; }
                    Pill { label: "CLOSE"; clicked => { root.collapse(); } }
                }
                Text { text: root.track-title; color: #e6e6e6; font-size: 32px; font-weight: 700; }
                Text { text: root.track-artist; color: #7a7a7a; font-size: 16px; }
                Bar { level: root.media-progress; fill: #e6e6e6; }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;
                    IconBtn { glyph: "⟨"; clicked => { root.prev-track(); } }
                    IconBtn { glyph: root.playing ? "❚❚" : "▶"; primary: true; clicked => { root.toggle-play(); } }
                    IconBtn { glyph: "⟩"; clicked => { root.next-track(); } }
                }
                Text { text: "Volume " + root.volume + "%"; color: #7a7a7a; font-size: 13px; }
                Slider { minimum: 0; maximum: 100; value: root.volume; changed(v) => { root.volume-changed(round(v)); } }
            }
        }
    }

    if root.expanded == "calendar": Rectangle {
        background: #000000cc;
        TouchArea { clicked => { root.collapse(); } }
        Rectangle {
            x: 40px; y: 40px; width: parent.width - 80px; height: parent.height - 80px;
            border-radius: 0px; background: #000000;
            border-width: 1px; border-color: #3d3d3d;
            VerticalLayout {
                padding: 24px; spacing: 12px;
                HorizontalLayout {
                    Text { text: root.month-name; color: #e6e6e6; font-size: 22px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; }
                    Pill { label: "CLOSE"; clicked => { root.collapse(); } }
                }
                for ev in root.events: HorizontalLayout {
                    spacing: 12px;
                    Text { text: ev.time; color: #7a7a7a; font-size: 14px; min-width: 64px; }
                    VerticalLayout {
                        Text { text: ev.title; color: #e6e6e6; font-size: 16px; font-weight: 600; }
                        Text { text: ev.detail; color: #7a7a7a; font-size: 12px; }
                    }
                }
            }
        }
    }

    if root.expanded == "purifier": Rectangle {
        background: #000000cc;
        TouchArea { clicked => { root.collapse(); } }
        Rectangle {
            x: 40px; y: 40px; width: parent.width - 80px; height: parent.height - 80px;
            border-radius: 0px; background: #000000;
            border-width: 1px; border-color: #3d3d3d;
            VerticalLayout {
                padding: 24px; spacing: 14px;
                HorizontalLayout {
                    Text { text: "AIR PURIFIER"; color: #e6e6e6; font-size: 18px; font-weight: 700; font-family: Dy.mono; }
                    Rectangle { horizontal-stretch: 1; }
                    Toggle { on: root.purifier-on; toggled => { root.toggle-purifier(); } }
                    Pill { label: "CLOSE"; clicked => { root.collapse(); } }
                }
                Text { text: root.purifier-aq; color: #3dd68c; font-size: 36px; font-weight: 700; }
                Text { text: "PM2.5  7 µg/m³   ·   Allergens  4/12"; color: #e6e6e6; font-size: 16px; }
                HorizontalLayout {
                    spacing: 8px;
                    Pill { label: "Auto"; on: root.purifier-mode == "Auto"; clicked => { root.set-purifier-mode("Auto"); } }
                    Pill { label: "Sleep"; on: root.purifier-mode == "Sleep"; clicked => { root.set-purifier-mode("Sleep"); } }
                    Pill { label: "Boost"; on: root.purifier-mode == "Manual"; clicked => { root.set-purifier-mode("Manual"); } }
                }
                Text { text: "Filter " + root.purifier-filter + "%"; color: #7a7a7a; font-size: 14px; }
                Bar { level: root.purifier-filter / 100; fill: #3dd68c; }
            }
        }
    }

    if root.kb-open: Rectangle {
        y: parent.height - 540px;
        width: 100%;
        height: 540px;
        background: #000000;
        border-width: 1px;
        border-color: #3d3d3d;
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: root.kb-field; color: #7a7a7a; font-size: 14px; font-family: Dy.mono; vertical-alignment: center; }
                Text { text: root.kb-text; color: #e6e6e6; font-size: 20px; font-family: Dy.mono; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Pill { label: "HIDE"; clicked => { root.keyboard-close(); } }
            }
            if !root.kb-symbols: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    KeyBtn { glyph: "Q"; clicked => { root.keyboard-key("q"); } }
                    KeyBtn { glyph: "W"; clicked => { root.keyboard-key("w"); } }
                    KeyBtn { glyph: "E"; clicked => { root.keyboard-key("e"); } }
                    KeyBtn { glyph: "R"; clicked => { root.keyboard-key("r"); } }
                    KeyBtn { glyph: "T"; clicked => { root.keyboard-key("t"); } }
                    KeyBtn { glyph: "Y"; clicked => { root.keyboard-key("y"); } }
                    KeyBtn { glyph: "U"; clicked => { root.keyboard-key("u"); } }
                    KeyBtn { glyph: "I"; clicked => { root.keyboard-key("i"); } }
                    KeyBtn { glyph: "O"; clicked => { root.keyboard-key("o"); } }
                    KeyBtn { glyph: "P"; clicked => { root.keyboard-key("p"); } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    KeyBtn { glyph: "A"; clicked => { root.keyboard-key("a"); } }
                    KeyBtn { glyph: "S"; clicked => { root.keyboard-key("s"); } }
                    KeyBtn { glyph: "D"; clicked => { root.keyboard-key("d"); } }
                    KeyBtn { glyph: "F"; clicked => { root.keyboard-key("f"); } }
                    KeyBtn { glyph: "G"; clicked => { root.keyboard-key("g"); } }
                    KeyBtn { glyph: "H"; clicked => { root.keyboard-key("h"); } }
                    KeyBtn { glyph: "J"; clicked => { root.keyboard-key("j"); } }
                    KeyBtn { glyph: "K"; clicked => { root.keyboard-key("k"); } }
                    KeyBtn { glyph: "L"; clicked => { root.keyboard-key("l"); } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    KeyBtn { glyph: "⇧"; clicked => { root.kb-toggle-shift(); } }
                    KeyBtn { glyph: "Z"; clicked => { root.keyboard-key("z"); } }
                    KeyBtn { glyph: "X"; clicked => { root.keyboard-key("x"); } }
                    KeyBtn { glyph: "C"; clicked => { root.keyboard-key("c"); } }
                    KeyBtn { glyph: "V"; clicked => { root.keyboard-key("v"); } }
                    KeyBtn { glyph: "B"; clicked => { root.keyboard-key("b"); } }
                    KeyBtn { glyph: "N"; clicked => { root.keyboard-key("n"); } }
                    KeyBtn { glyph: "M"; clicked => { root.keyboard-key("m"); } }
                    KeyBtn { glyph: "⌫"; clicked => { root.keyboard-back(); } }
                }
            }
            if root.kb-symbols: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    KeyBtn { glyph: "1"; clicked => { root.keyboard-key("1"); } }
                    KeyBtn { glyph: "2"; clicked => { root.keyboard-key("2"); } }
                    KeyBtn { glyph: "3"; clicked => { root.keyboard-key("3"); } }
                    KeyBtn { glyph: "4"; clicked => { root.keyboard-key("4"); } }
                    KeyBtn { glyph: "5"; clicked => { root.keyboard-key("5"); } }
                    KeyBtn { glyph: "6"; clicked => { root.keyboard-key("6"); } }
                    KeyBtn { glyph: "7"; clicked => { root.keyboard-key("7"); } }
                    KeyBtn { glyph: "8"; clicked => { root.keyboard-key("8"); } }
                    KeyBtn { glyph: "9"; clicked => { root.keyboard-key("9"); } }
                    KeyBtn { glyph: "0"; clicked => { root.keyboard-key("0"); } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    KeyBtn { glyph: "-"; clicked => { root.keyboard-key("-"); } }
                    KeyBtn { glyph: "_"; clicked => { root.keyboard-key("_"); } }
                    KeyBtn { glyph: "="; clicked => { root.keyboard-key("="); } }
                    KeyBtn { glyph: "/"; clicked => { root.keyboard-key("/"); } }
                    KeyBtn { glyph: ":"; clicked => { root.keyboard-key(":"); } }
                    KeyBtn { glyph: "."; clicked => { root.keyboard-key("."); } }
                    KeyBtn { glyph: ","; clicked => { root.keyboard-key(","); } }
                    KeyBtn { glyph: "@"; clicked => { root.keyboard-key("@"); } }
                    KeyBtn { glyph: "?"; clicked => { root.keyboard-key("?"); } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    KeyBtn { glyph: "#"; clicked => { root.keyboard-key("#"); } }
                    KeyBtn { glyph: "+"; clicked => { root.keyboard-key("+"); } }
                    KeyBtn { glyph: "&"; clicked => { root.keyboard-key("&"); } }
                    KeyBtn { glyph: "%"; clicked => { root.keyboard-key("%"); } }
                    KeyBtn { glyph: "*"; clicked => { root.keyboard-key("*"); } }
                    KeyBtn { glyph: "("; clicked => { root.keyboard-key("("); } }
                    KeyBtn { glyph: ")"; clicked => { root.keyboard-key(")"); } }
                    KeyBtn { glyph: "["; clicked => { root.keyboard-key("["); } }
                    KeyBtn { glyph: "]"; clicked => { root.keyboard-key("]"); } }
                    KeyBtn { glyph: "⌫"; clicked => { root.keyboard-back(); } }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                KeyBtn { glyph: "123"; clicked => { root.kb-toggle-symbols(); } }
                KeyBtn { glyph: "SPACE"; wide: true; clicked => { root.keyboard-key(" "); } }
                KeyBtn { glyph: "DONE"; wide: true; clicked => { root.keyboard-submit(); } }
            }
        }
    }
}
