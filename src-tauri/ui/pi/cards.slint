export component HitBtn inherits Rectangle {
    in property <string> label;
    in property <string> kicker;
    in property <bool> danger: false;
    in property <bool> warn: false;
    callback clicked;
    min-width: 140px;
    min-height: 72px;
    border-radius: 0px;
    border-width: Dy.stroke;
    border-color: Dy.dim;
    background: Dy.bg;
    TouchArea { clicked => { root.clicked(); } }
    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        alignment: center;
        if root.kicker != "": Text {
            text: root.kicker;
            color: Dy.dim;
            font-size: 11px;
            font-family: Dy.mono;
            horizontal-alignment: center;
        }
        Text {
            text: root.label;
            color: Dy.text;
            font-size: 16px;
            font-weight: 700;
            font-family: Dy.mono;
            horizontal-alignment: center;
        }
    }
}

export component FieldTap inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> error: "";
    in property <bool> active: false;
    in property <bool> locked: false;
    in property <length> label-size: 11px;
    in property <length> value-size: 16px;
    in property <length> tap-height: 64px;
    callback tapped;
    height: root.tap-height;
    border-width: 0px;
    background: Dy.bg;
    TouchArea {
        enabled: !root.locked;
        clicked => { root.tapped(); }
    }
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            padding-left: 0px;
            padding-right: 0px;
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.label; color: Dy.dim; font-size: root.label-size; font-family: Dy.mono; }
            Rectangle {
                height: 1.5px;
                background: root.active ? Dy.text : Dy.line;
            }
            Text {
                text: root.value == "" ? "Tap to type" : root.value;
                color: Dy.text;
                font-size: root.value-size;
                font-family: Dy.mono;
                overflow: elide;
            }
        }
        if root.error != "": Text {
            text: root.error;
            color: Dy.text;
            font-size: 14px;
            font-family: Dy.mono;
            vertical-alignment: center;
            wrap: word-wrap;
            width: 148px;
        }
    }
}

export component RoutineCard inherits Rectangle {
    in property <RoutineRow> item;
    in property <string> kb-field: "";
    callback edit-name;
    callback edit-phrase;
    callback edit-command;
    callback save;
    callback cancel;
    callback duplicate;
    callback toggle-enabled;
    callback delete;
    border-width: Dy.stroke;
    border-color: Dy.line;
    background: Dy.bg;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            height: 44px;
            Text {
                text: root.item.status;
                color: Dy.dim;
                font-size: 13px;
                font-family: Dy.mono;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            Pill { label: "Duplicate"; clicked => { root.duplicate(); } }
            Pill {
                label: root.item.enabled ? "Disable" : "Enable";
                clicked => { root.toggle-enabled(); }
            }
            Pill { label: "Delete"; clicked => { root.delete(); } }
        }
        FieldTap {
            label: "Routine name";
            value: root.item.name;
            error: root.item.name-error;
            active: root.kb-field == "routine-name:" + root.item.id;
            locked: root.item.builtin;
            label-size: 13px;
            value-size: 18px;
            tap-height: 56px;
            tapped => { root.edit-name(); }
        }
        FieldTap {
            label: "When you say";
            value: root.item.phrase;
            error: root.item.phrase-error;
            active: root.kb-field == "routine-phrase:" + root.item.id;
            locked: root.item.builtin;
            label-size: 13px;
            value-size: 18px;
            tap-height: 56px;
            tapped => { root.edit-phrase(); }
        }
        FieldTap {
            label: "Judie should";
            value: root.item.command;
            error: root.item.command-error;
            active: root.kb-field == "routine-command:" + root.item.id;
            locked: root.item.builtin;
            label-size: 13px;
            value-size: 18px;
            tap-height: 56px;
            tapped => { root.edit-command(); }
        }
        HorizontalLayout {
            spacing: 8px;
            height: 44px;
            Pill {
                label: "Save";
                on: true;
                opacity: (!root.item.builtin && root.item.dirty && root.item.valid) ? 1 : 0.35;
                clicked => { root.save(); }
            }
            Pill {
                label: "Cancel";
                opacity: (root.item.dirty || root.item.is-new) ? 1 : 0.35;
                clicked => { root.cancel(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

export component KeyBtn inherits Rectangle {
    in property <string> glyph;
    in property <string> sub: "";
    in property <bool> wide: false;
    in property <float> u: 1;
    in property <bool> on: false;
    in property <bool> has-icon: false;
    in property <image> icon;
    callback clicked;
    min-width: 28px;
    min-height: Dy.hit-target;
    horizontal-stretch: root.u;
    vertical-stretch: 1;
    border-width: Dy.stroke;
    border-color: (root.on || ta.pressed) ? Dy.text : Dy.line;
    background: (root.on || ta.pressed) ? Dy.panel : Dy.bg;
    ta := TouchArea { clicked => { root.clicked(); } }
    out property <bool> down: ta.pressed;
    if root.has-icon: Image {
        source: root.icon;
        width: 40px;
        height: 40px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }
    if !root.has-icon: Text {
        text: root.glyph;
        color: Dy.text;
        font-size: Dy.type-control + 4px;
        font-weight: 600;
        font-family: Dy.mono;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.sub != "": Text {
        x: 4px;
        y: 3px;
        text: root.sub;
        color: Dy.line;
        font-size: Dy.type-dense;
        font-family: Dy.mono;
    }
}

// Segmented level bar: whole segments only, filled = fill, empty = line.
// With `interactive`, a tap or drag picks the level (0..100) via `changed`.
export component Bar inherits Rectangle {
    in property <float> level;
    in property <color> fill: Dy.accent1;
    in property <float> zoom: 1.0;
    in property <int> segments: 10;
    in property <bool> interactive: false;
    callback changed(int);
    property <int> lit: round(clamp(root.level, 0, 1) * root.segments);
    property <length> seg-gap: 3px;
    property <length> seg-w: (root.width - root.seg-gap * (root.segments - 1)) / root.segments;
    height: root.interactive ? 28px * root.zoom : 8px * root.zoom;
    background: transparent;
    for i in root.segments: Rectangle {
        x: i * (root.seg-w + root.seg-gap);
        width: root.seg-w;
        background: i < root.lit ? root.fill : Dy.line;
    }
    if root.interactive: TouchArea {
        function pick() {
            root.changed(round(clamp(self.mouse-x / root.width, 0, 1) * root.segments) * 100 / root.segments);
        }
        pointer-event(ev) => { if ev.kind == PointerEventKind.down { self.pick(); } }
        moved => { if self.pressed { self.pick(); } }
    }
}

