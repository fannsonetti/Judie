export struct LightRow {
    id: string,
    name: string,
    on: bool,
    brightness: string,
}

export struct HourRow {
    hour: string,
    temp: string,
    precip: string,
}

export struct EventRow {
    time: string,
    title: string,
    detail: string,
}

export struct ServiceRow {
    name: string,
    status: string,
    online: bool,
}

export struct ActivityRow {
    title: string,
    source: string,
}

export struct TimerRow {
    label: string,
    remain: string,
}

export component Card inherits Rectangle {
    in property <string> kicker;
    in property <bool> expandable: false;
    callback tapped;
    background: #14161c;
    border-radius: 22px;
    clip: true;

    TouchArea {
        clicked => { root.tapped(); }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        @children
    }
}

export component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    callback clicked;
    border-radius: 12px;
    background: root.on ? #2d7bff : #22252f;
    height: 28px;
    min-width: 64px;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: #f4f5f7;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> on;
    callback toggled;
    width: 44px;
    height: 26px;
    border-radius: 13px;
    background: root.on ? #2d7bff : #2a2e3a;
    TouchArea {
        clicked => {
            root.on = !root.on;
            root.toggled();
        }
    }
    Rectangle {
        x: root.on ? parent.width - 22px : 2px;
        y: 2px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: #f4f5f7;
    }
}

export component Swatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> on;
    callback clicked;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background: root.swatch;
    border-width: root.on ? 2px : 0px;
    border-color: #f4f5f7;
    TouchArea { clicked => { root.clicked(); } }
}

export component IconBtn inherits Rectangle {
    in property <string> glyph;
    in property <bool> primary: false;
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: root.primary ? #f4f5f7 : #22252f;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.glyph;
        color: root.primary ? #0c0d10 : #f4f5f7;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Bar inherits Rectangle {
    in property <float> level;
    in property <color> fill: #2d7bff;
    height: 6px;
    border-radius: 3px;
    background: #27272a;
    Rectangle {
        width: parent.width * clamp(root.level, 0, 1);
        height: 100%;
        border-radius: 3px;
        background: root.fill;
    }
}
