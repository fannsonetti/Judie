}

export component NetGlyph inherits Rectangle {
    in property <string> kind: "wifi";
    in property <int> bars: 0;
    in property <float> zoom: 1.0;
    width: 28px * root.zoom;
    height: 22px * root.zoom;
    background: transparent;

    if root.kind == "ethernet": Rectangle {
        background: transparent;
        Rectangle { x: 10px * root.zoom; y: 2px * root.zoom; width: 8px * root.zoom; height: 6px * root.zoom; background: Dy.text; }
        Rectangle { x: 4px * root.zoom; y: 8px * root.zoom; width: 20px * root.zoom; height: 3px * root.zoom; background: Dy.text; }
        Rectangle { x: 6px * root.zoom; y: 11px * root.zoom; width: 3px * root.zoom; height: 8px * root.zoom; background: Dy.text; }
        Rectangle { x: 12.5px * root.zoom; y: 11px * root.zoom; width: 3px * root.zoom; height: 8px * root.zoom; background: Dy.text; }
        Rectangle { x: 19px * root.zoom; y: 11px * root.zoom; width: 3px * root.zoom; height: 8px * root.zoom; background: Dy.text; }
    }

    if root.kind != "ethernet": Rectangle {
        background: transparent;
        Rectangle { x: 2px * root.zoom; y: 16px * root.zoom; width: 5px * root.zoom; height: 4px * root.zoom; background: root.bars >= 1 ? Dy.text : Dy.line; }
        Rectangle { x: 8px * root.zoom; y: 12px * root.zoom; width: 5px * root.zoom; height: 8px * root.zoom; background: root.bars >= 2 ? Dy.text : Dy.line; }
        Rectangle { x: 14px * root.zoom; y: 7px * root.zoom; width: 5px * root.zoom; height: 13px * root.zoom; background: root.bars >= 3 ? Dy.text : Dy.line; }
        Rectangle { x: 20px * root.zoom; y: 2px * root.zoom; width: 5px * root.zoom; height: 18px * root.zoom; background: root.bars >= 4 ? Dy.text : Dy.line; }
        if root.bars <= 0: Text {
            x: 14px * root.zoom;
            y: 8px * root.zoom;
            text: "×";
            color: Dy.text;
            font-size: 14px * root.zoom;
            font-weight: 700;
            font-family: Dy.mono;
        }
    }
}

export component ConfirmSheet inherits Rectangle {
    in property <string> title: "";
    in property <string> body: "";
    in property <string> primary: "Continue";
    in property <string> secondary: "Cancel";
    in property <bool> danger: false;
    in property <length> box-height: 400px;
    callback accept;
    callback dismiss;
    background: Dy.bg.with-alpha(0.8);
    TouchArea { clicked => { root.dismiss(); } }
    Rectangle {
        x: parent.width * 0.18;
        y: parent.height * 0.18;
        width: parent.width * 0.64;
        height: root.box-height;
        background: Dy.bg;
        border-width: Dy.stroke;
        border-color: Dy.dim;
        TouchArea { clicked => { } }
        VerticalLayout {
            padding: 28px;
            spacing: 16px;
            Text {
                text: root.title;
                color: Dy.text;
                font-size: 20px;
                font-weight: 700;
                font-family: Dy.mono;
            }
            Text {
                text: root.body;
                color: Dy.dim;
                font-size: 14px;
                font-family: Dy.mono;
                wrap: word-wrap;
                vertical-stretch: 1;
            }
            HorizontalLayout {
                spacing: 12px;
                Pill { label: root.secondary; clicked => { root.dismiss(); } }
                Rectangle { horizontal-stretch: 1; }
                Pill { label: root.primary; on: true; clicked => { root.accept(); } }
            }
        }
    }
}

export component WidgetRemoveBtn inherits Rectangle {
    in property <bool> active: true;
    in property <string> label: "Remove widget";
    callback remove;
    property <bool> fired: false;
    width: 40px;
    height: 40px;
    background: Dy.text;
    border-radius: 0px;
    border-width: 0px;
    clip: false;
    visible: root.active;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => {
        if root.active && !root.fired {
            root.fired = true;
            root.remove();
        }
    }

    TouchArea {
        enabled: root.active;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down {
                root.fired = false;
            }
            if ev.kind == PointerEventKind.cancel {
                root.fired = false;
            }
            if ev.kind == PointerEventKind.up && root.active && !root.fired {
                root.fired = true;
                root.remove();
            }
        }
        clicked => {
            if root.active && !root.fired {
                root.fired = true;
                root.remove();
            }
        }
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 40;
        viewbox-height: 40;
        fill: transparent;
        stroke: Dy.bg;
        stroke-width: 4px;
        commands: "M 10 10 L 30 30 M 30 10 L 10 30";
    }
}

export component TileShell inherits Rectangle {
    in property <bool> editing: false;
    in property <bool> pending: false;
    in property <bool> ghost: false;
    in property <bool> layer: false;
    in property <bool> show-border: true;
    in property <length> vis-x: 0px;
    in property <length> vis-y: 0px;
    callback tapped;
    callback held;
    callback remove;
    callback drag-begin(length, length);
    callback drag-move(length, length);
    callback drag-end();
    callback drag-cancel();
    background: transparent;
    border-radius: 0px;
    border-width: 0px;
    clip: false;

    ta := TouchArea {
        enabled: !root.layer;
        clicked => { if !root.editing { root.tapped(); } }
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && root.editing {
                if self.mouse-x < parent.width - 20px || self.mouse-y > 20px {
                    root.drag-begin(self.mouse-x, self.mouse-y);
                }
            }
            if ev.kind == PointerEventKind.up && root.editing {
                root.drag-end();
            }
            if ev.kind == PointerEventKind.cancel && root.editing {
                root.drag-cancel();
            }
        }
        moved => {
            if root.editing && self.pressed {
                root.drag-move(self.mouse-x, self.mouse-y);
            }
        }
    }
    Timer {
        interval: 450ms;
        running: ta.pressed && !root.editing;
        triggered => { root.held(); }
    }

    face := Rectangle {
        x: root.vis-x;
        y: root.vis-y;
        width: parent.width;
        height: parent.height;
        opacity: root.ghost ? 0 : 1;
        background: Dy.panel;
        border-radius: 0px;
        border-width: root.show-border ? Dy.stroke : 0px;
        border-color: root.pending ? Dy.accent3 : Dy.line;
        clip: true;
        VerticalLayout {
            padding: Dy.pad;
            spacing: 6px * Dy.ui-scale;
            @children
        }
    }

    // Drag clone only: interactive badges live in the home overlay so they
    // paint above neighbouring tiles and never start a drag.
    if root.editing && !root.ghost && root.layer: Rectangle {
        x: parent.width + root.vis-x - 20px;
        y: root.vis-y - 20px;
        width: 40px;
        height: 40px;
        background: Dy.text;
        border-radius: 0px;
        border-width: 0px;
        Text {
            width: 100%;
            height: 100%;
            text: "×";
            color: Dy.bg;
            font-size: 28px;
            font-weight: 700;
            font-family: Dy.mono;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // The drag portal is visual-only. Keep live controls from stealing the grab.
    if root.layer: TouchArea {
        width: 100%;
        height: 100%;
    }
}

export struct Px { x: float, y: float }

// 8x8 bitmap icon (spec rule 5). Scale by whole numbers only: 2 inline, 4 in tiles.
export component PixIcon inherits Rectangle {
    in property <string> name;
    in property <int> scale: 2;
    in property <color> fill: Dy.text;
    width: 8px * root.scale;
    height: 8px * root.scale;
    background: transparent;
    property <[Px]> sun: [{x:3,y:0},{x:0,y:1},{x:3,y:1},{x:6,y:1},{x:1,y:2},{x:2,y:2},{x:3,y:2},{x:4,y:2},{x:5,y:2},{x:0,y:3},{x:1,y:3},{x:2,y:3},{x:3,y:3},{x:4,y:3},{x:5,y:3},{x:7,y:3},{x:0,y:4},{x:2,y:4},{x:3,y:4},{x:4,y:4},{x:5,y:4},{x:6,y:4},{x:1,y:5},{x:2,y:5},{x:3,y:5},{x:4,y:5},{x:5,y:5},{x:0,y:6},{x:3,y:6},{x:6,y:6},{x:3,y:7}];
    property <[Px]> bulb: [{x:2,y:0},{x:3,y:0},{x:4,y:0},{x:5,y:0},{x:1,y:1},{x:2,y:1},{x:3,y:1},{x:4,y:1},{x:5,y:1},{x:6,y:1},{x:1,y:2},{x:2,y:2},{x:3,y:2},{x:4,y:2},{x:5,y:2},{x:6,y:2},{x:1,y:3},{x:2,y:3},{x:3,y:3},{x:4,y:3},{x:5,y:3},{x:6,y:3},{x:2,y:4},{x:3,y:4},{x:4,y:4},{x:5,y:4},{x:2,y:5},{x:5,y:5},{x:2,y:6},{x:3,y:6},{x:4,y:6},{x:5,y:6},{x:3,y:7},{x:4,y:7}];
    property <[Px]> vol: [{x:3,y:0},{x:2,y:1},{x:3,y:1},{x:6,y:1},{x:0,y:2},{x:1,y:2},{x:2,y:2},{x:3,y:2},{x:5,y:2},{x:0,y:3},{x:1,y:3},{x:2,y:3},{x:3,y:3},{x:5,y:3},{x:7,y:3},{x:0,y:4},{x:1,y:4},{x:2,y:4},{x:3,y:4},{x:5,y:4},{x:7,y:4},{x:2,y:5},{x:3,y:5},{x:5,y:5},{x:3,y:6},{x:6,y:6}];
    property <[Px]> px: root.name == "sun" ? root.sun : root.name == "bulb" ? root.bulb : root.vol;
    for p in root.px: Rectangle {
        x: p.x * root.scale * 1px;
        y: p.y * root.scale * 1px;
        width: root.scale * 1px;
        height: root.scale * 1px;
        background: root.fill;
    }
}

// Judie's mark. The five rectangles are fixed (160x120 design box); keep the
// lopsided legs exactly. Set `width` only; height follows at 3:4.
export component PiMark inherits Rectangle {
    in property <color> fill: Dy.text;
    width: 64px;
    height: self.width * 0.75;
    background: transparent;
    property <float> s: self.width / 160px;
    Rectangle { x: 6px * root.s; y: 18px * root.s; width: 148px * root.s; height: 14px * root.s; background: root.fill; }
    Rectangle { x: 6px * root.s; y: 18px * root.s; width: 14px * root.s; height: 40px * root.s; background: root.fill; }
    Rectangle { x: 144px * root.s; y: 18px * root.s; width: 10px * root.s; height: 26px * root.s; background: root.fill; }
    Rectangle { x: 52px * root.s; y: 18px * root.s; width: 22px * root.s; height: 92px * root.s; background: root.fill; }
    Rectangle { x: 102px * root.s; y: 18px * root.s; width: 12px * root.s; height: 76px * root.s; background: root.fill; }
}

export struct ScreenOffChoice {
    label: string,
    secs: int,
}

export struct RailTab {
    id: string,
    label: string,
    glyph: string,
}
