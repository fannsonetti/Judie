export struct LightRow {
    id: string,
    name: string,
    on: bool,
    brightness: string,
}

export struct HourRow {
    hour: string,
    temp: string,
    precip: string,
}

export struct EventRow {
    time: string,
    title: string,
    detail: string,
}

export struct ServiceRow {
    name: string,
    status: string,
    online: bool,
}

export struct ActivityRow {
    title: string,
    source: string,
    time: string,
}

export struct TimerRow {
    label: string,
    remain: string,
}

export struct Slot {
    id: string,
    kind: string,
    size: string,
    col: int,
    row: int,
    cols: int,
    rows: int,
    page: int,
    label: string,
    custom-id: string,
}

export struct GalleryItem {
    kind: string,
    label: string,
    custom: bool,
    id: string,
}

export struct CalCell {
    label: string,
    today: bool,
}

export struct PaletteHit {
    id: string,
    title: string,
    hint: string,
}

export struct RoutineRow {
    id: string,
    name: string,
    phrase: string,
    command: string,
    builtin: bool,
    enabled: bool,
    is-new: bool,
    dirty: bool,
    valid: bool,
    status: string,
    name-error: string,
    phrase-error: string,
    command-error: string,
}

export struct PartKind {
    id: string,
    label: string,
}

export struct SlopNode {
    widget-id: string,
    id: string,
    kind: string,
    x: float,
    y: float,
    w: float,
    h: float,
    text: string,
    r: int,
    g: int,
    b: int,
    value: float,
}

export struct ReleaseRow {
    tag: string,
    name: string,
    current: bool,
    installable: bool,
}

export struct WifiNet {
    ssid: string,
    signal: string,
    bars: int,
    secured: bool,
    saved: bool,
    connected: bool,
}

export global Dy {
    out property <color> canvas: #000000;
    out property <color> border: #2a2a2a;
    out property <color> border-hi: #5a5a5a;
    out property <color> text: #ffffff;
    out property <color> muted: #8a8a8a;
    out property <color> dim: #4a4a4a;
    out property <string> mono: "DejaVu Sans Mono";
}

export component Card inherits Rectangle {
    in property <string> kicker;
    in property <bool> expandable: false;
    callback tapped;
    background: Dy.canvas;
    border-width: 1px;
    border-color: Dy.border;
    border-radius: 0px;
    clip: true;

    TouchArea {
        clicked => { root.tapped(); }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        @children
    }
}

export component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    callback clicked;
    border-radius: 0px;
    border-width: 1.5px;
    border-color: root.on ? Dy.text : Dy.border;
    background: Dy.canvas;
    height: 44px;
    min-width: 72px;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: root.on ? Dy.text : Dy.muted;
        font-size: 13px;
        font-weight: 600;
        font-family: Dy.mono;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> on;
    callback toggled;
    width: 56px;
    height: 28px;
    border-radius: 0px;
    border-width: 1.5px;
    border-color: root.on ? Dy.text : Dy.border;
    background: Dy.canvas;
    TouchArea {
        clicked => {
            root.on = !root.on;
            root.toggled();
        }
    }
    Rectangle {
        x: root.on ? parent.width - 22px : 4px;
        y: 4px;
        width: 18px;
        height: 18px;
        background: root.on ? Dy.text : Dy.muted;
    }
}

export component Swatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> on;
    callback clicked;
    width: 16px;
    height: 16px;
    border-radius: 0px;
    background: root.swatch;
    border-width: 2px;
    border-color: root.on ? Dy.text : Dy.border;
    TouchArea { clicked => { root.clicked(); } }
}

export component IconBtn inherits Rectangle {
    in property <string> glyph;
    in property <bool> primary: false;
    callback clicked;
    width: 48px;
    height: 48px;
    border-radius: 0px;
    border-width: 1.5px;
    border-color: root.primary ? Dy.text : Dy.border;
    background: root.primary ? Dy.text : Dy.canvas;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.glyph;
        color: root.primary ? Dy.canvas : Dy.text;
        font-size: 18px;
        font-weight: 700;
        font-family: Dy.mono;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component PowerAction inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> enabled: true;
    callback clicked;
    border-radius: 0px;
    border-width: 1.5px;
    border-color: Dy.border-hi;
    background: Dy.canvas;
    min-height: 108px;
    horizontal-stretch: 1;
    opacity: root.enabled ? 1 : 0.35;
    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        alignment: center;
        Text {
            text: root.glyph;
            color: Dy.text;
            font-size: 22px;
            font-weight: 700;
            font-family: Dy.mono;
            horizontal-alignment: center;
        }
        Text {
            text: root.label;
            color: Dy.text;
            font-size: 15px;
            font-weight: 700;
            font-family: Dy.mono;
            horizontal-alignment: center;
        }
    }
}

export component HitBtn inherits Rectangle {
    in property <string> label;
    in property <string> kicker;
    in property <bool> danger: false;
    in property <bool> warn: false;
    callback clicked;
    min-width: 140px;
    min-height: 72px;
    border-radius: 0px;
    border-width: 1.5px;
    border-color: Dy.border-hi;
    background: Dy.canvas;
    TouchArea { clicked => { root.clicked(); } }
    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        alignment: center;
        if root.kicker != "": Text {
            text: root.kicker;
            color: Dy.muted;
            font-size: 11px;
            font-family: Dy.mono;
            horizontal-alignment: center;
        }
        Text {
            text: root.label;
            color: Dy.text;
            font-size: 16px;
            font-weight: 700;
            font-family: Dy.mono;
            horizontal-alignment: center;
        }
    }
}

export component FieldTap inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> error: "";
    in property <bool> active: false;
    in property <bool> locked: false;
    in property <length> label-size: 11px;
    in property <length> value-size: 16px;
    in property <length> tap-height: 64px;
    callback tapped;
    height: root.tap-height;
    border-width: 0px;
    background: Dy.canvas;
    TouchArea {
        enabled: !root.locked;
        clicked => { root.tapped(); }
    }
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            padding-left: 0px;
            padding-right: 0px;
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.label; color: Dy.muted; font-size: root.label-size; font-family: Dy.mono; }
            Rectangle {
                height: 1.5px;
                background: root.active ? Dy.text : Dy.border;
            }
            Text {
                text: root.value == "" ? "Tap to type" : root.value;
                color: Dy.text;
                font-size: root.value-size;
                font-family: Dy.mono;
                overflow: elide;
            }
        }
        if root.error != "": Text {
            text: root.error;
            color: Dy.text;
            font-size: 14px;
            font-family: Dy.mono;
            vertical-alignment: center;
            wrap: word-wrap;
            width: 148px;
        }
    }
}

export component RoutineCard inherits Rectangle {
    in property <RoutineRow> item;
    in property <string> kb-field: "";
    callback edit-name;
    callback edit-phrase;
    callback edit-command;
    callback save;
    callback cancel;
    callback duplicate;
    callback toggle-enabled;
    callback delete;
    border-width: 1.5px;
    border-color: Dy.border;
    background: Dy.canvas;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: root.item.name == "" ? "New routine" : root.item.name;
                color: Dy.text;
                font-size: 18px;
                font-weight: 700;
                font-family: Dy.mono;
                overflow: elide;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.item.status;
                color: Dy.muted;
                font-size: 14px;
                font-family: Dy.mono;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
        FieldTap {
            label: "Routine name";
            value: root.item.name;
            error: root.item.name-error;
            active: root.kb-field == "routine-name:" + root.item.id;
            locked: root.item.builtin;
            label-size: 15px;
            value-size: 22px;
            tap-height: 78px;
            tapped => { root.edit-name(); }
        }
        FieldTap {
            label: "When you say";
            value: root.item.phrase;
            error: root.item.phrase-error;
            active: root.kb-field == "routine-phrase:" + root.item.id;
            locked: root.item.builtin;
            label-size: 15px;
            value-size: 22px;
            tap-height: 78px;
            tapped => { root.edit-phrase(); }
        }
        FieldTap {
            label: "Judie should";
            value: root.item.command;
            error: root.item.command-error;
            active: root.kb-field == "routine-command:" + root.item.id;
            locked: root.item.builtin;
            label-size: 15px;
            value-size: 22px;
            tap-height: 78px;
            tapped => { root.edit-command(); }
        }
        HorizontalLayout {
            spacing: 10px;
            Pill {
                label: "Save";
                on: true;
                opacity: (!root.item.builtin && root.item.dirty && root.item.valid) ? 1 : 0.35;
                clicked => { root.save(); }
            }
            Pill {
                label: "Cancel";
                opacity: (root.item.dirty || root.item.is-new) ? 1 : 0.35;
                clicked => { root.cancel(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 10px;
            Pill { label: "Duplicate"; clicked => { root.duplicate(); } }
            Pill {
                label: root.item.enabled ? "Disable" : "Enable";
                clicked => { root.toggle-enabled(); }
            }
            if !root.item.builtin: Pill { label: "Delete"; clicked => { root.delete(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

export component KeyBtn inherits Rectangle {
    in property <string> glyph;
    in property <string> sub: "";
    in property <bool> wide: false;
    in property <float> u: 1;
    in property <bool> on: false;
    in property <bool> has-icon: false;
    in property <image> icon;
    callback clicked;
    min-width: 28px;
    height: 52px;
    horizontal-stretch: root.u;
    border-width: 1.5px;
    border-color: root.on ? Dy.text : Dy.border;
    background: root.on ? #141414 : Dy.canvas;
    TouchArea { clicked => { root.clicked(); } }
    if root.has-icon: Image {
        source: root.icon;
        width: 22px;
        height: 22px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }
    if !root.has-icon: Text {
        text: root.glyph;
        color: Dy.text;
        font-size: 15px;
        font-weight: 600;
        font-family: Dy.mono;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.sub != "": Text {
        x: 4px;
        y: 3px;
        text: root.sub;
        color: Dy.dim;
        font-size: 8px;
        font-family: Dy.mono;
    }
}

export component Bar inherits Rectangle {
    in property <float> level;
    in property <color> fill: #ffffff;
    height: 3px;
    border-radius: 0px;
    background: #1a1a1a;
    border-width: 0px;
    Rectangle {
        width: parent.width * clamp(root.level, 0, 1);
        height: 100%;
        border-radius: 0px;
        background: root.fill;
    }
}

export component QuickTask inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> on: false;
    callback clicked;
    border-width: 1.5px;
    border-color: root.on ? Dy.text : Dy.border;
    background: Dy.canvas;
    clip: true;
    TouchArea { clicked => { root.clicked(); } }
    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        alignment: center;
        Text {
            text: root.glyph;
            color: Dy.text;
            font-size: 16px;
            font-family: Dy.mono;
            horizontal-alignment: center;
        }
        Text {
            text: root.label;
            color: Dy.text;
            font-size: 10px;
            font-weight: 600;
            font-family: Dy.mono;
            horizontal-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}

export component NetGlyph inherits Rectangle {
    in property <string> kind: "wifi";
    in property <int> bars: 0;
    width: 28px;
    height: 22px;
    background: transparent;

    if root.kind == "ethernet": Rectangle {
        background: transparent;
        Rectangle { x: 10px; y: 2px; width: 8px; height: 6px; background: #ffffff; }
        Rectangle { x: 4px; y: 8px; width: 20px; height: 3px; background: #ffffff; }
        Rectangle { x: 6px; y: 11px; width: 3px; height: 8px; background: #ffffff; }
        Rectangle { x: 12.5px; y: 11px; width: 3px; height: 8px; background: #ffffff; }
        Rectangle { x: 19px; y: 11px; width: 3px; height: 8px; background: #ffffff; }
    }

    if root.kind != "ethernet": Rectangle {
        background: transparent;
        Rectangle { x: 2px; y: 16px; width: 5px; height: 4px; background: root.bars >= 1 ? #ffffff : #3a3a3a; }
        Rectangle { x: 8px; y: 12px; width: 5px; height: 8px; background: root.bars >= 2 ? #ffffff : #3a3a3a; }
        Rectangle { x: 14px; y: 7px; width: 5px; height: 13px; background: root.bars >= 3 ? #ffffff : #3a3a3a; }
        Rectangle { x: 20px; y: 2px; width: 5px; height: 18px; background: root.bars >= 4 ? #ffffff : #3a3a3a; }
        if root.bars <= 0: Text {
            x: 14px;
            y: 8px;
            text: "×";
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            font-family: Dy.mono;
        }
    }
}

export component ConfirmSheet inherits Rectangle {
    in property <string> title: "";
    in property <string> body: "";
    in property <string> primary: "Continue";
    in property <string> secondary: "Cancel";
    in property <bool> danger: false;
    in property <length> box-height: 400px;
    callback accept;
    callback dismiss;
    background: #000000cc;
    TouchArea { clicked => { root.dismiss(); } }
    Rectangle {
        x: parent.width * 0.18;
        y: parent.height * 0.18;
        width: parent.width * 0.64;
        height: root.box-height;
        background: #000000;
        border-width: 1.5px;
        border-color: Dy.border-hi;
        TouchArea { clicked => { } }
        VerticalLayout {
            padding: 28px;
            spacing: 16px;
            Text {
                text: root.title;
                color: Dy.text;
                font-size: 20px;
                font-weight: 700;
                font-family: Dy.mono;
            }
            Text {
                text: root.body;
                color: Dy.muted;
                font-size: 14px;
                font-family: Dy.mono;
                wrap: word-wrap;
                vertical-stretch: 1;
            }
            HorizontalLayout {
                spacing: 12px;
                Pill { label: root.secondary; clicked => { root.dismiss(); } }
                Rectangle { horizontal-stretch: 1; }
                Pill { label: root.primary; on: true; clicked => { root.accept(); } }
            }
        }
    }
}

export component TileShell inherits Rectangle {
    in property <bool> editing: false;
    in property <bool> pending: false;
    in property <length> vis-x: 0px;
    in property <length> vis-y: 0px;
    callback tapped;
    callback held;
    callback remove;
    callback drag-begin(length, length);
    callback drag-move(length, length);
    callback drag-end();
    background: transparent;
    border-radius: 0px;
    border-width: 0px;
    clip: false;

    ta := TouchArea {
        clicked => { if !root.editing { root.tapped(); } }
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && root.editing {
                root.drag-begin(self.mouse-x, self.mouse-y);
            }
            if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                if root.editing {
                    root.drag-end();
                }
            }
        }
        moved => {
            if root.editing && self.pressed {
                root.drag-move(self.mouse-x, self.mouse-y);
            }
        }
    }
    Timer {
        interval: 450ms;
        running: ta.pressed && !root.editing;
        triggered => { root.held(); }
    }

    face := Rectangle {
        x: root.vis-x;
        y: root.vis-y;
        width: parent.width;
        height: parent.height;
        background: Dy.canvas;
        border-radius: 0px;
        border-width: 1.5px;
        border-color: root.pending ? #ffffff : Dy.border;
        clip: true;
        VerticalLayout {
            padding: 12px;
            spacing: 6px;
            @children
        }
    }

    if root.editing: TouchArea {
        x: parent.width + root.vis-x - 15px;
        y: root.vis-y - 15px;
        width: 30px;
        height: 30px;
        clicked => { root.remove(); }
        Rectangle {
            border-radius: 15px;
            border-width: 1.5px;
            border-color: #ffffff;
            background: #000000;
            Text {
                text: "×";
                color: #ffffff;
                font-size: 16px;
                font-weight: 700;
                font-family: Dy.mono;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
