// Theme tokens (docs/design/pixel-ui.md). Index: 0 Dusk, 1 Amber CRT, 2 Pocket, 3 Paper.
// Only these eight colours go on screen; light swatches are the one exception.
export global Dy {
    in-out property <int> theme: 0;
    out property <color> bg: theme == 1 ? #0f0a02 : theme == 2 ? #0f380f : theme == 3 ? #efe8d8 : #15121f;
    out property <color> panel: theme == 1 ? #1c1305 : theme == 2 ? #1f4f1f : theme == 3 ? #fbf7ee : #211c30;
    out property <color> line: theme == 1 ? #4a3208 : theme == 2 ? #306230 : theme == 3 ? #2b2620 : #3b3354;
    out property <color> text: theme == 1 ? #ffcf7a : theme == 2 ? #c8e07a : theme == 3 ? #1e1a16 : #f3ecda;
    out property <color> dim: theme == 1 ? #b07d2a : theme == 2 ? #8bac0f : theme == 3 ? #6b6257 : #9d93b5;
    out property <color> accent1: theme == 1 ? #ffb000 : theme == 2 ? #e0f8a0 : theme == 3 ? #d9480f : #ffb43a;
    out property <color> accent2: theme == 1 ? #ffd36b : theme == 2 ? #9bbc0f : theme == 3 ? #1c7c74 : #5fe3cf;
    out property <color> accent3: theme == 1 ? #ff7a1a : theme == 2 ? #e0f8a0 : theme == 3 ? #c2255c : #ff5f8d;
    // Pixel border weight (spec rule 2).
    out property <length> stroke: 3px;
    in-out property <string> mono: "DejaVu Sans Mono";
    out property <string> code: "DejaVu Sans Mono";
    in-out property <float> text-scale: 1.0;
    in-out property <float> ui-scale: 1.0;
    in-out property <length> header-h: 108px;
    in-out property <length> hit-target: 72px;
    // Home-screen type scale. Clock stays the strongest text.
    out property <length> type-clock: 52px * text-scale;
    out property <length> type-hero: 32px * text-scale;
    out property <length> type-value: 28px * text-scale;
    out property <length> type-title: 16px * text-scale;
    out property <length> type-control: 16px * text-scale;
    out property <length> type-secondary: 14px * text-scale;
    out property <length> type-status: 14px * text-scale;
    out property <length> type-dense: 12px * text-scale;
    out property <length> pad: 8px * ui-scale;
}

export component Card inherits Rectangle {
    in property <string> kicker;
    in property <bool> expandable: false;
    callback tapped;
    background: Dy.panel;
    border-width: Dy.stroke;
    border-color: Dy.line;
    border-radius: 0px;
    clip: true;

    TouchArea {
        clicked => { root.tapped(); }
    }

    VerticalLayout {
        padding: Dy.pad;
        spacing: 6px * Dy.ui-scale;
        @children
    }
}

export component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    in property <float> zoom: 1.0;
    callback clicked;
    border-radius: 0px;
    border-width: Dy.stroke;
    border-color: root.on ? Dy.accent1 : Dy.line;
    background: root.on ? Dy.accent1 : Dy.bg;
    height: 44px * root.zoom;
    min-width: 72px * root.zoom;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: root.on ? Dy.bg : Dy.dim;
        font-size: Dy.type-control * root.zoom;
        font-weight: 600;
        font-family: Dy.mono;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> on;
    in property <float> zoom: 1.0;
    callback toggled;
    width: 56px * root.zoom;
    height: 28px * root.zoom;
    border-radius: 0px;
    border-width: Dy.stroke;
    border-color: root.on ? Dy.accent1 : Dy.line;
    background: Dy.bg;
    TouchArea {
        clicked => {
            root.on = !root.on;
            root.toggled();
        }
    }
    Rectangle {
        x: root.on ? parent.width - 24px * root.zoom : 6px * root.zoom;
        y: 6px * root.zoom;
        width: 16px * root.zoom;
        height: 16px * root.zoom;
        background: root.on ? Dy.accent1 : Dy.dim;
    }
}

export component Swatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> on;
    in property <float> zoom: 1.0;
    callback clicked;
    width: 16px * root.zoom;
    height: 16px * root.zoom;
    border-radius: 0px;
    background: root.swatch;
    border-width: max(1px, 2px * root.zoom);
    border-color: root.on ? Dy.text : Dy.line;
    TouchArea { clicked => { root.clicked(); } }
}

