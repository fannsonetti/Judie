import { Dy, KeyBtn } from "cards.slint";

export component AnsiKeyboard inherits Rectangle {
    in-out property <bool> shift: false;
    in-out property <bool> caps: false;
    in-out property <bool> fn-layer: false;
    in-out property <bool> ctrl: false;
    in-out property <bool> alt: false;
    in property <string> field: "";
    in property <string> preview: "";
    callback typed(string);
    callback command(string);
    callback close();

    background: #000000;
    border-width: 1.5px;
    border-color: Dy.border;

    property <bool> upper: root.shift || root.caps;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 10px;
            height: 28px;
            Text {
                text: root.field;
                color: Dy.muted;
                font-size: 12px;
                font-family: Dy.mono;
                vertical-alignment: center;
            }
            Text {
                text: root.preview;
                color: Dy.text;
                font-size: 16px;
                font-family: Dy.mono;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            TouchArea {
                clicked => { root.close(); }
                width: 56px;
                Text {
                    text: "Hide";
                    color: Dy.muted;
                    font-size: 12px;
                    font-family: Dy.mono;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Row 1 — Esc 1-0 - = Backspace
        HorizontalLayout {
            spacing: 5px;
            KeyBtn { u: 1.25; glyph: "Esc"; clicked => { root.command("esc"); } }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F1" : (root.shift ? "!" : "1"); sub: root.fn-layer ? "" : "F1";
                clicked => { if root.fn-layer { root.command("f1"); } else { root.typed(root.shift ? "!" : "1"); if root.shift { root.shift = false; } } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F2" : (root.shift ? "@" : "2"); sub: root.fn-layer ? "" : "F2";
                clicked => { if root.fn-layer { root.command("f2"); } else { root.typed(root.shift ? "@" : "2"); if root.shift { root.shift = false; } } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F3" : (root.shift ? "#" : "3"); sub: root.fn-layer ? "" : "F3";
                clicked => { if root.fn-layer { root.command("f3"); } else { root.typed(root.shift ? "#" : "3"); if root.shift { root.shift = false; } } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F4" : (root.shift ? "$" : "4"); sub: root.fn-layer ? "" : "F4";
                clicked => { if root.fn-layer { root.command("f4"); } else { root.typed(root.shift ? "$" : "4"); if root.shift { root.shift = false; } } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F5" : (root.shift ? "%" : "5"); sub: root.fn-layer ? "" : "F5";
                clicked => { if root.fn-layer { root.command("f5"); } else { root.typed(root.shift ? "%" : "5"); if root.shift { root.shift = false; } } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F6" : (root.shift ? "^" : "6"); sub: root.fn-layer ? "" : "F6";
                clicked => { if root.fn-layer { root.command("f6"); } else { root.typed(root.shift ? "^" : "6"); if root.shift { root.shift = false; } } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F7" : (root.shift ? "&" : "7"); sub: root.fn-layer ? "" : "F7";
                clicked => { if root.fn-layer { root.command("f7"); } else { root.typed(root.shift ? "&" : "7"); if root.shift { root.shift = false; } } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F8" : (root.shift ? "*" : "8"); sub: root.fn-layer ? "" : "F8";
                clicked => { if root.fn-layer { root.command("f8"); } else { root.typed(root.shift ? "*" : "8"); if root.shift { root.shift = false; } } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F9" : (root.shift ? "(" : "9"); sub: root.fn-layer ? "" : "F9";
                clicked => { if root.fn-layer { root.command("f9"); } else { root.typed(root.shift ? "(" : "9"); if root.shift { root.shift = false; } } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F10" : (root.shift ? ")" : "0"); sub: root.fn-layer ? "" : "F10";
                clicked => { if root.fn-layer { root.command("f10"); } else { root.typed(root.shift ? ")" : "0"); if root.shift { root.shift = false; } } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F11" : (root.shift ? "_" : "-"); sub: root.fn-layer ? "" : "F11";
                clicked => { if root.fn-layer { root.command("f11"); } else { root.typed(root.shift ? "_" : "-"); if root.shift { root.shift = false; } } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F12" : (root.shift ? "+" : "="); sub: root.fn-layer ? "" : "F12";
                clicked => { if root.fn-layer { root.command("f12"); } else { root.typed(root.shift ? "+" : "="); if root.shift { root.shift = false; } } }
            }
            KeyBtn {
                u: 2; glyph: root.fn-layer ? "Del" : "⌫";
                clicked => { root.command(root.fn-layer ? "delete" : (root.ctrl ? "word-back" : "back")); }
            }
        }

        // Row 2 — Tab Q-P [ ] \
        HorizontalLayout {
            spacing: 5px;
            KeyBtn { u: 1.5; glyph: "Tab"; clicked => { root.command("tab"); } }
            KeyBtn { u: 1; glyph: root.upper ? "Q" : "q"; clicked => { root.typed(root.upper ? "Q" : "q"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "W" : "w"; clicked => { root.typed(root.upper ? "W" : "w"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "E" : "e"; clicked => { root.typed(root.upper ? "E" : "e"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "R" : "r"; clicked => { root.typed(root.upper ? "R" : "r"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "T" : "t"; clicked => { root.typed(root.upper ? "T" : "t"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "Y" : "y"; clicked => { root.typed(root.upper ? "Y" : "y"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "U" : "u"; sub: root.fn-layer ? "PgUp" : ""; clicked => { if root.fn-layer { root.command("pgup"); } else { root.typed(root.upper ? "U" : "u"); if root.shift { root.shift = false; } } } }
            KeyBtn { u: 1; glyph: root.upper ? "I" : "i"; sub: root.fn-layer ? "↑" : ""; clicked => { if root.fn-layer { root.command("up"); } else { root.typed(root.upper ? "I" : "i"); if root.shift { root.shift = false; } } } }
            KeyBtn { u: 1; glyph: root.upper ? "O" : "o"; sub: root.fn-layer ? "PgDn" : ""; clicked => { if root.fn-layer { root.command("pgdn"); } else { root.typed(root.upper ? "O" : "o"); if root.shift { root.shift = false; } } } }
            KeyBtn { u: 1; glyph: root.upper ? "P" : "p"; clicked => { root.typed(root.upper ? "P" : "p"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.shift ? "{" : "["; clicked => { root.typed(root.shift ? "{" : "["); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.shift ? "}" : "]"; clicked => { root.typed(root.shift ? "}" : "]"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1.5; glyph: root.shift ? "|" : "\\"; clicked => { root.typed(root.shift ? "|" : "\\"); if root.shift { root.shift = false; } } }
        }

        // Row 3 — Caps A-L ; ' Enter
        HorizontalLayout {
            spacing: 5px;
            KeyBtn { u: 1.75; glyph: "Caps"; on: root.caps; clicked => { root.caps = !root.caps; } }
            KeyBtn { u: 1; glyph: root.upper ? "A" : "a"; clicked => { root.typed(root.upper ? "A" : "a"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "S" : "s"; clicked => { root.typed(root.upper ? "S" : "s"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "D" : "d"; clicked => { root.typed(root.upper ? "D" : "d"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "F" : "f"; clicked => { root.typed(root.upper ? "F" : "f"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "G" : "g"; clicked => { root.typed(root.upper ? "G" : "g"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "H" : "h"; clicked => { root.typed(root.upper ? "H" : "h"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "J" : "j"; sub: root.fn-layer ? "←" : ""; clicked => { if root.fn-layer { root.command("left"); } else { root.typed(root.upper ? "J" : "j"); if root.shift { root.shift = false; } } } }
            KeyBtn { u: 1; glyph: root.upper ? "K" : "k"; sub: root.fn-layer ? "↓" : ""; clicked => { if root.fn-layer { root.command("down"); } else { root.typed(root.upper ? "K" : "k"); if root.shift { root.shift = false; } } } }
            KeyBtn { u: 1; glyph: root.upper ? "L" : "l"; sub: root.fn-layer ? "→" : ""; clicked => { if root.fn-layer { root.command("right"); } else { root.typed(root.upper ? "L" : "l"); if root.shift { root.shift = false; } } } }
            KeyBtn { u: 1; glyph: root.shift ? ":" : ";"; clicked => { root.typed(root.shift ? ":" : ";"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.shift ? "\"" : "'"; clicked => { root.typed(root.shift ? "\"" : "'"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 2.25; glyph: "Enter"; clicked => { root.command("enter"); } }
        }

        // Row 4 — Shift Z-M , . / Shift
        HorizontalLayout {
            spacing: 5px;
            KeyBtn { u: 2.25; glyph: "Shift"; on: root.shift; clicked => { root.shift = !root.shift; } }
            KeyBtn { u: 1; glyph: root.upper ? "Z" : "z"; clicked => { root.typed(root.upper ? "Z" : "z"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "X" : "x"; clicked => { root.typed(root.upper ? "X" : "x"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "C" : "c"; clicked => { root.typed(root.upper ? "C" : "c"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "V" : "v"; clicked => { root.typed(root.upper ? "V" : "v"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "B" : "b"; clicked => { root.typed(root.upper ? "B" : "b"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.upper ? "N" : "n"; sub: root.fn-layer ? "Home" : ""; clicked => { if root.fn-layer { root.command("home"); } else { root.typed(root.upper ? "N" : "n"); if root.shift { root.shift = false; } } } }
            KeyBtn { u: 1; glyph: root.upper ? "M" : "m"; sub: root.fn-layer ? "End" : ""; clicked => { if root.fn-layer { root.command("end"); } else { root.typed(root.upper ? "M" : "m"); if root.shift { root.shift = false; } } } }
            KeyBtn { u: 1; glyph: root.shift ? "<" : ","; clicked => { root.typed(root.shift ? "<" : ","); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.shift ? ">" : "."; clicked => { root.typed(root.shift ? ">" : "."); if root.shift { root.shift = false; } } }
            KeyBtn { u: 1; glyph: root.shift ? "?" : "/"; clicked => { root.typed(root.shift ? "?" : "/"); if root.shift { root.shift = false; } } }
            KeyBtn { u: 2.75; glyph: "Shift"; on: root.shift; clicked => { root.shift = !root.shift; } }
        }

        // Bottom — Ctrl Pi Alt Space Alt Fn Ctrl
        HorizontalLayout {
            spacing: 5px;
            KeyBtn { u: 1.25; glyph: "Ctrl"; on: root.ctrl; clicked => { root.ctrl = !root.ctrl; } }
            KeyBtn {
                u: 1.25;
                glyph: "";
                has-icon: true;
                icon: @image-url("raspberry.png");
                clicked => { root.command("pi"); }
            }
            KeyBtn { u: 1.25; glyph: "Alt"; on: root.alt; clicked => { root.alt = !root.alt; } }
            KeyBtn { u: 6.25; glyph: ""; clicked => { root.typed(" "); } }
            KeyBtn { u: 1.25; glyph: "Alt"; on: root.alt; clicked => { root.alt = !root.alt; } }
            KeyBtn { u: 1.25; glyph: "Fn"; on: root.fn-layer; clicked => { root.fn-layer = !root.fn-layer; } }
            KeyBtn { u: 1.25; glyph: "Ctrl"; on: root.ctrl; clicked => { root.ctrl = !root.ctrl; } }
        }
    }
}
