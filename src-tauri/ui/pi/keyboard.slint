import { Dy, KeyBtn } from "cards.slint";

export component AnsiKeyboard inherits Rectangle {
    in-out property <bool> caps: false;
    in property <string> field: "";
    in property <string> preview: "";
    callback typed(string);
    callback command(string);
    callback close();

    background: #000000;
    border-width: 1.5px;
    border-color: Dy.border;

    property <bool> shift: shift-l.down || shift-r.down;
    property <bool> fn-layer: fn-key.down;
    property <bool> ctrl: ctrl-l.down || ctrl-r.down;
    property <bool> alt: alt-l.down || alt-r.down;
    property <bool> upper: root.shift || root.caps;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 10px;
            height: 28px;
            Text {
                text: root.field;
                color: Dy.muted;
                font-size: 12px;
                font-family: Dy.mono;
                vertical-alignment: center;
            }
            Text {
                text: root.preview;
                color: Dy.text;
                font-size: 16px;
                font-family: Dy.mono;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            TouchArea {
                clicked => { root.close(); }
                width: 56px;
                Text {
                    text: "Hide";
                    color: Dy.muted;
                    font-size: 12px;
                    font-family: Dy.mono;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: 5px;
            vertical-stretch: 1;
            KeyBtn { u: 1.25; glyph: "Esc"; clicked => { root.command("esc"); } }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F1" : (root.shift ? "!" : "1"); sub: root.fn-layer ? "" : "F1";
                clicked => { if root.fn-layer { root.command("f1"); } else { root.typed(root.shift ? "!" : "1"); } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F2" : (root.shift ? "@" : "2"); sub: root.fn-layer ? "" : "F2";
                clicked => { if root.fn-layer { root.command("f2"); } else { root.typed(root.shift ? "@" : "2"); } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F3" : (root.shift ? "#" : "3"); sub: root.fn-layer ? "" : "F3";
                clicked => { if root.fn-layer { root.command("f3"); } else { root.typed(root.shift ? "#" : "3"); } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F4" : (root.shift ? "$" : "4"); sub: root.fn-layer ? "" : "F4";
                clicked => { if root.fn-layer { root.command("f4"); } else { root.typed(root.shift ? "$" : "4"); } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F5" : (root.shift ? "%" : "5"); sub: root.fn-layer ? "" : "F5";
                clicked => { if root.fn-layer { root.command("f5"); } else { root.typed(root.shift ? "%" : "5"); } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F6" : (root.shift ? "^" : "6"); sub: root.fn-layer ? "" : "F6";
                clicked => { if root.fn-layer { root.command("f6"); } else { root.typed(root.shift ? "^" : "6"); } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F7" : (root.shift ? "&" : "7"); sub: root.fn-layer ? "" : "F7";
                clicked => { if root.fn-layer { root.command("f7"); } else { root.typed(root.shift ? "&" : "7"); } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F8" : (root.shift ? "*" : "8"); sub: root.fn-layer ? "" : "F8";
                clicked => { if root.fn-layer { root.command("f8"); } else { root.typed(root.shift ? "*" : "8"); } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F9" : (root.shift ? "(" : "9"); sub: root.fn-layer ? "" : "F9";
                clicked => { if root.fn-layer { root.command("f9"); } else { root.typed(root.shift ? "(" : "9"); } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F10" : (root.shift ? ")" : "0"); sub: root.fn-layer ? "" : "F10";
                clicked => { if root.fn-layer { root.command("f10"); } else { root.typed(root.shift ? ")" : "0"); } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F11" : (root.shift ? "_" : "-"); sub: root.fn-layer ? "" : "F11";
                clicked => { if root.fn-layer { root.command("f11"); } else { root.typed(root.shift ? "_" : "-"); } }
            }
            KeyBtn {
                u: 1; glyph: root.fn-layer ? "F12" : (root.shift ? "+" : "="); sub: root.fn-layer ? "" : "F12";
                clicked => { if root.fn-layer { root.command("f12"); } else { root.typed(root.shift ? "+" : "="); } }
            }
            KeyBtn {
                u: 2; glyph: root.fn-layer ? "Del" : "⌫";
                clicked => { root.command(root.fn-layer ? "delete" : (root.ctrl ? "word-back" : "back")); }
            }
        }

        HorizontalLayout {
            spacing: 5px;
            vertical-stretch: 1;
            KeyBtn { u: 1.5; glyph: "Tab"; clicked => { root.command("tab"); } }
            KeyBtn { u: 1; glyph: root.upper ? "Q" : "q"; clicked => { root.typed(root.upper ? "Q" : "q"); } }
            KeyBtn { u: 1; glyph: root.upper ? "W" : "w"; clicked => { root.typed(root.upper ? "W" : "w"); } }
            KeyBtn { u: 1; glyph: root.upper ? "E" : "e"; clicked => { root.typed(root.upper ? "E" : "e"); } }
            KeyBtn { u: 1; glyph: root.upper ? "R" : "r"; clicked => { root.typed(root.upper ? "R" : "r"); } }
            KeyBtn { u: 1; glyph: root.upper ? "T" : "t"; clicked => { root.typed(root.upper ? "T" : "t"); } }
            KeyBtn { u: 1; glyph: root.upper ? "Y" : "y"; clicked => { root.typed(root.upper ? "Y" : "y"); } }
            KeyBtn { u: 1; glyph: root.upper ? "U" : "u"; sub: root.fn-layer ? "PgUp" : ""; clicked => { if root.fn-layer { root.command("pgup"); } else { root.typed(root.upper ? "U" : "u"); } } }
            KeyBtn { u: 1; glyph: root.upper ? "I" : "i"; sub: root.fn-layer ? "↑" : ""; clicked => { if root.fn-layer { root.command("up"); } else { root.typed(root.upper ? "I" : "i"); } } }
            KeyBtn { u: 1; glyph: root.upper ? "O" : "o"; sub: root.fn-layer ? "PgDn" : ""; clicked => { if root.fn-layer { root.command("pgdn"); } else { root.typed(root.upper ? "O" : "o"); } } }
            KeyBtn { u: 1; glyph: root.upper ? "P" : "p"; clicked => { root.typed(root.upper ? "P" : "p"); } }
            KeyBtn { u: 1; glyph: root.shift ? "{" : "["; clicked => { root.typed(root.shift ? "{" : "["); } }
            KeyBtn { u: 1; glyph: root.shift ? "}" : "]"; clicked => { root.typed(root.shift ? "}" : "]"); } }
            KeyBtn { u: 1.5; glyph: root.shift ? "|" : "\\"; clicked => { root.typed(root.shift ? "|" : "\\"); } }
        }

        HorizontalLayout {
            spacing: 5px;
            vertical-stretch: 1;
            KeyBtn { u: 1.75; glyph: "Caps"; on: root.caps; clicked => { root.caps = !root.caps; } }
            KeyBtn { u: 1; glyph: root.upper ? "A" : "a"; clicked => { root.typed(root.upper ? "A" : "a"); } }
            KeyBtn { u: 1; glyph: root.upper ? "S" : "s"; clicked => { root.typed(root.upper ? "S" : "s"); } }
            KeyBtn { u: 1; glyph: root.upper ? "D" : "d"; clicked => { root.typed(root.upper ? "D" : "d"); } }
            KeyBtn { u: 1; glyph: root.upper ? "F" : "f"; clicked => { root.typed(root.upper ? "F" : "f"); } }
            KeyBtn { u: 1; glyph: root.upper ? "G" : "g"; clicked => { root.typed(root.upper ? "G" : "g"); } }
            KeyBtn { u: 1; glyph: root.upper ? "H" : "h"; clicked => { root.typed(root.upper ? "H" : "h"); } }
            KeyBtn { u: 1; glyph: root.upper ? "J" : "j"; sub: root.fn-layer ? "←" : ""; clicked => { if root.fn-layer { root.command("left"); } else { root.typed(root.upper ? "J" : "j"); } } }
            KeyBtn { u: 1; glyph: root.upper ? "K" : "k"; sub: root.fn-layer ? "↓" : ""; clicked => { if root.fn-layer { root.command("down"); } else { root.typed(root.upper ? "K" : "k"); } } }
            KeyBtn { u: 1; glyph: root.upper ? "L" : "l"; sub: root.fn-layer ? "→" : ""; clicked => { if root.fn-layer { root.command("right"); } else { root.typed(root.upper ? "L" : "l"); } } }
            KeyBtn { u: 1; glyph: root.shift ? ":" : ";"; clicked => { root.typed(root.shift ? ":" : ";"); } }
            KeyBtn { u: 1; glyph: root.shift ? "\"" : "'"; clicked => { root.typed(root.shift ? "\"" : "'"); } }
            KeyBtn { u: 2.25; glyph: "Enter"; clicked => { root.command("enter"); } }
        }

        HorizontalLayout {
            spacing: 5px;
            vertical-stretch: 1;
            shift-l := KeyBtn { u: 2.25; glyph: "Shift"; on: root.shift; }
            KeyBtn { u: 1; glyph: root.upper ? "Z" : "z"; clicked => { root.typed(root.upper ? "Z" : "z"); } }
            KeyBtn { u: 1; glyph: root.upper ? "X" : "x"; clicked => { root.typed(root.upper ? "X" : "x"); } }
            KeyBtn { u: 1; glyph: root.upper ? "C" : "c"; clicked => { root.typed(root.upper ? "C" : "c"); } }
            KeyBtn { u: 1; glyph: root.upper ? "V" : "v"; clicked => { root.typed(root.upper ? "V" : "v"); } }
            KeyBtn { u: 1; glyph: root.upper ? "B" : "b"; clicked => { root.typed(root.upper ? "B" : "b"); } }
            KeyBtn { u: 1; glyph: root.upper ? "N" : "n"; sub: root.fn-layer ? "Home" : ""; clicked => { if root.fn-layer { root.command("home"); } else { root.typed(root.upper ? "N" : "n"); } } }
            KeyBtn { u: 1; glyph: root.upper ? "M" : "m"; sub: root.fn-layer ? "End" : ""; clicked => { if root.fn-layer { root.command("end"); } else { root.typed(root.upper ? "M" : "m"); } } }
            KeyBtn { u: 1; glyph: root.shift ? "<" : ","; clicked => { root.typed(root.shift ? "<" : ","); } }
            KeyBtn { u: 1; glyph: root.shift ? ">" : "."; clicked => { root.typed(root.shift ? ">" : "."); } }
            KeyBtn { u: 1; glyph: root.shift ? "?" : "/"; clicked => { root.typed(root.shift ? "?" : "/"); } }
            shift-r := KeyBtn { u: 2.75; glyph: "Shift"; on: root.shift; }
        }

        HorizontalLayout {
            spacing: 5px;
            vertical-stretch: 1;
            ctrl-l := KeyBtn { u: 1.25; glyph: "Ctrl"; on: root.ctrl; }
            KeyBtn {
                u: 1.25;
                glyph: "";
                has-icon: true;
                icon: @image-url("raspberry.png");
                clicked => { root.command("pi"); }
            }
            alt-l := KeyBtn { u: 1.25; glyph: "Alt"; on: root.alt; }
            KeyBtn { u: 6.25; glyph: ""; clicked => { root.typed(" "); } }
            alt-r := KeyBtn { u: 1.25; glyph: "Alt"; on: root.alt; }
            fn-key := KeyBtn { u: 1.25; glyph: "Fn"; on: root.fn-layer; }
            ctrl-r := KeyBtn { u: 1.25; glyph: "Ctrl"; on: root.ctrl; }
        }
    }
}
