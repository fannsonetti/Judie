import { Dy, LightRow, HourRow, EventRow, ServiceRow, ActivityRow, TimerRow, CalCell, SlopNode, TerminalLine, Pill, Toggle, Swatch, IconBtn, Bar, QuickTask, FieldTap, PixIcon } from "cards.slint";

// Live widget face used on the home grid and in the add-widget carousel.
// `sample` swaps in default preview data so gallery never reads the live room.
// `source` is the preview renderer: "live" draws this component; "image" is reserved
// for a later static thumbnail without changing the carousel.

export component WidgetFace inherits Rectangle {
    in property <string> kind: "activity";
    in property <string> size: "1x1";
    in property <bool> sample: false;
    in property <string> source: "live";
    in property <float> face-scale: 1.0;
    in property <image> thumb;
    in property <string> widget-id: "";

    in property <string> weather-loc: "";
    in property <string> weather-temp: "";
    in property <string> weather-cond: "";
    in property <string> weather-range: "";
    in property <string> weather-feel: "";
    in property <string> weather-note: "";
    in property <[HourRow]> hours: [];

    in property <bool> master-on: true;
    in property <int> brightness: 70;
    in property <string> scene: "Cozy";
    in property <string> master-color: "#FFB366";
    in property <[LightRow]> lights: [];

    in property <bool> playing: false;
    in property <string> track-title: "";
    in property <string> track-artist: "";
    in property <int> volume: 62;
    in property <float> media-progress: 0.2;

    in property <string> indoor: "";
    in property <string> outdoor: "";
    in property <string> humidity: "";
    in property <string> comfort: "";
    in property <[EventRow]> events: [];
    in property <string> month-name: "";
    in property <[CalCell]> cal-cells: [];

    in property <bool> purifier-on: true;
    in property <string> purifier-mode: "Auto";
    in property <string> purifier-aq: "Good";
    in property <int> purifier-filter: 38;

    in property <float> cpu: 0;
    in property <float> memory: 0;
    in property <string> mem-detail: "";
    in property <string> temp-text: "";
    in property <[ServiceRow]> services: [];
    in property <[ActivityRow]> activity: [];
    in property <[TimerRow]> timers: [];
    in property <[SlopNode]> slop-nodes: [];
    in property <bool> dnd: false;
    in property <bool> use-layout: false;
    in property <string> terminal-input: "";
    in property <[TerminalLine]> terminal-lines: [];
    in property <bool> terminal-kb-active: false;
    in property <string> clock-hm: "12:00";
    in property <string> clock-hms: "12:00:00";
    in property <string> date-text: "";
    in property <float> hour-deg: 0;
    in property <float> minute-deg: 0;
    in property <float> second-deg: 0;
    in property <int> pong-ly: 42;
    in property <int> pong-ry: 42;
    in property <int> pong-bx: 50;
    in property <int> pong-by: 50;
    in property <string> ask-text: "";
    in property <bool> blink: true;

    callback toggle-master();
    callback brightness-changed(int);
    callback set-color(string);
    callback toggle-light(string);
    callback toggle-play();
    callback next-track();
    callback prev-track();
    callback volume-changed(int);
    callback quick(string);
    callback set-purifier-mode(string);
    callback open-terminal-input();
    callback submit-terminal();

    background: transparent;
    clip: true;

    property <[HourRow]> demo-hours: [
        { hour: "12", temp: "18°", precip: "10%" },
        { hour: "13", temp: "17°", precip: "20%" },
        { hour: "14", temp: "16°", precip: "15%" },
        { hour: "15", temp: "16°", precip: "5%" },
    ];
    property <[EventRow]> demo-events: [
        { time: "09:00", title: "Stand-up", detail: "Kitchen" },
        { time: "14:30", title: "Delivery", detail: "" },
        { time: "19:00", title: "Dinner", detail: "Home" },
    ];
    property <[CalCell]> demo-cal: [
        { label: "1", today: false }, { label: "2", today: false }, { label: "3", today: false }, { label: "4", today: false }, { label: "5", today: false }, { label: "6", today: false }, { label: "7", today: false },
        { label: "8", today: false }, { label: "9", today: false }, { label: "10", today: true }, { label: "11", today: false }, { label: "12", today: false }, { label: "13", today: false }, { label: "14", today: false },
        { label: "15", today: false }, { label: "16", today: false }, { label: "17", today: false }, { label: "18", today: false }, { label: "19", today: false }, { label: "20", today: false }, { label: "21", today: false },
        { label: "22", today: false }, { label: "23", today: false }, { label: "24", today: false }, { label: "25", today: false }, { label: "26", today: false }, { label: "27", today: false }, { label: "28", today: false },
        { label: "29", today: false }, { label: "30", today: false }, { label: "", today: false }, { label: "", today: false }, { label: "", today: false }, { label: "", today: false }, { label: "", today: false },
    ];
    property <[LightRow]> demo-lights: [
        { id: "a", name: "Ceiling", on: true, brightness: "40%" },
        { id: "b", name: "Desk", on: true, brightness: "70%" },
        { id: "c", name: "Lamp", on: false, brightness: "Off" },
        { id: "d", name: "Strip", on: true, brightness: "25%" },
    ];
    property <[ServiceRow]> demo-services: [
        { name: "Core", status: "4 ms", online: true },
        { name: "Lights", status: "6 ms", online: true },
        { name: "Media", status: "9 ms", online: true },
        { name: "Weather", status: "12 ms", online: true },
        { name: "Voice", status: "Down", online: false },
    ];
    property <[ActivityRow]> demo-activity: [
        { title: "Good Night", source: "Routine", time: "22:14" },
        { title: "Lights Off", source: "You", time: "22:15" },
        { title: "Do Not Disturb", source: "Routine", time: "22:15" },
    ];
    property <[TimerRow]> demo-timers: [
        { label: "Pasta", remain: "4:20" },
        { label: "Laundry", remain: "32:00" },
    ];
    property <[TerminalLine]> demo-terminal: [
        { text: "~$ uname -s", prompt: true },
        { text: "Linux", prompt: false },
        { text: "~$ ls", prompt: true },
        { text: "Desktop  Documents  Downloads", prompt: false },
    ];
    property <[TerminalLine]> t-term: root.sample ? root.demo-terminal : root.terminal-lines;
    property <string> t-term-in: root.sample ? "lights off" : root.terminal-input;

    property <string> t-loc: root.sample ? "Hafnarfjörður" : root.weather-loc;
    property <string> t-temp: root.sample ? "18°" : root.weather-temp;
    property <string> t-cond: root.sample ? "Cloudy" : root.weather-cond;
    property <string> t-range: root.sample ? "H 20°  L 12°" : root.weather-range;
    property <string> t-feel: root.sample ? "Feels 16°" : root.weather-feel;
    property <string> t-note: root.sample ? "Light rain later this evening." : root.weather-note;
    property <bool> t-master: root.sample ? true : root.master-on;
    property <int> t-bright: root.sample ? 40 : root.brightness;
    property <string> t-scene: root.sample ? "Focus" : root.scene;
    property <string> t-color: root.sample ? "#2D7BFF" : root.master-color;
    property <bool> t-play: root.sample ? false : root.playing;
    property <string> t-track: root.sample ? "Night Drive" : root.track-title;
    property <string> t-artist: root.sample ? "Analog Heart" : root.track-artist;
    property <int> t-vol: root.sample ? 62 : root.volume;
    property <float> t-prog: root.sample ? 0.42 : root.media-progress;
    property <string> t-in: root.sample ? "21°" : root.indoor;
    property <string> t-out: root.sample ? "7°" : root.outdoor;
    property <string> t-hum: root.sample ? "44%" : root.humidity;
    property <string> t-comfort: root.sample ? "Comfortable" : root.comfort;
    property <string> t-month: root.sample ? "March" : root.month-name;
    property <string> t-aq: root.sample ? "Good" : root.purifier-aq;
    property <string> t-pmode: root.sample ? "Auto" : root.purifier-mode;
    property <int> t-filter: root.sample ? 38 : root.purifier-filter;
    property <float> t-cpu: root.sample ? 24 : root.cpu;
    property <float> t-mem: root.sample ? 51 : root.memory;
    property <string> t-memd: root.sample ? "4.1 / 8.0 GB" : root.mem-detail;
    property <string> t-temp-host: root.sample ? "52°" : root.temp-text;
    property <bool> t-dnd: root.sample ? false : root.dnd;

    if root.source == "image": Image {
        source: root.thumb;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }

    // Tile pattern from docs/design/pixel-ui-mockup.html: a dim caps kicker,
    // one strong value, dim caps captions, segmented bars.
    property <float> s: root.face-scale;
    property <length> f-label: Dy.type-label * root.s;
    property <length> f-body: Dy.type-title * root.s;
    property <length> f-value: Dy.type-value * root.s;
    property <length> f-hero: Dy.type-hero * root.s;
    property <length> sp: 4px * root.s;
    property <int> icon-scale: max(1, round(4 * root.s));
    property <string> kicker:
        root.use-layout ? "" :
        root.kind == "climate" ? "Climate" :
        root.kind == "purifier" ? "Air quality" :
        root.kind == "activity" ? "Activity" :
        root.kind == "server" ? "Services" :
        root.kind == "weather" ? "Weather" :
        root.kind == "lights" ? "Lights" :
        root.kind == "media" ? "Now playing" :
        root.kind == "system" ? "System" :
        root.kind == "terminal" ? "Terminal" :
        root.kind == "timers" ? "Timers" :
        root.kind == "ask" ? "Ask Judie" : "";

    if root.source != "image": VerticalLayout {
        spacing: root.sp;

        if root.kicker != "": Text {
            text: root.kicker;
            color: Dy.dim;
            font-size: root.f-label;
            font-family: Dy.caps;
            overflow: elide;
        }

        Rectangle {
        vertical-stretch: 1;
        background: transparent;

        if !root.use-layout && root.kind == "quickControls": GridLayout {
            spacing: root.sp;
            padding: 0px;
            // 1x1 is too narrow for a 2x2 grid of labels: stack them instead.
            QuickTask { row: 0; col: 0; zoom: root.s; label: "Good Night"; clicked => { if !root.sample { root.quick("goodNight"); } } }
            QuickTask { row: root.size == "1x1" ? 1 : 0; col: root.size == "1x1" ? 0 : 1; zoom: root.s; label: "Lights Off"; clicked => { if !root.sample { root.quick("lightsOff"); } } }
            QuickTask { row: root.size == "1x1" ? 2 : 1; col: 0; zoom: root.s; label: "Do Not Disturb"; on: root.t-dnd; clicked => { if !root.sample { root.quick("dnd"); } } }
            QuickTask { row: root.size == "1x1" ? 3 : 1; col: root.size == "1x1" ? 0 : 1; zoom: root.s; label: "Movie Mode"; clicked => { if !root.sample { root.quick("movie"); } } }
        }

        if !root.use-layout && root.kind == "climate": VerticalLayout {
            spacing: root.sp;
            alignment: start;
            Text { text: root.t-in; color: Dy.text; font-size: root.f-hero; }
            Text { text: "Humidity " + root.t-hum; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; overflow: elide; }
            Text { text: "Outdoor " + root.t-out; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; overflow: elide; }
            if root.size != "1x1": Text { text: root.t-comfort; color: Dy.accent2; font-size: root.f-label; font-family: Dy.caps; overflow: elide; }
        }

        if !root.use-layout && root.kind == "calendar": HorizontalLayout {
            spacing: 8px * root.s;
            if root.size != "1x1": VerticalLayout {
                spacing: root.sp;
                alignment: start;
                horizontal-stretch: 1;
                Text { text: "Today"; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; }
                for ev in root.sample ? root.demo-events : root.events: VerticalLayout {
                    Text { text: ev.title; color: Dy.text; font-size: root.f-body; overflow: elide; }
                    Text { text: ev.time + (ev.detail == "" ? "" : " · " + ev.detail); color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; overflow: elide; }
                }
            }
            VerticalLayout {
                spacing: 2px * root.s;
                alignment: start;
                horizontal-stretch: 1;
                Text { text: root.t-month; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; }
                HorizontalLayout {
                    for d in ["S", "M", "T", "W", "T", "F", "S"]: Text {
                        text: d; color: Dy.line; font-size: root.f-label; font-family: Dy.caps; horizontal-alignment: center; horizontal-stretch: 1;
                    }
                }
                GridLayout {
                    spacing: 1px;
                    for cell[i] in root.sample ? root.demo-cal : root.cal-cells: Rectangle {
                        row: floor(i / 7); col: mod(i, 7);
                        height: 14px * root.s;
                        background: cell.today ? Dy.accent1 : transparent;
                        Text {
                            text: cell.label;
                            color: cell.today ? Dy.bg : Dy.text;
                            font-size: root.f-label;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        if !root.use-layout && root.kind == "purifier": VerticalLayout {
            spacing: root.sp;
            alignment: start;
            Text { text: root.t-aq; color: Dy.text; font-size: root.f-hero; }
            Text { text: "PM2.5 7 · Allergens 4/12"; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; overflow: elide; }
            Text { text: "Filter " + root.t-filter + "%"; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; }
            Bar { level: root.t-filter / 100; zoom: root.s; }
            if root.size == "2x2": Text { text: "Clean the filter soon for the best air."; color: Dy.dim; font-size: root.f-body; wrap: word-wrap; }
            if root.size != "1x1": HorizontalLayout {
                spacing: root.sp;
                Pill { label: "Auto"; zoom: root.s; horizontal-stretch: 1; on: root.t-pmode == "Auto"; clicked => { if !root.sample { root.set-purifier-mode("Auto"); } } }
                Pill { label: "Sleep"; zoom: root.s; horizontal-stretch: 1; on: root.t-pmode == "Sleep"; clicked => { if !root.sample { root.set-purifier-mode("Sleep"); } } }
                Pill { label: "Boost"; zoom: root.s; horizontal-stretch: 1; on: root.t-pmode == "Manual"; clicked => { if !root.sample { root.set-purifier-mode("Manual"); } } }
            }
        }

        if !root.use-layout && root.kind == "activity": VerticalLayout {
            spacing: root.sp;
            alignment: start;
            for a in root.sample ? root.demo-activity : root.activity: HorizontalLayout {
                spacing: 8px * root.s;
                if root.size == "2x2": Text { text: a.time; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; vertical-alignment: center; }
                Text { text: a.title; color: Dy.text; font-size: root.f-body; overflow: elide; horizontal-stretch: 1; }
                if root.size == "2x2": Text { text: a.source; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; vertical-alignment: center; }
            }
        }

        if !root.use-layout && root.kind == "server": VerticalLayout {
            spacing: root.sp;
            alignment: start;
            Text { text: root.sample ? "6 ms" : "122 ms"; color: Dy.text; font-size: root.f-hero; }
            Text { text: "4/5 up"; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; }
            if root.size != "1x1": VerticalLayout {
                spacing: root.sp;
                for svc in root.sample ? root.demo-services : root.services: HorizontalLayout {
                    spacing: 6px * root.s;
                    VerticalLayout { alignment: center; Rectangle { width: 6px * root.s; height: 6px * root.s; background: svc.online ? Dy.accent2 : Dy.accent3; } }
                    Text { text: svc.name; color: Dy.text; font-size: root.f-body; horizontal-stretch: 1; overflow: elide; }
                    Text { text: svc.status; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; vertical-alignment: center; }
                }
            }
        }

        if !root.use-layout && root.kind == "weather": VerticalLayout {
            spacing: root.sp;
            alignment: start;
            HorizontalLayout {
                spacing: 8px * root.s;
                alignment: start;
                VerticalLayout { alignment: center; PixIcon { name: "sun"; scale: root.icon-scale; fill: Dy.accent1; } }
                Text { text: root.t-temp; color: Dy.text; font-size: root.f-hero; vertical-alignment: center; }
            }
            Text { text: root.t-cond + " · " + root.t-range; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; overflow: elide; }
            if root.size != "1x1": Text { text: root.t-loc; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; overflow: elide; }
            if root.size == "2x2": Text { text: root.t-note; color: Dy.text; font-size: root.f-body; wrap: word-wrap; }
            if root.size != "1x1": HorizontalLayout {
                spacing: 8px * root.s;
                for h in root.sample ? root.demo-hours : root.hours: VerticalLayout {
                    Text { text: h.hour; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; horizontal-alignment: center; }
                    Text { text: h.temp; color: Dy.text; font-size: root.f-body; horizontal-alignment: center; }
                }
            }
        }

        if !root.use-layout && root.kind == "lights": VerticalLayout {
            spacing: root.sp;
            alignment: start;
            HorizontalLayout {
                spacing: 8px * root.s;
                VerticalLayout { alignment: center; PixIcon { name: "bulb"; scale: root.icon-scale; fill: root.t-master ? Dy.accent1 : Dy.dim; } }
                Text { text: root.t-scene; color: Dy.text; font-size: root.f-value; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                VerticalLayout { alignment: center; Toggle { on: root.t-master; zoom: root.s; toggled => { if !root.sample { root.toggle-master(); } } } }
            }
            Bar { level: root.t-master ? root.t-bright / 100 : 0; segments: root.size == "1x1" ? 5 : 10; interactive: true; zoom: root.s; changed(v) => { if !root.sample { root.brightness-changed(v); } } }
            if root.size != "1x1": Text { text: root.t-master ? root.t-bright + "%" : "Off"; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; }
            if root.size != "1x1": HorizontalLayout {
                spacing: 6px * root.s;
                alignment: start;
                Swatch { swatch: #ff5a5a; zoom: root.s; on: root.t-color == "#FF5A5A"; clicked => { if !root.sample { root.set-color("#FF5A5A"); } } }
                Swatch { swatch: #ff8c42; zoom: root.s; on: root.t-color == "#FF8C42"; clicked => { if !root.sample { root.set-color("#FF8C42"); } } }
                Swatch { swatch: #ffd166; zoom: root.s; on: root.t-color == "#FFD166"; clicked => { if !root.sample { root.set-color("#FFD166"); } } }
                Swatch { swatch: #7cf29c; zoom: root.s; on: root.t-color == "#7CF29C"; clicked => { if !root.sample { root.set-color("#7CF29C"); } } }
                Swatch { swatch: #5ce1ff; zoom: root.s; on: root.t-color == "#2D7BFF"; clicked => { if !root.sample { root.set-color("#2D7BFF"); } } }
                Swatch { swatch: #7b61ff; zoom: root.s; on: root.t-color == "#7B61FF"; clicked => { if !root.sample { root.set-color("#7B61FF"); } } }
                Swatch { swatch: #ff6bcb; zoom: root.s; on: root.t-color == "#FF6BCB"; clicked => { if !root.sample { root.set-color("#FF6BCB"); } } }
                Swatch { swatch: #ffffff; zoom: root.s; on: root.t-color == "#FFFFFF"; clicked => { if !root.sample { root.set-color("#FFFFFF"); } } }
            }
            if root.size == "2x2": GridLayout {
                spacing: root.sp;
                for light[i] in root.sample ? root.demo-lights : root.lights: TouchArea {
                    row: floor(i / 2); col: mod(i, 2);
                    height: 28px * root.s;
                    clicked => { if !root.sample { root.toggle-light(light.id); } }
                    Rectangle {
                        border-width: Dy.stroke;
                        border-color: light.on ? Dy.accent1 : Dy.line;
                        HorizontalLayout {
                            padding-left: 8px * root.s;
                            padding-right: 8px * root.s;
                            spacing: 6px * root.s;
                            Text { text: light.name; color: light.on ? Dy.accent1 : Dy.dim; font-size: root.f-label; font-family: Dy.caps; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            Text { text: light.brightness; color: light.on ? Dy.accent1 : Dy.dim; font-size: root.f-label; font-family: Dy.caps; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        if !root.use-layout && root.kind == "media": VerticalLayout {
            spacing: root.sp;
            alignment: start;
            Text { text: root.t-track; color: Dy.text; font-size: root.f-body; overflow: elide; }
            if root.size != "1x1": Text { text: root.t-artist; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; overflow: elide; }
            Bar { level: root.t-prog; segments: 6; zoom: root.s; }
            if root.size != "1x1": HorizontalLayout {
                spacing: root.sp;
                alignment: start;
                IconBtn { glyph: "<<"; zoom: root.s; clicked => { if !root.sample { root.prev-track(); } } }
                IconBtn { glyph: root.t-play ? "||" : ">"; primary: true; zoom: root.s; clicked => { if !root.sample { root.toggle-play(); } } }
                IconBtn { glyph: ">>"; zoom: root.s; clicked => { if !root.sample { root.next-track(); } } }
            }
            if root.size == "2x2": Text { text: "Volume " + root.t-vol + "%"; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; }
            if root.size == "2x2": Bar { level: root.t-vol / 100; interactive: true; zoom: root.s; changed(v) => { if !root.sample { root.volume-changed(v); } } }
        }

        if !root.use-layout && root.kind == "system": VerticalLayout {
            spacing: root.sp;
            alignment: start;
            Text { text: "CPU " + round(root.t-cpu) + "%"; color: Dy.text; font-size: root.f-body; }
            Bar { level: root.t-cpu / 100; zoom: root.s; }
            if root.size != "1x1": Text { text: "Memory " + round(root.t-mem) + "%"; color: Dy.text; font-size: root.f-body; }
            if root.size != "1x1": Bar { level: root.t-mem / 100; zoom: root.s; }
            if root.size == "2x2": Text { text: root.t-memd + " · " + root.t-temp-host; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; }
        }

        if !root.use-layout && root.kind == "terminal": VerticalLayout {
            spacing: root.sp;
            if root.size == "1x1": Text {
                text: root.t-term.length == 0 ? "Linux shell" : root.t-term[root.t-term.length - 1].text;
                color: Dy.text;
                font-size: 8px * root.s;
                font-family: Dy.code;
                overflow: elide;
                vertical-stretch: 1;
            }
            if root.size != "1x1": Rectangle {
                vertical-stretch: 1;
                clip: true;
                VerticalLayout {
                    spacing: 4px * root.s;
                    alignment: end;
                    for line in root.t-term: Text {
                        text: line.text;
                        color: line.prompt ? Dy.dim : Dy.text;
                        font-size: 8px * root.s;
                        font-family: Dy.code;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                }
            }
            FieldTap {
                label: "Command";
                value: root.t-term-in;
                active: !root.sample && root.terminal-kb-active;
                locked: root.sample;
                label-size: root.f-label;
                value-size: root.f-body;
                tap-height: 32px * root.s;
                tapped => { if !root.sample { root.open-terminal-input(); } }
            }
            if root.size == "2x2": Pill {
                label: "Run";
                zoom: root.s;
                on: true;
                clicked => { if !root.sample { root.submit-terminal(); } }
            }
        }

        if !root.use-layout && root.kind == "timers": VerticalLayout {
            spacing: root.sp;
            alignment: start;
            for t[i] in root.sample ? root.demo-timers : root.timers: HorizontalLayout {
                spacing: 6px * root.s;
                alignment: start;
                Text { text: t.label; color: Dy.text; font-size: root.f-body; overflow: elide; }
                Text { text: t.remain; color: i == 0 ? Dy.accent3 : Dy.dim; font-size: root.f-body; }
            }
            if (root.sample ? root.demo-timers : root.timers).length == 0: Text { text: "No timers"; color: Dy.dim; font-size: root.f-label; font-family: Dy.caps; }
        }

        if !root.use-layout && root.kind == "ask": VerticalLayout {
            spacing: root.sp;
            alignment: start;
            HorizontalLayout {
                spacing: 2px;
                alignment: start;
                Text {
                    text: "> " + (root.ask-text != "" ? root.ask-text : root.sample ? "what should i cook tonight" : "ask me anything");
                    color: root.ask-text != "" || root.sample ? Dy.text : Dy.dim;
                    font-size: root.f-body;
                    overflow: elide;
                }
                Rectangle {
                    width: 6px * root.s;
                    height: root.f-body;
                    background: Dy.accent2;
                    opacity: root.blink ? 1 : 0;
                }
            }
            Text { text: "Tap to type"; color: Dy.accent2; font-size: root.f-label; font-family: Dy.caps; overflow: elide; }
        }

        if !root.use-layout && root.kind == "clock": VerticalLayout {
            alignment: center;
            spacing: root.sp;
            Text {
                text: root.clock-hm;
                color: Dy.accent1;
                font-size: (root.size == "1x1" ? Dy.type-hero : Dy.type-clock) * root.s;
                font-family: Dy.caps;
            }
            Text {
                text: root.size != "1x1" && root.events.length > 0 ? "Next: " + root.events[0].title + " " + root.events[0].time : root.date-text;
                color: Dy.dim;
                font-size: root.f-label;
                font-family: Dy.caps;
                overflow: elide;
            }
        }

        if !root.use-layout && root.kind == "digitalClock": VerticalLayout {
            alignment: center;
            Text {
                text: root.clock-hm;
                color: Dy.text;
                font-size: (root.size == "1x1" ? Dy.type-hero : Dy.type-clock) * root.s;
                font-family: Dy.caps;
                horizontal-alignment: center;
            }
        }

        if !root.use-layout && root.kind == "pong": Rectangle {
            background: Dy.bg;
            Rectangle { x: parent.width / 2 - 1px; y: 4px; width: 2px; height: parent.height - 8px; background: Dy.line; }
            Rectangle {
                x: 4px;
                y: parent.height * root.pong-ly / 100.0 - 9px * root.s;
                width: 3px * root.s;
                height: 18px * root.s;
                background: Dy.text;
            }
            Rectangle {
                x: parent.width - 7px * root.s;
                y: parent.height * root.pong-ry / 100.0 - 9px * root.s;
                width: 3px * root.s;
                height: 18px * root.s;
                background: Dy.text;
            }
            Rectangle {
                x: parent.width * root.pong-bx / 100.0 - 2px * root.s;
                y: parent.height * root.pong-by / 100.0 - 2px * root.s;
                width: 4px * root.s;
                height: 4px * root.s;
                background: Dy.text;
            }
        }

        if root.kind == "custom" || root.use-layout: Rectangle {
            for n in root.slop-nodes: Rectangle {
                x: parent.width * n.x / 100;
                y: parent.height * n.y / 100;
                width: parent.width * n.w / 100;
                height: parent.height * n.h / 100;
                visible: root.widget-id == "" || n.widget-id == root.widget-id || n.widget-id == "";
                background: (n.kind == "button" || n.kind == "chip" || n.kind == "bar" || n.kind == "toggle") ? rgb(n.r, n.g, n.b) : transparent;
                Text {
                    text: n.text;
                    color: rgb(n.r, n.g, n.b);
                    font-size: n.kind == "metric" ? Dy.type-value : Dy.type-secondary;
                    font-family: n.kind == "metric" || n.kind == "text" ? Dy.mono : Dy.caps;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
        }
    }
}
