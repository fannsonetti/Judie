import { Dy, LightRow, HourRow, EventRow, ServiceRow, ActivityRow, TimerRow, CalCell, SlopNode, TerminalLine, Pill, Toggle, Swatch, IconBtn, Bar, QuickTask, FieldTap, PixIcon } from "cards.slint";

// Live widget face used on the home grid and in the add-widget carousel.
// `sample` swaps in default preview data so gallery never reads the live room.
// `source` is the preview renderer: "live" draws this component; "image" is reserved
// for a later static thumbnail without changing the carousel.

export component WidgetFace inherits Rectangle {
    in property <string> kind: "activity";
    in property <string> size: "1x1";
    in property <bool> sample: false;
    in property <string> source: "live";
    in property <float> face-scale: 1.0;
    in property <image> thumb;
    in property <string> widget-id: "";

    in property <string> weather-loc: "";
    in property <string> weather-temp: "";
    in property <string> weather-cond: "";
    in property <string> weather-range: "";
    in property <string> weather-feel: "";
    in property <string> weather-note: "";
    in property <[HourRow]> hours: [];

    in property <bool> master-on: true;
    in property <int> brightness: 70;
    in property <string> scene: "Cozy";
    in property <string> master-color: "#FFB366";
    in property <[LightRow]> lights: [];

    in property <bool> playing: false;
    in property <string> track-title: "";
    in property <string> track-artist: "";
    in property <int> volume: 62;
    in property <float> media-progress: 0.2;

    in property <string> indoor: "";
    in property <string> outdoor: "";
    in property <string> humidity: "";
    in property <string> comfort: "";
    in property <[EventRow]> events: [];
    in property <string> month-name: "";
    in property <[CalCell]> cal-cells: [];

    in property <bool> purifier-on: true;
    in property <string> purifier-mode: "Auto";
    in property <string> purifier-aq: "Good";
    in property <int> purifier-filter: 38;

    in property <float> cpu: 0;
    in property <float> memory: 0;
    in property <string> mem-detail: "";
    in property <string> temp-text: "";
    in property <[ServiceRow]> services: [];
    in property <[ActivityRow]> activity: [];
    in property <[TimerRow]> timers: [];
    in property <[SlopNode]> slop-nodes: [];
    in property <bool> dnd: false;
    in property <bool> use-layout: false;
    in property <string> terminal-input: "";
    in property <[TerminalLine]> terminal-lines: [];
    in property <bool> terminal-kb-active: false;
    in property <string> clock-hm: "12:00";
    in property <string> clock-hms: "12:00:00";
    in property <string> date-text: "";
    in property <float> hour-deg: 0;
    in property <float> minute-deg: 0;
    in property <float> second-deg: 0;
    in property <int> pong-ly: 42;
    in property <int> pong-ry: 42;
    in property <int> pong-bx: 50;
    in property <int> pong-by: 50;

    callback toggle-master();
    callback brightness-changed(int);
    callback set-color(string);
    callback toggle-light(string);
    callback toggle-play();
    callback next-track();
    callback prev-track();
    callback volume-changed(int);
    callback quick(string);
    callback set-purifier-mode(string);
    callback open-terminal-input();
    callback submit-terminal();

    background: transparent;
    clip: true;

    property <[HourRow]> demo-hours: [
        { hour: "12", temp: "18°", precip: "10%" },
        { hour: "13", temp: "17°", precip: "20%" },
        { hour: "14", temp: "16°", precip: "15%" },
        { hour: "15", temp: "16°", precip: "5%" },
    ];
    property <[EventRow]> demo-events: [
        { time: "09:00", title: "Stand-up", detail: "Kitchen" },
        { time: "14:30", title: "Delivery", detail: "" },
        { time: "19:00", title: "Dinner", detail: "Home" },
    ];
    property <[CalCell]> demo-cal: [
        { label: "1", today: false }, { label: "2", today: false }, { label: "3", today: false }, { label: "4", today: false }, { label: "5", today: false }, { label: "6", today: false }, { label: "7", today: false },
        { label: "8", today: false }, { label: "9", today: false }, { label: "10", today: true }, { label: "11", today: false }, { label: "12", today: false }, { label: "13", today: false }, { label: "14", today: false },
        { label: "15", today: false }, { label: "16", today: false }, { label: "17", today: false }, { label: "18", today: false }, { label: "19", today: false }, { label: "20", today: false }, { label: "21", today: false },
        { label: "22", today: false }, { label: "23", today: false }, { label: "24", today: false }, { label: "25", today: false }, { label: "26", today: false }, { label: "27", today: false }, { label: "28", today: false },
        { label: "29", today: false }, { label: "30", today: false }, { label: "", today: false }, { label: "", today: false }, { label: "", today: false }, { label: "", today: false }, { label: "", today: false },
    ];
    property <[LightRow]> demo-lights: [
        { id: "a", name: "Ceiling", on: true, brightness: "40%" },
        { id: "b", name: "Desk", on: true, brightness: "70%" },
        { id: "c", name: "Lamp", on: false, brightness: "Off" },
        { id: "d", name: "Strip", on: true, brightness: "25%" },
    ];
    property <[ServiceRow]> demo-services: [
        { name: "Core", status: "4 ms", online: true },
        { name: "Lights", status: "6 ms", online: true },
        { name: "Media", status: "9 ms", online: true },
        { name: "Weather", status: "12 ms", online: true },
        { name: "Voice", status: "Down", online: false },
    ];
    property <[ActivityRow]> demo-activity: [
        { title: "Good Night", source: "Routine", time: "22:14" },
        { title: "Lights Off", source: "You", time: "22:15" },
        { title: "Do Not Disturb", source: "Routine", time: "22:15" },
    ];
    property <[TimerRow]> demo-timers: [
        { label: "Pasta", remain: "4:20" },
        { label: "Laundry", remain: "32:00" },
    ];
    property <[TerminalLine]> demo-terminal: [
        { text: "~$ uname -s", prompt: true },
        { text: "Linux", prompt: false },
        { text: "~$ ls", prompt: true },
        { text: "Desktop  Documents  Downloads", prompt: false },
    ];
    property <[TerminalLine]> t-term: root.sample ? root.demo-terminal : root.terminal-lines;
    property <string> t-term-in: root.sample ? "lights off" : root.terminal-input;

    property <string> t-loc: root.sample ? "Hafnarfjörður" : root.weather-loc;
    property <string> t-temp: root.sample ? "18°" : root.weather-temp;
    property <string> t-cond: root.sample ? "Cloudy" : root.weather-cond;
    property <string> t-range: root.sample ? "H 20°  L 12°" : root.weather-range;
    property <string> t-feel: root.sample ? "Feels 16°" : root.weather-feel;
    property <string> t-note: root.sample ? "Light rain later this evening." : root.weather-note;
    property <bool> t-master: root.sample ? true : root.master-on;
    property <int> t-bright: root.sample ? 40 : root.brightness;
    property <string> t-scene: root.sample ? "Focus" : root.scene;
    property <string> t-color: root.sample ? "#2D7BFF" : root.master-color;
    property <bool> t-play: root.sample ? false : root.playing;
    property <string> t-track: root.sample ? "Night Drive" : root.track-title;
    property <string> t-artist: root.sample ? "Analog Heart" : root.track-artist;
    property <int> t-vol: root.sample ? 62 : root.volume;
    property <float> t-prog: root.sample ? 0.42 : root.media-progress;
    property <string> t-in: root.sample ? "21°" : root.indoor;
    property <string> t-out: root.sample ? "7°" : root.outdoor;
    property <string> t-hum: root.sample ? "44%" : root.humidity;
    property <string> t-comfort: root.sample ? "Comfortable" : root.comfort;
    property <string> t-month: root.sample ? "March" : root.month-name;
    property <string> t-aq: root.sample ? "Good" : root.purifier-aq;
    property <string> t-pmode: root.sample ? "Auto" : root.purifier-mode;
    property <int> t-filter: root.sample ? 38 : root.purifier-filter;
    property <float> t-cpu: root.sample ? 24 : root.cpu;
    property <float> t-mem: root.sample ? 51 : root.memory;
    property <string> t-memd: root.sample ? "4.1 / 8.0 GB" : root.mem-detail;
    property <string> t-temp-host: root.sample ? "52°" : root.temp-text;
    property <bool> t-dnd: root.sample ? false : root.dnd;

    if root.source == "image": Image {
        source: root.thumb;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }

    if root.source != "image": Rectangle {
        background: transparent;

        if !root.use-layout && root.kind == "quickControls": GridLayout {
            spacing: 8px * root.face-scale;
            padding: 0px;
            QuickTask { row: 0; col: 0; zoom: root.face-scale; glyph: "☾"; label: "Good Night"; clicked => { if !root.sample { root.quick("goodNight"); } } }
            QuickTask { row: 0; col: 1; zoom: root.face-scale; glyph: "○"; label: "Lights Off"; clicked => { if !root.sample { root.quick("lightsOff"); } } }
            QuickTask { row: 1; col: 0; zoom: root.face-scale; glyph: "⊘"; label: "Do Not Disturb"; on: root.t-dnd; clicked => { if !root.sample { root.quick("dnd"); } } }
            QuickTask { row: 1; col: 1; zoom: root.face-scale; glyph: "▶"; label: "Movie Mode"; clicked => { if !root.sample { root.quick("movie"); } } }
        }

        if !root.use-layout && root.kind == "climate": HorizontalLayout {
            spacing: 10px * root.face-scale;
            Rectangle {
                width: 72px * root.face-scale; height: 72px * root.face-scale;
                border-width: Dy.stroke; border-color: Dy.text; background: Dy.bg;
                VerticalLayout {
                    alignment: center;
                    Text { text: root.t-in; color: Dy.text; font-size: Dy.type-value * root.face-scale; font-weight: 700; font-family: Dy.mono; horizontal-alignment: center; }
                    Text { text: "NOW"; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; font-family: Dy.mono; horizontal-alignment: center; }
                }
            }
            VerticalLayout {
                alignment: center; spacing: 6px * root.face-scale;
                Text { text: "HUMIDITY"; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; font-family: Dy.mono; }
                Text { text: root.t-hum; color: Dy.text; font-size: Dy.type-title * root.face-scale; font-weight: 700; font-family: Dy.mono; }
                Text { text: "OUTDOOR"; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; font-family: Dy.mono; }
                Text { text: root.t-out; color: Dy.text; font-size: Dy.type-title * root.face-scale; font-weight: 700; font-family: Dy.mono; }
                if root.size == "1x2": Text { text: root.t-comfort; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; font-family: Dy.mono; }
            }
        }

        if !root.use-layout && root.kind == "calendar": HorizontalLayout {
            spacing: 10px * root.face-scale;
            if root.size != "1x1": VerticalLayout {
                spacing: 4px * root.face-scale; horizontal-stretch: 1;
                Text { text: "Today"; color: Dy.dim; font-size: Dy.type-title * root.face-scale; }
                for ev in root.sample ? root.demo-events : root.events: HorizontalLayout {
                    spacing: 6px * root.face-scale;
                    Rectangle { width: 4px * root.face-scale; height: 18px * root.face-scale; background: Dy.text; }
                    VerticalLayout {
                        Text { text: ev.title; color: Dy.text; font-size: Dy.type-title * root.face-scale; font-weight: 600; overflow: elide; }
                        Text { text: ev.time + (ev.detail == "" ? "" : " · " + ev.detail); color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; overflow: elide; }
                    }
                }
            }
            VerticalLayout {
                spacing: 4px * root.face-scale; horizontal-stretch: 1;
                Text { text: root.t-month; color: Dy.dim; font-size: Dy.type-title * root.face-scale; }
                HorizontalLayout {
                    spacing: 0;
                    for d in ["S", "M", "T", "W", "T", "F", "S"]: Text {
                        text: d; color: Dy.line; font-size: Dy.type-dense * root.face-scale; horizontal-alignment: center; horizontal-stretch: 1;
                    }
                }
                GridLayout {
                    spacing: 2px * root.face-scale;
                    for cell[i] in root.sample ? root.demo-cal : root.cal-cells: Rectangle {
                        row: floor(i / 7); col: mod(i, 7);
                        height: 18px * root.face-scale;
                        border-width: cell.today ? Dy.stroke : 0px;
                        border-color: Dy.text;
                        background: transparent;
                        Text {
                            text: cell.label;
                            color: cell.today ? Dy.text : Dy.text;
                            font-size: Dy.type-dense * root.face-scale;
                            font-weight: cell.today ? 700 : 400;
                            font-family: Dy.mono;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        if !root.use-layout && root.kind == "purifier": VerticalLayout {
            spacing: 8px * root.face-scale;
            if root.size != "1x1": HorizontalLayout {
                spacing: 10px * root.face-scale;
                Rectangle {
                    width: 88px * root.face-scale; height: 88px * root.face-scale;
                    border-width: Dy.stroke; border-color: Dy.text; background: Dy.bg;
                    VerticalLayout {
                        alignment: center;
                        Text { text: root.t-aq; color: Dy.text; font-size: Dy.type-value * root.face-scale; font-weight: 700; font-family: Dy.mono; horizontal-alignment: center; }
                        Text { text: "AIR QUALITY"; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; font-family: Dy.mono; horizontal-alignment: center; }
                    }
                }
                VerticalLayout {
                    spacing: 6px * root.face-scale;
                    Rectangle {
                        background: Dy.bg;
                        border-width: Dy.stroke; border-color: Dy.line;
                        VerticalLayout {
                            padding: 8px * root.face-scale;
                            Text { text: "PM2.5"; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; font-family: Dy.mono; }
                            Text { text: "7 µg/m³"; color: Dy.text; font-size: Dy.type-title * root.face-scale; font-weight: 700; font-family: Dy.mono; }
                            Text { text: "Fine particles"; color: Dy.line; font-size: Dy.type-secondary * root.face-scale; font-family: Dy.mono; }
                        }
                    }
                    Rectangle {
                        background: Dy.bg;
                        border-width: Dy.stroke; border-color: Dy.line;
                        VerticalLayout {
                            padding: 8px;
                            Text { text: "ALLERGENS"; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; font-family: Dy.mono; }
                            Text { text: "4/12"; color: Dy.text; font-size: Dy.type-title * root.face-scale; font-weight: 700; font-family: Dy.mono; }
                            Text { text: "Allergen level"; color: Dy.line; font-size: Dy.type-secondary * root.face-scale; font-family: Dy.mono; }
                        }
                    }
                }
            }
            if root.size == "1x1": VerticalLayout {
                Text { text: "7"; color: Dy.text; font-size: Dy.type-value * root.face-scale; font-weight: 700; }
                Text { text: "PM2.5 · " + root.t-aq; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; }
            }
            if root.size == "2x2": Text { text: "Filter: Clean soon. Dust can cut performance. Clean the filter for the best air."; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; wrap: word-wrap; }
            Text { text: "Filter"; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; }
            Bar { level: root.t-filter / 100; zoom: root.face-scale; }
            Text { text: root.t-filter + "%"; color: Dy.text; font-size: Dy.type-secondary * root.face-scale; }
            if root.size == "2x2": HorizontalLayout {
                spacing: 8px * root.face-scale;
                Pill { label: "Auto"; zoom: root.face-scale; on: root.t-pmode == "Auto"; clicked => { if !root.sample { root.set-purifier-mode("Auto"); } } }
                Pill { label: "Sleep"; zoom: root.face-scale; on: root.t-pmode == "Sleep"; clicked => { if !root.sample { root.set-purifier-mode("Sleep"); } } }
                Pill { label: "Boost"; zoom: root.face-scale; on: root.t-pmode == "Manual"; clicked => { if !root.sample { root.set-purifier-mode("Manual"); } } }
            }
        }

        if !root.use-layout && root.kind == "activity": VerticalLayout {
            for a in root.sample ? root.demo-activity : root.activity: HorizontalLayout {
                spacing: 8px;
                if root.size == "2x2": Text { text: a.time; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; min-width: 52px; }
                Text { text: a.title; color: Dy.text; font-size: Dy.type-title * root.face-scale; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                if root.size == "2x2": Text { text: a.source; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; }
            }
        }

        if !root.use-layout && root.kind == "server": VerticalLayout {
            spacing: 4px;
            Text { text: root.sample ? "6 ms" : "122 ms"; color: Dy.text; font-size: Dy.type-value * root.face-scale; font-weight: 700; }
            Text { text: root.sample ? "4/5 up" : "4/5 up"; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; }
            if root.size != "1x1": VerticalLayout {
                spacing: 4px;
                for s in root.sample ? root.demo-services : root.services: HorizontalLayout {
                    spacing: 8px;
                    Rectangle { width: 8px; height: 8px; background: s.online ? Dy.text : Dy.line; y: 4px; }
                    Text { text: s.name; color: Dy.text; font-size: Dy.type-title * root.face-scale; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: s.status; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; }
                }
            }
        }

        if !root.use-layout && root.kind == "weather": VerticalLayout {
            HorizontalLayout {
                Text { text: root.t-loc; color: Dy.dim; font-size: Dy.type-title * root.face-scale; overflow: elide; horizontal-stretch: 1; }
                if root.size != "1x1": Text { text: root.t-feel; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; }
            }
            HorizontalLayout {
                VerticalLayout {
                    Text { text: root.t-temp; color: Dy.text; font-size: Dy.type-hero * root.face-scale; font-weight: 700; }
                    Text { text: root.t-cond; color: Dy.text; font-size: Dy.type-title * root.face-scale; }
                    Text { text: root.t-range; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; }
                }
                Rectangle { horizontal-stretch: 1; }
                PixIcon { name: "sun"; scale: 4; fill: Dy.accent1; }
            }
            if root.size == "2x2": Text { text: root.t-note; color: Dy.text; font-size: Dy.type-secondary * root.face-scale; wrap: word-wrap; }
            if root.size != "1x1": HorizontalLayout {
                spacing: 8px;
                for h in root.sample ? root.demo-hours : root.hours: VerticalLayout {
                    Text { text: h.hour; color: Dy.line; font-size: Dy.type-dense * root.face-scale; horizontal-alignment: center; }
                    Text { text: h.temp; color: Dy.text; font-size: Dy.type-title * root.face-scale; font-weight: 700; horizontal-alignment: center; }
                    Text { text: h.precip; color: Dy.dim; font-size: Dy.type-dense * root.face-scale; horizontal-alignment: center; }
                }
            }
        }

        if !root.use-layout && root.kind == "lights": VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                PixIcon { name: "bulb"; scale: 4; fill: root.t-master ? Dy.accent1 : Dy.dim; }
                Text { text: root.t-scene; color: Dy.dim; font-size: Dy.type-title * root.face-scale; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Toggle { on: root.t-master; zoom: root.face-scale; toggled => { if !root.sample { root.toggle-master(); } } }
            }
            Text { text: root.t-master ? root.t-bright + "%" : "Off"; color: Dy.text; font-size: Dy.type-value * root.face-scale; font-weight: 700; }
            Bar { level: root.t-bright / 100; interactive: true; zoom: root.face-scale; changed(v) => { if !root.sample { root.brightness-changed(v); } } }
            HorizontalLayout {
                spacing: 8px;
                Swatch { swatch: #ff5a5a; zoom: root.face-scale; on: root.t-color == "#FF5A5A"; clicked => { if !root.sample { root.set-color("#FF5A5A"); } } }
                Swatch { swatch: #ff8c42; zoom: root.face-scale; on: root.t-color == "#FF8C42"; clicked => { if !root.sample { root.set-color("#FF8C42"); } } }
                Swatch { swatch: #ffd166; zoom: root.face-scale; on: root.t-color == "#FFD166"; clicked => { if !root.sample { root.set-color("#FFD166"); } } }
                Swatch { swatch: #7cf29c; zoom: root.face-scale; on: root.t-color == "#7CF29C"; clicked => { if !root.sample { root.set-color("#7CF29C"); } } }
                Swatch { swatch: #5ce1ff; zoom: root.face-scale; on: root.t-color == "#2D7BFF"; clicked => { if !root.sample { root.set-color("#2D7BFF"); } } }
                if root.size != "1x1": Swatch { swatch: #7b61ff; zoom: root.face-scale; on: root.t-color == "#7B61FF"; clicked => { if !root.sample { root.set-color("#7B61FF"); } } }
                if root.size != "1x1": Swatch { swatch: #ff6bcb; zoom: root.face-scale; on: root.t-color == "#FF6BCB"; clicked => { if !root.sample { root.set-color("#FF6BCB"); } } }
                if root.size != "1x1": Swatch { swatch: #ffffff; zoom: root.face-scale; on: root.t-color == "#FFFFFF"; clicked => { if !root.sample { root.set-color("#FFFFFF"); } } }
            }
            if root.size == "2x2": GridLayout {
                spacing: 8px;
                for light[i] in root.sample ? root.demo-lights : root.lights: Rectangle {
                    row: floor(i / 2); col: mod(i, 2);
                    background: Dy.bg; height: 48px;
                    border-width: Dy.stroke; border-color: Dy.line;
                    HorizontalLayout {
                        spacing: 0px;
                        Rectangle { width: 3px; background: light.on ? Dy.accent1 : Dy.line; }
                        TouchArea {
                            clicked => { if !root.sample { root.toggle-light(light.id); } }
                            VerticalLayout {
                                padding: 6px;
                                Text { text: light.name; color: Dy.text; font-size: Dy.type-secondary * root.face-scale; font-family: Dy.mono; overflow: elide; }
                                Text { text: light.brightness; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; font-family: Dy.mono; }
                            }
                        }
                    }
                }
            }
        }

        if !root.use-layout && root.kind == "media": VerticalLayout {
            Text { text: root.t-play ? "Playing" : "Paused"; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; }
            Text { text: root.t-track; color: Dy.text; font-size: Dy.type-title * root.face-scale; font-weight: 600; overflow: elide; }
            if root.size != "1x1": Text { text: root.t-artist; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; overflow: elide; }
            if root.size != "1x1": Bar { level: root.t-prog; zoom: root.face-scale; }
            HorizontalLayout {
                spacing: 8px;
                if root.size != "1x1": IconBtn { glyph: "⟨"; zoom: root.face-scale; clicked => { if !root.sample { root.prev-track(); } } }
                IconBtn { glyph: root.t-play ? "❚❚" : "▶"; primary: true; zoom: root.face-scale; clicked => { if !root.sample { root.toggle-play(); } } }
                if root.size != "1x1": IconBtn { glyph: "⟩"; zoom: root.face-scale; clicked => { if !root.sample { root.next-track(); } } }
                if root.size == "2x2": Rectangle { horizontal-stretch: 1; }
                if root.size == "2x2": Text { text: root.t-vol + "%"; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; vertical-alignment: center; }
            }
            if root.size == "2x2": Bar { level: root.t-vol / 100; interactive: true; zoom: root.face-scale; changed(v) => { if !root.sample { root.volume-changed(v); } } }
        }

        if !root.use-layout && root.kind == "system": VerticalLayout {
            Text { text: "CPU"; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; }
            Text { text: round(root.t-cpu) + "%"; color: Dy.text; font-size: Dy.type-value * root.face-scale; font-weight: 700; }
            Bar { level: root.t-cpu / 100; zoom: root.face-scale; }
            if root.size != "1x1": Text { text: "Memory"; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; }
            if root.size != "1x1": Text { text: round(root.t-mem) + "%"; color: Dy.text; font-size: Dy.type-value * root.face-scale; font-weight: 700; }
            if root.size != "1x1": Bar { level: root.t-mem / 100; zoom: root.face-scale; }
            if root.size == "2x2": Text { text: root.t-memd; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; }
            if root.size == "2x2": Text { text: root.t-temp-host; color: Dy.dim; font-size: Dy.type-secondary * root.face-scale; }
        }

        if !root.use-layout && root.kind == "terminal": VerticalLayout {
            spacing: 4px * root.face-scale;
            Text {
                text: "TERMINAL";
                color: Dy.dim;
                font-size: Dy.type-secondary * root.face-scale;
                font-family: Dy.code;
            }
            if root.size == "1x1": Text {
                text: root.t-term.length == 0 ? "Linux shell" : root.t-term[root.t-term.length - 1].text;
                color: Dy.text;
                font-size: Dy.type-title * root.face-scale;
                font-family: Dy.code;
                overflow: elide;
                vertical-stretch: 1;
            }
            if root.size != "1x1": Rectangle {
                vertical-stretch: 1;
                clip: true;
                VerticalLayout {
                    spacing: 2px * root.face-scale;
                    alignment: end;
                    for line in root.t-term: Text {
                        text: line.text;
                        color: line.prompt ? Dy.dim : Dy.text;
                        font-size: Dy.type-secondary * root.face-scale;
                        font-family: Dy.code;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                }
            }
            FieldTap {
                label: "COMMAND";
                value: root.t-term-in;
                active: !root.sample && root.terminal-kb-active;
                locked: root.sample;
                label-size: Dy.type-dense * root.face-scale;
                value-size: Dy.type-title * root.face-scale;
                tap-height: root.size == "1x1" ? 48px * root.face-scale : 56px * root.face-scale;
                tapped => { if !root.sample { root.open-terminal-input(); } }
            }
            if root.size == "2x2": HorizontalLayout {
                spacing: 8px * root.face-scale;
                Pill {
                    label: "RUN";
                    zoom: root.face-scale;
                    on: true;
                    clicked => { if !root.sample { root.submit-terminal(); } }
                }
                Text {
                    text: "Tap empty area to expand";
                    color: Dy.line;
                    font-size: Dy.type-dense * root.face-scale;
                    font-family: Dy.mono;
                    vertical-alignment: center;
                }
            }
        }

        if !root.use-layout && root.kind == "timers": VerticalLayout {
            for t in root.sample ? root.demo-timers : root.timers: HorizontalLayout {
                Text { text: t.label; color: Dy.text; font-size: Dy.type-title * root.face-scale; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: t.remain; color: Dy.dim; font-size: Dy.type-title * root.face-scale; }
            }
        }

        if !root.use-layout && root.kind == "clock": VerticalLayout {
            alignment: center;
            spacing: 8px * root.face-scale;
            Text {
                text: root.clock-hm;
                color: Dy.accent1;
                font-size: (root.size == "2x2" ? Dy.type-clock : Dy.type-hero) * root.face-scale;
                font-weight: 700;
                font-family: Dy.mono;
                horizontal-alignment: center;
            }
            if root.size == "2x2" && root.date-text != "": Text {
                text: root.date-text;
                color: Dy.dim;
                font-size: Dy.type-status * root.face-scale;
                font-family: Dy.mono;
                horizontal-alignment: center;
            }
        }

        if !root.use-layout && root.kind == "digitalClock": VerticalLayout {
            alignment: center;
            Text {
                text: root.size == "1x2" ? root.clock-hms : root.clock-hm;
                color: Dy.text;
                font-size: (root.size == "2x2" ? Dy.type-clock : Dy.type-hero) * root.face-scale;
                font-weight: 700;
                font-family: Dy.mono;
                horizontal-alignment: center;
            }
        }

        if !root.use-layout && root.kind == "pong": Rectangle {
            background: Dy.bg;
            Rectangle { x: parent.width / 2 - 1px; y: 8px; width: 2px; height: parent.height - 16px; background: Dy.line; }
            Rectangle {
                x: 8px;
                y: parent.height * root.pong-ly / 100.0 - 18px * root.face-scale;
                width: 6px * root.face-scale;
                height: 36px * root.face-scale;
                background: Dy.text;
            }
            Rectangle {
                x: parent.width - 14px * root.face-scale;
                y: parent.height * root.pong-ry / 100.0 - 18px * root.face-scale;
                width: 6px * root.face-scale;
                height: 36px * root.face-scale;
                background: Dy.text;
            }
            Rectangle {
                x: parent.width * root.pong-bx / 100.0 - 4px * root.face-scale;
                y: parent.height * root.pong-by / 100.0 - 4px * root.face-scale;
                width: 8px * root.face-scale;
                height: 8px * root.face-scale;
                background: Dy.text;
            }
        }

        if root.kind == "custom" || root.use-layout: Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            for n in root.slop-nodes: Rectangle {
                x: parent.width * n.x / 100;
                y: parent.height * n.y / 100;
                width: parent.width * n.w / 100;
                height: parent.height * n.h / 100;
                visible: root.widget-id == "" || n.widget-id == root.widget-id || n.widget-id == "";
                background: (n.kind == "button" || n.kind == "chip" || n.kind == "bar" || n.kind == "toggle") ? rgb(n.r, n.g, n.b) : transparent;
                border-radius: 0px;
                opacity: (n.kind == "bar" || n.kind == "gauge") ? 0.85 : 1;
                Text {
                    text: n.text;
                    color: rgb(n.r, n.g, n.b);
                    font-size: n.kind == "metric" ? Dy.type-value : Dy.type-secondary;
                    font-weight: n.kind == "metric" ? 700 : 500;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
    }
}
