# Leftover PIXEL/LXDE autostart snippet. Raspberry Pi OS Lite kiosks use
# systemd `judie.service` (see src-tauri/linux/judie.service). Do not install
# this file; the armhf package no longer ships /etc/xdg/autostart.
[Desktop Entry]
Type=Application
Name=Judie
Comment=Judie room control
Exec=env WEBKIT_DISABLE_DMABUF_RENDERER=1 judie
Icon=judie
Terminal=false
Categories=Utility;
StartupNotify=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=1
